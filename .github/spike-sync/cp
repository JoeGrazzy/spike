#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail
REPO="JoeGrazzy/spike"
BRANCH="main"
LOCAL="/storage/emulated/0/Download/Spike"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

echo "Copying current GitHub files to Spike..."
if ! git clone --depth 1 --branch "$BRANCH" "https://github.com/$REPO.git" "$TMP/repo" >/dev/null 2>&1; then
  echo "GitHub repository is empty or cannot be cloned."
  echo "Nothing was changed in Spike."
  exit 1
fi

# Do not use the custom 'cp' command. tar copies the repository contents safely.
rm -rf "$LOCAL"
mkdir -p "$LOCAL"
( cd "$TMP/repo" && tar --exclude='./.git' -cf - . ) | ( cd "$LOCAL" && tar -xf - )
echo "SPIKE copied from GitHub."
