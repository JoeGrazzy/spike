{
  "name": "spike-static-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "node js/audit/build.mjs",
    "cloudflare:verify": "node js/audit/cloudflare-verify.mjs",
    "audit:static": "node js/audit/static-audit.mjs",
    "typecheck": "node js/audit/typecheck.mjs",
    "lint": "eslint js --max-warnings=0",
    "format:check": "prettier --check \"**/*.{html,css,js,mjs,json,yml,yaml}\"",
    "format": "prettier --write \"**/*.{html,css,js,mjs,json,yml,yaml}\"",
    "test:back": "node --test js/audit/tests/back-button.test.mjs",
    "test:back-layout": "node --test js/audit/tests/back-button.test.mjs",
    "test:performance": "node --test js/audit/tests/performance.test.mjs",
    "test:security": "node --test js/audit/tests/security.test.mjs",
    "test:telemetry": "node --test js/audit/tests/telemetry.test.mjs",
    "test:ui": "node --test js/audit/tests/ui-contract.test.mjs",
    "test:a11y": "playwright test js/audit/tests/a11y.spec.mjs",
    "test:rpc": "node js/audit/rpc-gate.mjs",
    "test:integrity": "node --test js/audit/tests/project-integrity.test.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.55.0",
    "eslint": "9.0.0",
    "prettier": "3.0.0",
    "wrangler": "4.128.0",
    "globals": "15.0.0"
  }
}
