{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "spike",
  "compatibility_date": "2025-09-04",
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page",
    "exclude": [".git/**", ".github/**", "docs/**", "supabase/**", "tests/**", "node_modules/**", "build.js", "package.json", "*.md", "wrangler.jsonc"]
  }
}
