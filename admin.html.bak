<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<title>SPIKE — Admin Console</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
:root{--bg:#07090d;--panel:#0d1118;--panel2:#111722;--line:#202938;--text:#f7f8fb;--muted:#8d99aa;--pink:#ff4fa3;--orange:#ff8a3d;--green:#40e58a;--red:#ff4666;--blue:#4aa8ff}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 20% 0,#17101d 0,#07090d 38%);color:var(--text);font:14px system-ui,-apple-system,Segoe UI,sans-serif}button,input,textarea,select{font:inherit}button{cursor:pointer}
#login{min-height:100vh;display:grid;place-items:center;padding:20px}.login-card{width:min(430px,100%);background:#0d1118eF;border:1px solid var(--line);border-radius:22px;padding:30px;box-shadow:0 30px 100px #0008}.logo{font-size:28px;font-weight:900;letter-spacing:.08em;background:linear-gradient(90deg,#7aff4f,#3fffd8,#7aa7ff,#d86cff,#ff5fb7);-webkit-background-clip:text;color:transparent}.eyebrow{color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.16em;margin:7px 0 25px}.field{margin:12px 0}.field label{display:block;color:var(--muted);font-size:12px;margin-bottom:6px}.field input,.field textarea,.field select{width:100%;background:#090d13;color:var(--text);border:1px solid var(--line);border-radius:11px;padding:11px;outline:0}.field input:focus,.field textarea:focus{border-color:var(--pink)}.btn{border:1px solid var(--line);background:#141a24;color:var(--text);border-radius:10px;padding:10px 14px;font-weight:700}.primary{border:0;background:linear-gradient(135deg,var(--pink),var(--orange))}.danger{background:#3a101a;border-color:#652033;color:#ff8ba0}.wide{width:100%;margin-top:8px}.msg{min-height:18px;color:#ff8ba0;font-size:12px;margin-top:10px}
#app{display:none;min-height:100vh}.layout{display:grid;grid-template-columns:245px 1fr;min-height:100vh}.side{border-right:1px solid var(--line);background:#0b0f15;position:sticky;top:0;height:100vh;padding:18px 12px;display:flex;flex-direction:column}.brand{padding:6px 10px 22px}.nav{display:grid;gap:4px}.nav button{border:0;background:transparent;color:var(--muted);text-align:left;padding:11px 12px;border-radius:10px;font-weight:700}.nav button:hover,.nav button.active{background:#171d28;color:#fff}.nav button.active{box-shadow:inset 3px 0 var(--pink)}.signout{margin-top:auto}.main{padding:25px;max-width:1450px;width:100%;margin:auto}.top{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:22px}.title{font-size:24px;font-weight:850}.identity{color:var(--muted);font-size:12px}.view{display:none}.view.active{display:block}.grid{display:grid;gap:14px}.g4{grid-template-columns:repeat(4,1fr)}.g2{grid-template-columns:repeat(2,1fr)}.card{background:#0d121ae8;border:1px solid var(--line);border-radius:16px;padding:18px}.stat b{font-size:28px}.stat span{display:block;color:var(--muted);font-size:11px;text-transform:uppercase;margin-top:5px}.muted{color:var(--muted)}table{width:100%;border-collapse:collapse;font-size:12px}th,td{text-align:left;padding:10px 8px;border-bottom:1px solid var(--line);vertical-align:top}th{color:var(--muted);font-weight:700}.scroll{overflow:auto}.toolbar{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px}.toolbar input{flex:1;min-width:180px;background:#090d13;border:1px solid var(--line);border-radius:10px;padding:10px;color:#fff}.tag{display:inline-block;padding:3px 8px;border-radius:999px;background:#19212d;color:#b9c6d8;font-size:10px;font-weight:800}.tag.dev{background:#32152a;color:#ff7fbd}.danger-text{color:#ff708a}.success{color:var(--green)}pre{background:#080c12;border:1px solid var(--line);padding:14px;border-radius:12px;overflow:auto;max-height:480px;color:#cbd5e1;font-size:11px}.empty{padding:28px;text-align:center;color:var(--muted)}

/* Premium notification / toast system */
#toastStack{
  position:fixed;right:22px;top:22px;z-index:99999;width:min(390px,calc(100vw - 32px));
  display:grid;gap:10px;pointer-events:none;
}
.toast{
  position:relative;overflow:hidden;display:grid;grid-template-columns:38px 1fr 28px;gap:11px;
  align-items:start;padding:14px 13px 14px 14px;border:1px solid rgba(255,255,255,.10);
  border-radius:16px;background:linear-gradient(145deg,rgba(24,29,40,.97),rgba(10,14,21,.97));
  box-shadow:0 20px 55px rgba(0,0,0,.42),0 0 0 1px rgba(255,255,255,.025) inset;
  backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);
  transform:translateX(35px) scale(.97);opacity:0;animation:toastIn .28s cubic-bezier(.2,.8,.2,1) forwards;
  pointer-events:auto;
}
.toast.leaving{animation:toastOut .22s ease forwards}
.toast::after{content:"";position:absolute;left:0;right:0;bottom:0;height:2px;background:var(--toast-accent,#8aa0b8);opacity:.8}
.toast.success{--toast-accent:#40e58a}.toast.error{--toast-accent:#ff4666}.toast.warning{--toast-accent:#ffb84d}.toast.info{--toast-accent:#4aa8ff}
.toast-icon{width:34px;height:34px;border-radius:11px;display:grid;place-items:center;font-size:16px;font-weight:900;background:color-mix(in srgb,var(--toast-accent) 14%,transparent);color:var(--toast-accent);border:1px solid color-mix(in srgb,var(--toast-accent) 24%,transparent)}
.toast-copy{min-width:0}.toast-title{font-weight:850;font-size:13px;line-height:1.2;margin:1px 0 4px}.toast-message{font-size:12px;line-height:1.45;color:#9da9b9;word-break:break-word}
.toast-close{border:0;background:transparent;color:#667386;font-size:18px;line-height:1;padding:2px;cursor:pointer}.toast-close:hover{color:#fff}
.toast-progress{position:absolute;left:0;bottom:0;height:2px;width:100%;background:var(--toast-accent);transform-origin:left;animation:toastProgress var(--toast-duration,4s) linear forwards}
@keyframes toastIn{to{transform:none;opacity:1}}@keyframes toastOut{to{transform:translateX(30px);opacity:0}}
@keyframes toastProgress{to{transform:scaleX(0)}}
#confirmOverlay{
  position:fixed;inset:0;z-index:100000;display:none;place-items:center;padding:20px;
  background:rgba(2,5,9,.72);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);
}
.confirm-card{
  width:min(440px,100%);padding:23px;border:1px solid rgba(255,255,255,.11);border-radius:20px;
  background:linear-gradient(145deg,#151b25,#0b0f15);box-shadow:0 35px 100px #0009;
  transform:translateY(8px) scale(.98);animation:confirmIn .2s ease forwards
}
.confirm-icon{width:44px;height:44px;border-radius:14px;display:grid;place-items:center;background:#25131a;color:#ff708a;font-size:20px;margin-bottom:15px}
.confirm-card h3{margin:0 0 7px;font-size:18px}.confirm-card p{margin:0;color:#98a4b5;line-height:1.5;font-size:13px}
.confirm-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:21px}
@keyframes confirmIn{to{transform:none}}
@media(max-width:560px){#toastStack{right:12px;top:12px;width:calc(100vw - 24px)}}

@media(max-width:900px){.layout{grid-template-columns:70px 1fr}.side{padding:10px 6px}.brand{font-size:0;text-align:center}.brand .logo{font-size:21px}.nav button{font-size:0;text-align:center}.nav button:first-letter{font-size:18px}.main{padding:15px}.g4,.g2{grid-template-columns:1fr 1fr}}
@media(max-width:560px){.g4,.g2{grid-template-columns:1fr}.top{align-items:flex-start;flex-direction:column}}
</style>

<style id="android-admin-overrides">
/* Premium feature launcher + full-page feature workspaces */
.feature-launcher{padding-bottom:24px}.launcher-head{margin-bottom:18px}.launcher-head h2{margin:3px 0 5px;font-size:28px}.feature-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.feature-tile{appearance:none;border:1px solid var(--line);background:linear-gradient(145deg,#111722,#0b1018);color:var(--text);border-radius:18px;padding:18px;min-height:125px;display:flex;align-items:center;gap:14px;text-align:left;cursor:pointer;box-shadow:0 10px 28px rgba(0,0,0,.18);transition:transform .18s,border-color .18s,background .18s}.feature-tile:hover{transform:translateY(-2px);border-color:rgba(255,79,163,.55);background:linear-gradient(145deg,#171d29,#0d121b)}.feature-tile:active{transform:scale(.985)}.feature-icon{width:48px;height:48px;flex:0 0 48px;border-radius:14px;display:grid;place-items:center;background:rgba(255,255,255,.06);font-size:24px}.feature-tile b{display:block;font-size:15px}.feature-tile small{display:block;color:var(--muted);font-size:11px;line-height:1.35;margin-top:5px}.view.feature-page{position:fixed;inset:0;z-index:2000;background:radial-gradient(circle at top right,rgba(255,79,163,.08),transparent 32%),#07090d;overflow:auto;padding:0!important;max-width:none!important;width:100vw!important;height:100dvh!important}.feature-page .feature-page-inner{max-width:1450px;min-height:100%;margin:0 auto;padding:24px clamp(14px,3vw,36px) 40px}.feature-page .feature-page-head{position:sticky;top:0;z-index:20;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 0 16px;background:linear-gradient(#07090d 72%,transparent);margin-bottom:8px}.feature-page .feature-close{min-width:44px;min-height:44px;border:1px solid var(--line);border-radius:12px;background:#111722;color:#fff;font-size:20px;cursor:pointer}.feature-page .feature-close:hover{border-color:var(--pink)}.feature-page .card{min-width:0}.feature-page table{max-width:100%}@media(max-width:900px){.feature-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:560px){.feature-grid{grid-template-columns:1fr;gap:10px}.feature-tile{min-height:96px;padding:14px}.feature-page .feature-page-inner{padding:12px 12px 28px}.feature-page .feature-page-head{padding:10px 0 14px}.launcher-head h2{font-size:23px}}

/* Desktop-style Admin that fits every Android viewport without page overflow. */
html,body{width:100%;max-width:100%;min-width:0;overflow-x:hidden!important;}
body{min-height:100dvh;padding-left:env(safe-area-inset-left);padding-right:env(safe-area-inset-right);padding-bottom:env(safe-area-inset-bottom);}
.layout{min-width:0;max-width:100%;}
.main{min-width:0;max-width:none;width:100%;}
.side{min-width:0;}
.card,.grid,.toolbar,.top,.view{min-width:0;max-width:100%;}
.scroll{max-width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch;}
table{min-width:680px;}
@media(max-width:900px){
  .layout{grid-template-columns:70px minmax(0,1fr);}
  .side{width:70px;padding:10px 6px;}
  .brand{font-size:0;text-align:center;}
  .brand .logo{font-size:21px;}
  .nav button{font-size:0;text-align:center;}
  .nav button:first-letter{font-size:18px;}
  .main{padding:16px;overflow:hidden;}
  .grid.g4{grid-template-columns:repeat(2,minmax(0,1fr));}
  .grid.g2{grid-template-columns:repeat(2,minmax(0,1fr));}
}
@media(max-width:560px){
  .layout{grid-template-columns:58px minmax(0,1fr);}
  .side{width:58px;padding:9px 4px;}
  .main{padding:12px;}
  .g4,.g2{grid-template-columns:minmax(0,1fr);}
  .top{align-items:flex-start;flex-direction:row;flex-wrap:wrap;}
  .top>div{min-width:0;flex:1;}
  .title{font-size:20px;overflow-wrap:anywhere;}
  .identity{overflow-wrap:anywhere;}
  .toolbar input{min-width:0;flex:1 1 160px;}
  .card{padding:14px;}
  .confirm-card{width:min(440px,calc(100vw - 24px));}
}
@media(max-width:360px){.nav button{padding-left:5px;padding-right:5px;}.main{padding:9px;}.card{padding:12px;}}
</style>
<meta name="theme-color" content="#07090d"><meta name="mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<style id="mobile-layout-fix">
/* Mobile layout fix: keep the Admin workspace visible and prevent sidebar text
   from collapsing into a narrow vertical strip. Desktop styles remain unchanged. */
@media (max-width:700px){
  html,body{width:100%;max-width:100%;min-width:0;overflow-x:hidden!important;}
  #app{width:100%;min-width:0;}
  .layout{
    display:block!important;
    width:100%!important;
    min-width:0!important;
    max-width:100%!important;
  }
  .side{
    position:relative!important;
    top:auto!important;
    width:100%!important;
    height:auto!important;
    min-height:0!important;
    padding:8px 10px!important;
    border-right:0!important;
    border-bottom:1px solid var(--line)!important;
    display:block!important;
    overflow:hidden!important;
  }
  .brand{
    padding:4px 6px 8px!important;
    text-align:left!important;
    font-size:inherit!important;
  }
  .brand .logo{font-size:21px!important;}
  .nav{
    display:grid!important;
    grid-template-columns:repeat(2,minmax(0,1fr))!important;
    width:100%!important;
    gap:7px!important;
    overflow:visible!important;
    padding:2px 0!important;
  }
  .nav button{
    width:100%!important;
    min-width:0!important;
    white-space:normal!important;
    font-size:12px!important;
    text-align:center!important;
    padding:10px 7px!important;
    min-height:42px!important;
  }
  .nav button:first-letter{font-size:inherit!important;}
  .signout{
    display:inline-block!important;
    width:auto!important;
    margin:8px 0 0!important;
  }
  .main{
    display:block!important;
    width:100%!important;
    max-width:100%!important;
    min-width:0!important;
    padding:12px!important;
    overflow:visible!important;
  }
  .top{
    width:100%!important;
    min-width:0!important;
    margin-bottom:14px!important;
  }
  .grid,.g4,.g2,.feature-grid{
    width:100%!important;
    max-width:100%!important;
    min-width:0!important;
  }
  .card,.view,.toolbar,.feature-tile{
    min-width:0!important;
    max-width:100%!important;
  }
  .toolbar input{min-width:0!important;max-width:100%!important;}
  table{display:block;width:100%;max-width:100%;overflow-x:auto;}
  pre{max-width:100%;overflow:auto;}
}

@media(max-width:380px){
  .side{padding:7px 7px!important;}
  .nav button{padding:8px 9px!important;font-size:11px!important;}
  .main{padding:9px!important;}
}
</style>

<style id="spike-room-admin-css">
.room-admin{display:grid;gap:14px}.room-admin-head{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.room-admin-head select{flex:1;min-width:220px;background:#090d13;color:#fff;border:1px solid var(--line);border-radius:10px;padding:10px}.room-hero{background:linear-gradient(145deg,rgba(138,43,226,.18),rgba(0,240,255,.08));border:1px solid var(--line);border-radius:18px;padding:18px}.room-hero-top{display:flex;justify-content:space-between;gap:12px;align-items:center}.room-hero h2{margin:0;font-size:22px}.room-sub{color:var(--muted);font-size:12px;margin-top:5px}.room-metrics{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:9px;margin-top:14px}.room-metric{background:rgba(0,0,0,.18);border:1px solid var(--line);border-radius:12px;padding:11px}.room-metric b{display:block;font-size:18px}.room-metric span{display:block;color:var(--muted);font-size:9px;text-transform:uppercase;margin-top:4px}.room-tabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;padding-bottom:0}.room-tab{white-space:nowrap;border:1px solid var(--line);background:#111722;color:var(--muted);border-radius:10px;padding:9px 12px;font-weight:800}.room-tab.active{color:#fff;border-color:var(--pink);background:#211525}.room-pane{display:none}.room-pane.active{display:block}.room-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.room-list{display:grid;gap:7px}.room-row{display:flex;justify-content:space-between;gap:10px;align-items:center;padding:10px;border:1px solid var(--line);border-radius:11px;background:#0a0f16}.room-row small{display:block;color:var(--muted);margin-top:3px}.room-chat{max-height:520px;overflow:auto;display:grid;gap:8px}.room-msg{padding:10px;border:1px solid var(--line);border-radius:12px;background:#0a0f16}.room-msg b{font-size:12px}.room-msg p{margin:4px 0 0;line-height:1.4;overflow-wrap:anywhere}.room-world-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.room-action-bar{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.room-admin .btn{min-height:38px}.room-reward-selected{border-color:var(--pink)!important;background:#18111e}.room-purchase-card{display:flex;justify-content:space-between;gap:10px;align-items:center;flex-wrap:wrap}.room-purchase-meta{font-size:11px;color:var(--muted)}@media(max-width:900px){.room-metrics{grid-template-columns:repeat(3,minmax(0,1fr))}.room-grid{grid-template-columns:1fr}}@media(max-width:560px){.room-metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.room-world-grid{grid-template-columns:1fr}}
</style>
</head>
<body>
<div id="toastStack" aria-live="polite" aria-atomic="true"></div>
<div id="confirmOverlay" role="dialog" aria-modal="true">
  <div class="confirm-card">
    <div class="confirm-icon">!</div>
    <h3 id="confirmTitle">Are you sure?</h3>
    <p id="confirmMessage"></p>
    <div class="confirm-actions">
      <button class="btn" id="confirmCancel">Cancel</button>
      <button class="btn danger" id="confirmOk">Continue</button>
    </div>
  </div>
</div>
<section id="login">
  <div class="login-card">
    <div class="logo">⚡ SPIKE</div>
    <div class="eyebrow">Admin Console · Restricted</div>
    <form id="loginForm">
      <div class="field"><label>Email</label><input id="email" type="email" value="eletexjoeytex@gmail.com" autocomplete="username" required></div>
      <div class="field"><label>Password</label><input id="password" type="password" autocomplete="current-password" required></div>
      <button class="btn primary wide" type="submit">Sign in to Admin Console</button>
      <div id="loginMsg" class="msg"></div>
    </form>
  </div>
</section>

<section id="app">
<div class="layout">
<aside class="side">
  <div class="brand"><div class="logo">⚡ SPIKE</div></div>
  <nav class="nav">
    <button class="active" data-view="dashboard">📊 Dashboard</button>
    <button data-view="posts">📝 Posts</button>
    <button data-view="users">👤 SPIKE Users</button>
    <button data-view="media">🖼️ Media</button>
    <button data-view="analytics">📈 Analytics</button>
    <button data-view="settings">⚙️ Settings</button>
      <button class="nav-btn" data-view="control">🧭 Control Center</button>
    <button data-view="reports">🔎 Reports</button>
    <button data-view="logs">📋 Logs</button>
    <button data-view="live">🔴 Live</button>
     <button data-view="rooms">🏠 Rooms</button>
  </nav>
  <button id="logout" class="btn danger signout">↪ Sign out</button>
</aside>
<div class="mobile-backdrop" id="mobileBackdrop"></div>
<main class="main">
  <div class="top"><button class="mobile-menu" id="mobileMenu" aria-label="Open menu">☰</button><div><div id="viewTitle" class="title">Dashboard</div><div id="identity" class="identity"></div></div><button id="refresh" class="btn">↻ Refresh</button></div>

  <section id="dashboard" class="view active">
    <div class="feature-launcher">
      <div class="launcher-head"><div><div class="eyebrow">SPIKE ADMIN</div><h2>Control Center</h2><p class="muted">Choose a feature to open its full workspace.</p></div></div>
      <div class="feature-grid" id="featureGrid">
        <button class="feature-tile" data-open-view="posts"><span class="feature-icon">📝</span><span><b>Posts</b><small>Manage and delete posts</small></span></button>
        <button class="feature-tile" data-open-view="users"><span class="feature-icon">👥</span><span><b>SPIKE Users</b><small>Search and manage accounts</small></span></button>
        <button class="feature-tile" data-open-view="media"><span class="feature-icon">🖼️</span><span><b>Media</b><small>Browse media library</small></span></button>
        <button class="feature-tile" data-open-view="analytics"><span class="feature-icon">📈</span><span><b>Analytics</b><small>View platform statistics</small></span></button>
        <button class="feature-tile" data-open-view="settings"><span class="feature-icon">⚙️</span><span><b>Settings</b><small>Configure SPIKE</small></span></button>
        <button class="feature-tile" data-open-view="reports"><span class="feature-icon">🔎</span><span><b>Reports</b><small>Run administrative reports</small></span></button>
        <button class="feature-tile" data-open-view="logs"><span class="feature-icon">📋</span><span><b>Logs</b><small>Review activity</small></span></button>
        <button class="feature-tile" data-open-view="live"><span class="feature-icon">🔴</span><span><b>Live</b><small>Manage live sessions</small></span></button>
        <button class="feature-tile" data-open-view="control"><span class="feature-icon">🧭</span><span><b>Control Center</b><small>Trace admin activity and system state</small></span></button>
        <button class="feature-tile" data-open-view="rooms"><span class="feature-icon">🏠</span><span><b>Rooms</b><small>Full Room dashboard and member tools</small></span></button>
      </div>
    </div>

    <div class="grid g4">
      <div class="card stat"><b id="sPosts">—</b><span>Posts</span></div><div class="card stat"><b id="sUsers">—</b><span>Users</span></div>
      <div class="card stat"><b id="sMedia">—</b><span>Media posts</span></div><div class="card stat"><b id="sLive">—</b><span>Live sessions</span></div>
    </div>
    <div class="grid g2" style="margin-top:14px">
      <div class="card"><h3>Recent posts</h3><div id="recent"></div></div>
      <div class="card"><h3>Developer access</h3><p class="muted">Authenticated role: <strong id="role">—</strong></p><p class="success">✓ Database authorization active</p><p class="muted">Future public tables are protected by the developer access policy.</p></div>
    </div>
  </section>

  <section id="posts" class="view"><div class="card"><div class="toolbar"><input id="postSearch" placeholder="Search posts"><button class="btn" id="postsRefresh">Refresh</button></div><div class="scroll"><table><thead><tr><th>Post</th><th>Author</th><th>Updated</th><th>Actions</th></tr></thead><tbody id="postsBody"></tbody></table></div></div></section>

  <section id="users" class="view"><div class="card"><div class="toolbar"><input id="userSearch" placeholder="Search users"><button class="btn" id="usersRefresh">Refresh</button></div><div class="scroll"><table><thead><tr><th>User</th><th>Email</th><th>Role</th><th>Joined</th><th>Actions</th></tr></thead><tbody id="usersBody"></tbody></table></div></div><div class="card" style="margin-top:14px"><h3>🎁 Developer Reward</h3><p class="muted">Select a user and send an official Store package. The protected RPC performs the actual wallet mutation and audit.</p><div class="grid g2"><div><label class="muted">User</label><select id="grantUserPicker" class="input" style="width:100%;margin-top:6px"><option value="">Select user…</option></select></div><div><label class="muted">Credit / Coin package</label><select id="grantCreditPackage" class="input" style="width:100%;margin-top:6px"><option value="">Choose package…</option></select></div></div><div class="grid g2" style="margin-top:10px"><div><label class="muted">Energy package</label><select id="grantEnergyPackage" class="input" style="width:100%;margin-top:6px"><option value="">Choose package…</option></select></div><div class="room-action-bar" style="align-items:end"><button class="btn primary" id="grantCreditBtn">🪙 Send Credits</button><button class="btn primary" id="grantEnergyBtn">⚡ Send Energy</button></div></div></div></section>

  <section id="media" class="view"><div class="card"><h3>Media Library</h3><div id="mediaGrid" class="grid g4"></div></div></section>

  <section id="analytics" class="view"><div class="grid g4"><div class="card stat"><b id="aViews">—</b><span>Views</span></div><div class="card stat"><b id="aLikes">—</b><span>Likes</span></div><div class="card stat"><b id="aComments">—</b><span>Comments</span></div><div class="card stat"><b id="aAuthors">—</b><span>Authors</span></div></div></section>
<section id="control" class="view"><div class="card"><h2>🧭 Control Center</h2><p class="muted">One place to trace what is happening across SPIKE. Every privileged action should be visible here with who, what, where, why, and when.</p><div class="grid g4"><div class="card stat"><b id="traceUsers">—</b><span>Users</span></div><div class="card stat"><b id="traceRooms">—</b><span>Active Rooms</span></div><div class="card stat"><b id="traceReports">—</b><span>Open Reports</span></div><div class="card stat"><b id="traceLast">—</b><span>Last Admin Action</span></div></div><div class="toolbar" style="margin-top:14px"><select id="traceModule"><option value="">All modules</option><option>Users</option><option>Rooms</option><option>Moderation</option><option>Streaks</option><option>Economy</option><option>World</option><option>Events</option><option>Championships</option><option>Roles</option><option>Settings</option><option>Developer</option></select><button class="btn primary" id="traceRefresh">Refresh trace</button></div><div id="traceList" style="margin-top:14px"></div></div></section>

<section id="rooms" class="view feature-page"><div class="feature-page-inner"><div class="feature-page-head"><div><div class="eyebrow">SPIKE ROOM ADMIN</div><div class="title">Room Dashboard</div></div><button class="feature-close" type="button" aria-label="Close and return to Admin Hub">✕</button></div><div class="room-admin">
<div class="card room-admin-head"><select id="adminRoomSelect"><option value="">Loading Rooms…</option></select><button class="btn" id="adminRoomRefresh">↻ Refresh</button></div>
<div id="adminRoomHero" class="room-hero"><div class="empty">Select a Room to inspect its live dashboard.</div></div>
<div class="room-tabs"><button class="room-tab active" data-room-tab="overview">Overview</button><button class="room-tab" data-room-tab="chat">Chat</button><button class="room-tab" data-room-tab="members">Members</button><button class="room-tab" data-room-tab="world">SPIKE World</button><button class="room-tab" data-room-tab="economy">Economy</button><button class="room-tab" data-room-tab="moderation">Moderation</button></div>
<div id="roomPaneOverview" class="room-pane active"><div class="room-grid"><div class="card"><h3>Live Room</h3><div id="adminRoomOverview"></div></div><div class="card"><h3>Current Topic</h3><div id="adminRoomTopic" class="muted">—</div><div class="room-action-bar"><button class="btn primary" id="adminRoomTopicBtn">Set topic</button></div></div></div></div>
<div id="roomPaneChat" class="room-pane"><div class="card"><div class="toolbar"><input id="adminRoomChatSearch" placeholder="Search messages"><button class="btn" id="adminRoomChatRefresh">Refresh</button></div><div id="adminRoomChat" class="room-chat"></div></div></div>
<div id="roomPaneMembers" class="room-pane"><div class="room-grid"><div class="card"><div class="toolbar"><input id="adminRoomMemberSearch" placeholder="Search members"><button class="btn" id="adminRoomMemberRefresh">Refresh</button></div><div class="scroll"><table><thead><tr><th>Member</th><th>Coins</th><th>Energy</th><th>Energy Credits</th><th>SP</th><th>Action</th></tr></thead><tbody id="adminRoomMembers"></tbody></table></div></div><div class="card"><h3>🎁 Send Store Package</h3><p class="muted">Select a Room member, then send the exact active package from the Room Store. Rewards are recorded through protected developer RPCs.</p><div id="adminRewardTarget" class="room-row"><span>Target</span><strong>No member selected</strong></div><label class="muted">Credit / Coin package</label><select id="adminCreditPackage" class="input" style="width:100%;margin:6px 0 12px"><option value="">Loading packages…</option></select><label class="muted">Energy package</label><select id="adminEnergyPackage" class="input" style="width:100%;margin:6px 0 12px"><option value="">Loading packages…</option></select><div class="room-action-bar"><button class="btn primary" id="adminSendCreditPackage">🪙 Send Credits</button><button class="btn primary" id="adminSendEnergyPackage">⚡ Send Energy</button></div><div id="adminRewardStatus" class="muted" style="margin-top:10px"></div></div></div><div class="card" style="margin-top:14px"><div class="toolbar"><strong>🧾 Pending Room Purchases</strong><button class="btn" id="adminPurchaseRefresh">Refresh</button></div><div id="adminRoomPurchases" class="room-list"></div></div></div>
<div id="roomPaneWorld" class="room-pane"><div id="adminRoomWorld" class="room-world-grid"></div><div class="room-action-bar"><button class="btn primary" id="adminCreateQuest">🤝 Create Quest</button><button class="btn primary" id="adminCreateChamp">🏆 Championship</button><button class="btn" id="adminTriggerEvent">🎲 Trigger Event</button></div></div>
<div id="roomPaneEconomy" class="room-pane"><div class="room-grid"><div class="card"><h3>Room Wallet / SP</h3><div id="adminRoomEconomy"></div></div><div class="card"><h3>Admin Adjustment</h3><p class="muted">Use the protected developer RPCs for account-level SP/credit adjustments.</p><div class="room-action-bar"><button class="btn primary" id="adminSpAdjust">Adjust SP</button><button class="btn primary" id="adminCreditAdjust">Grant Credits</button></div></div></div></div>
<div id="roomPaneModeration" class="room-pane"><div class="card"><h3>Room Moderation</h3><p class="muted">Review room membership, messages and reported activity from the admin console.</p><div class="room-action-bar"><button class="btn" id="adminRoomRefreshModeration">Refresh room data</button></div><div id="adminRoomModeration" class="room-list"></div></div></div>
</div></div></section>

<section id="settings" class="view"><div class="card" style="margin-bottom:14px"><h3>Supabase backend</h3><p class="muted">Admin settings, roles, bans, broadcasts and audit actions are stored through protected Supabase functions.</p><p class="success">✓ Connected backend</p></div><div class="grid g2">
    <div class="card"><h3>Announcement</h3><div class="field"><textarea id="announcement" rows="4" placeholder="Announcement..."></textarea></div><button class="btn primary" id="saveAnnouncement">Save announcement</button><button class="btn danger" id="clearAnnouncement">Clear</button></div>
    <div class="card"><h3>Feature switches</h3><label><input id="maintenance" type="checkbox"> Maintenance mode</label><br><br><label><input id="registrations" type="checkbox" checked> Allow registrations</label><br><br><label><input id="video" type="checkbox" checked> Video uploads</label><br><br><label><input id="live" type="checkbox" checked> Live streaming</label><br><br><button class="btn primary" id="saveFeatures">Save switches</button></div>
  </div></section>
<section id="reports" class="view"><div class="card"><h3>🛡️ Moderation & Reports</h3><p class="muted">Live Feed and Room reports from Supabase. This replaces the old post-only report view.</p><div class="toolbar"><button class="btn primary" id="runReport">Refresh reports</button></div><pre id="reportOut">Loading reports…</pre></div></section>

  <section id="logs" class="view"><div class="card"><h3>Activity</h3><pre id="logsOut">Loading…</pre></div></section>

  <section id="live" class="view"><div class="card"><h3>Active live sessions</h3><div id="liveList"></div></div><div class="card" style="margin-top:14px"><h3>Live alert</h3><div class="toolbar"><input id="alert" placeholder="Message"><button class="btn primary" id="sendAlert">Send</button></div></div></section>
</main>
</div>
</section>

<script>
const mobileMenu=document.getElementById("mobileMenu");
const mobileSide=document.querySelector(".side");
const mobileBackdrop=document.getElementById("mobileBackdrop");
function closeMobileMenu(){mobileSide?.classList.remove("open");mobileBackdrop?.classList.remove("open");}
function openMobileMenu(){mobileSide?.classList.add("open");mobileBackdrop?.classList.add("open");}
mobileMenu?.addEventListener("click",openMobileMenu);
mobileBackdrop?.addEventListener("click",closeMobileMenu);
const SUPABASE_URL="https://bkrrewagsbjqgmxaaqyt.supabase.co";
const KEY="sb_publishable_24Z2PQpdG13cf6_9w8C7nA_zXEzr60O";
const db=window.supabase.createClient(SUPABASE_URL,KEY,{auth:{persistSession:true}});
const $=id=>document.getElementById(id);
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
let user=null, role=null, posts=[], users=[];


function toast(message,type="info",title){
  const stack=document.getElementById("toastStack");
  const el=document.createElement("div");
  const titles={success:"Success",error:"Something went wrong",warning:"Attention",info:"Notification"};
  const icons={success:"✓",error:"×",warning:"!",info:"i"};
  const duration=type==="error"?6500:4000;
  el.className=`toast ${type}`;
  el.style.setProperty("--toast-duration",duration+"ms");
  el.innerHTML=`<div class="toast-icon">${icons[type]||"i"}</div><div class="toast-copy"><div class="toast-title">${esc(title||titles[type])}</div><div class="toast-message">${esc(message)}</div></div><button class="toast-close" aria-label="Dismiss">×</button><div class="toast-progress"></div>`;
  el.querySelector(".toast-close").onclick=()=>dismissToast(el);
  stack.appendChild(el);
  setTimeout(()=>dismissToast(el),duration);
  return el;
}
function dismissToast(el){if(!el||el.classList.contains("leaving"))return;el.classList.add("leaving");setTimeout(()=>el.remove(),230)}
function notifyError(e, fallback="Unable to complete that action."){toast(e?.message||String(e)||fallback,"error","Action failed")}
function askConfirm(message,title="Please confirm"){
  return new Promise(resolve=>{
    const o=document.getElementById("confirmOverlay"),ok=document.getElementById("confirmOk"),cancel=document.getElementById("confirmCancel");
    document.getElementById("confirmTitle").textContent=title;
    document.getElementById("confirmMessage").textContent=message;
    o.style.display="grid";
    let done=false;
    const finish=v=>{if(done)return;done=true;o.style.display="none";ok.onclick=null;cancel.onclick=null;resolve(v)};
    ok.onclick=()=>finish(true);cancel.onclick=()=>finish(false);
    o.onclick=e=>{if(e.target===o)finish(false)};
  });
}
function askText(message,title="Enter details",placeholder="",multiline=false){
  return new Promise(resolve=>{
    const old=document.getElementById("textPromptOverlay"); if(old) old.remove();
    const o=document.createElement("div"); o.id="textPromptOverlay"; o.style.cssText="position:fixed;inset:0;z-index:100001;display:grid;place-items:center;padding:18px;background:rgba(2,5,9,.74);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px)";
    o.innerHTML=`<div style="width:min(440px,100%);padding:22px;border:1px solid rgba(255,255,255,.11);border-radius:20px;background:linear-gradient(145deg,#151b25,#0b0f15);box-shadow:0 35px 100px #0009"><div style="font-size:20px;margin-bottom:10px">✦</div><h3 style="margin:0 0 7px;font-size:18px">${esc(title)}</h3><p style="margin:0;color:#98a4b5;line-height:1.5;font-size:13px">${esc(message)}</p>${multiline?`<textarea id="textPromptInput" placeholder="${esc(placeholder)}" style="width:100%;min-height:100px;margin-top:14px;background:#090d13;color:#fff;border:1px solid #202938;border-radius:11px;padding:11px;outline:0;resize:vertical"></textarea>`:`<input id="textPromptInput" placeholder="${esc(placeholder)}" style="width:100%;margin-top:14px;background:#090d13;color:#fff;border:1px solid #202938;border-radius:11px;padding:11px;outline:0">`}<div style="display:flex;justify-content:flex-end;gap:8px;margin-top:18px"><button id="textPromptCancel" class="btn">Cancel</button><button id="textPromptOk" class="btn primary">Continue</button></div></div>`;
    document.body.appendChild(o);
    const input=o.querySelector('#textPromptInput'); input.focus();
    const finish=v=>{o.remove();resolve(v)};
    o.querySelector('#textPromptCancel').onclick=()=>finish(null);
    o.querySelector('#textPromptOk').onclick=()=>finish(input.value.trim());
    o.addEventListener('click',e=>{if(e.target===o)finish(null)});
    input.addEventListener('keydown',e=>{if(!multiline&&e.key==='Enter'){e.preventDefault();finish(input.value.trim())} if(e.key==='Escape')finish(null)});
  });
}
function loadingButton(btn,label="Working…"){
  if(!btn)return()=>{};
  const old=btn.innerHTML;btn.disabled=true;btn.innerHTML=`<span style="opacity:.7">⌛</span> ${label}`;
  return()=>{btn.disabled=false;btn.innerHTML=old};
}

function msg(t,ok=false){$("loginMsg").textContent=t;$("loginMsg").style.color=ok?"#40e58a":"#ff708a"}
async function authorize(u){
  const {data,error}=await db.from("user_roles").select("role").eq("user_id",u.id);
  if(error) throw error;
  const roles=(data||[]).map(x=>x.role);
  role=roles.find(x=>["owner","admin","developer"].includes(x));
  if(!role) throw new Error("Developer access required.");
  return role;
}
async function signIn(e){
  e.preventDefault(); msg("Signing in…");
  const {data,error}=await db.auth.signInWithPassword({email:$("email").value.trim(),password:$("password").value});
  if(error){msg(error.message);toast(error.message,"error","Sign-in failed");return}
  try{await authorize(data.user); user=data.user; $("login").style.display="none"; $("app").style.display="block"; $("identity").textContent=user.email+" · "+role; $("role").textContent=role;  await loadAll();toast("Admin console ready.","success","Welcome back")}catch(err){await db.auth.signOut();msg(err.message)}
}
$("loginForm").addEventListener("submit",signIn);
$("logout").onclick=async()=>{await db.auth.signOut();location.reload()};

const names={dashboard:"Dashboard",posts:"Posts",users:"SPIKE Users",media:"Media",analytics:"Analytics",settings:"Settings",reports:"Reports",logs:"Logs",live:"Live",rooms:"Rooms",control:"Control Center"};
function openAdminFeature(view){
  const el=$(view); if(!el)return;
  document.querySelectorAll(".view").forEach(x=>x.classList.remove("active","feature-page"));
  el.classList.add("active");
  if(view!=="dashboard"){
    el.classList.add("feature-page");
    if(!el.querySelector(".feature-page-inner")){
      const children=Array.from(el.childNodes);
      const wrap=document.createElement("div"); wrap.className="feature-page-inner";
      const head=document.createElement("div"); head.className="feature-page-head";
      head.innerHTML=`<div><div class="eyebrow">SPIKE ADMIN</div><div class="title">${esc(names[view]||view)}</div></div><button class="feature-close" type="button" aria-label="Close and return to Admin Hub">✕</button>`;
      const content=document.createElement("div"); content.className="feature-page-content"; children.forEach(n=>content.appendChild(n));
      wrap.append(head,content); el.appendChild(wrap);
    }
    document.body.classList.add("feature-open");
    el.querySelector(".feature-close")?.focus();
  } else { document.body.classList.remove("feature-open"); }
  document.querySelectorAll(".nav button").forEach(x=>x.classList.toggle("active",x.dataset.view===view));
  $("viewTitle").textContent=names[view]||view; closeMobileMenu();
  if(view!=="dashboard")el.scrollTop=0; else window.scrollTo({top:0,behavior:"smooth"});
}
function closeAdminFeature(){
  openAdminFeature("dashboard");
}

// Every feature-page close button returns to the Admin Hub.
// Delegation also covers close buttons created dynamically inside feature pages.
document.addEventListener("click",event=>{
  const closeButton=event.target.closest(".feature-close");
  if(!closeButton)return;
  event.preventDefault();
  event.stopPropagation();
  closeAdminFeature();
});
document.querySelectorAll(".nav[data-view], .nav button[data-view]").forEach(b=>b.onclick=()=>openAdminFeature(b.dataset.view));
document.querySelectorAll("[data-open-view]").forEach(b=>b.onclick=()=>openAdminFeature(b.dataset.openView));

async function count(table,filter){let q=db.from(table).select("*",{count:"exact",head:true});if(filter)q=q.eq(...filter);const r=await q;return r.count||0}
async function loadDashboard(){
  $("sPosts").textContent=await count("app_documents",["collection_name","posts"]);
  $("sUsers").textContent=await count("profiles");
  const {data:p}=await db.from("app_documents").select("data").eq("collection_name","posts"); $("sMedia").textContent=(p||[]).filter(x=>x.data?.mediaUrl).length;
  $("sLive").textContent=await count("live_sessions",["status","active"]);
  const {data:r}=await db.from("app_documents").select("document_id,data,updated_at").eq("collection_name","posts").order("updated_at",{ascending:false}).limit(8);
  $("recent").innerHTML=(r||[]).map(x=>`<div style="padding:9px 0;border-bottom:1px solid var(--line)">${esc(x.data?.content||"Untitled")}<div class="muted">${new Date(x.updated_at).toLocaleString()}</div></div>`).join("")||'<div class="empty">No posts</div>';
}
async function loadPosts(){
  const {data,error}=await db.from("app_documents").select("*").eq("collection_name","posts").order("updated_at",{ascending:false});if(error)throw error;posts=data||[];renderPosts();
}
function renderPosts(){const q=($("postSearch").value||"").toLowerCase();const a=posts.filter(x=>JSON.stringify(x.data||{}).toLowerCase().includes(q));$("postsBody").innerHTML=a.map(x=>`<tr><td>${esc(x.data?.content||"Untitled")}</td><td>${esc(x.data?.authorName||"Unknown")}</td><td>${new Date(x.updated_at).toLocaleString()}</td><td><button class="btn danger" onclick="delPost('${esc(x.document_id)}')">Delete</button></td></tr>`).join("")||'<tr><td colspan="4" class="empty">No posts</td></tr>'}
async function delPost(id){
  if(!(await askConfirm("This post will be permanently removed. This action cannot be undone.","Delete post?")))return;
  const r=await db.from("app_documents").delete().eq("document_id",id).eq("collection_name","posts");
  if(r.error)notifyError(r.error);else{toast("Post deleted successfully.","success","Post deleted");await loadPosts();await loadDashboard()}
}
$("postSearch").oninput=renderPosts;$("postsRefresh").onclick=loadPosts;

async function loadUsers(){
  const {data,error}=await db.rpc("admin_list_users");
  if(error)throw error;
  users=data||[];
  renderUsers();
  renderGrantUserPicker();
}
function renderGrantUserPicker(){
  const picker=$("grantUserPicker");
  if(!picker)return;
  const current=picker.value;
  const q=($("userSearch")?.value||"").toLowerCase();
  const list=(users||[]).filter(x=>!q||(x.display_name||x.username||x.email||"").toLowerCase().includes(q));
  picker.innerHTML='<option value="">Select user…</option>'+list.map(x=>`<option value="${esc(x.id)}">${esc(x.display_name||x.username||x.email||x.id)}${x.username?` · @${esc(x.username)}`:""}</option>`).join("");
  if(list.some(x=>x.id===current))picker.value=current;
}
async function loadGrantPackages(){
  const credit=$("grantCreditPackage"),energy=$("grantEnergyPackage");
  if(!credit||!energy)return;
  try{
    const r=await db.rpc("admin_room_store_catalog");
    if(r.error)throw r.error;
    const c=r.data?.credits||[],e=r.data?.energy||[];
    credit.innerHTML='<option value="">Choose Credit package…</option>'+c.map(x=>`<option value="${esc(x.id)}">${esc(x.name)} — ${Number(x.credits||0).toLocaleString()} Credits · ₦${Number(x.price_ngn||0).toLocaleString()}</option>`).join("");
    energy.innerHTML='<option value="">Choose Energy package…</option>'+e.map(x=>`<option value="${esc(x.id)}">${esc(x.name)} — ${Number(x.energy_amount||0).toLocaleString()} Charge Reserve · ₦${Number(x.price_ngn||0).toLocaleString()}</option>`).join("");
  }catch(e){notifyError(e,"Unable to load Store packages.")}
}
async function sendDeveloperPackage(type){
  const uid=$("grantUserPicker")?.value;
  const pkg=$(type==="credit"?"grantCreditPackage":"grantEnergyPackage")?.value;
  if(!uid){toast("Select a user first.","error");return}
  if(!pkg){toast("Choose a Store package first.","error");return}
  const target=(users||[]).find(x=>x.id===uid);
  if(!(await askConfirm(`Send the selected ${type==="credit"?"Credit":"Energy"} Store package to ${target?.display_name||target?.username||uid}?`,"Confirm developer reward")))return;
  const fn=type==="credit"?"admin_room_grant_credit_package":"admin_room_grant_energy_package";
  const args=type==="credit"?{p_room_id:adminCurrentRoom||null,p_user_id:uid,p_package_id:pkg,p_reason:"Admin Users reward"}:{p_room_id:adminCurrentRoom||null,p_user_id:uid,p_package_id:pkg,p_reason:"Admin Users reward"};
  if(!args.p_room_id){
    const r=await db.rpc(type==="credit"?"admin_grant_credits":"admin_grant_energy_credits",type==="credit"?{p_user_id:uid,p_amount:Number((grantCreditPackage?.selectedOptions?.[0]?.textContent||"").match(/[\d,]+/)?.[0]?.replace(/,/g,"")||0),p_reason:"Admin Users reward"}:{p_user_id:uid,p_amount:Number((grantEnergyPackage?.selectedOptions?.[0]?.textContent||"").match(/[\d,]+/)?.[0]?.replace(/,/g,"")||0),p_reason:"Admin Users reward"});
    if(r.error)notifyError(r.error);else toast("Reward sent successfully.","success","Developer reward");
    return;
  }
  const r=await db.rpc(fn,args);
  if(r.error)notifyError(r.error);else{toast("Reward sent successfully.","success","Developer reward");await loadUsers();}
}

function renderUsers(){
  const q=($("userSearch").value||"").toLowerCase();
  const a=users.filter(x=>(x.display_name||x.username||x.email||"").toLowerCase().includes(q));
  $("usersBody").innerHTML=a.map(x=>{
    const flags=[x.suspended?"Suspended":"",x.premium?"Premium":"",x.vip?"VIP":""].filter(Boolean).join(" · ");
    return `<tr><td>${esc(x.display_name||x.username||"User")}${flags?`<div class="muted">${esc(flags)}</div>`:""}</td><td>${esc(x.email||"—")}</td><td><span class="tag ${x.role==="developer"?"dev":""}">${esc(x.role||"user")}</span></td><td>${x.created_at?new Date(x.created_at).toLocaleDateString():"—"}</td><td><button class="btn" onclick="promote('${esc(x.id)}')">Promote</button> <button class="btn danger" onclick="ban('${esc(x.id)}')">Ban</button></td></tr>`;
  }).join("")||'<tr><td colspan="5" class="empty">No users</td></tr>'
}
async function promote(id){
  if(!(await askConfirm("This user will receive administrator privileges.","Promote user?")))return;
  const r=await db.rpc("admin_set_user_role",{p_user_id:id,p_role:"admin"});
  if(r.error)notifyError(r.error);else{toast("Administrator role granted.","success","User promoted");await loadUsers()}
}
async function ban(id){
  if(!(await askConfirm("This user will be blocked from the application.","Ban user?")))return;
  const r=await db.rpc("admin_set_user_ban",{p_user_id:id,p_is_banned:true,p_banned_until:null,p_reason:"Banned by developer"});
  if(r.error)notifyError(r.error);else{toast("User has been banned.","success","User banned");await loadUsers()}
}
$("userSearch").oninput=()=>{renderUsers();renderGrantUserPicker()};$("usersRefresh").onclick=loadUsers;$("grantCreditBtn")?.addEventListener("click",()=>sendDeveloperPackage("credit"));$("grantEnergyBtn")?.addEventListener("click",()=>sendDeveloperPackage("energy"));

async function loadMedia(){const {data}=await db.from("app_documents").select("document_id,data,updated_at").eq("collection_name","posts");const a=(data||[]).filter(x=>x.data?.mediaUrl);$("mediaGrid").innerHTML=a.map(x=>`<div class="card">${x.data.mediaType==="video"?"🎬":`<img src="${esc(x.data.mediaUrl)}" style="width:100%;aspect-ratio:1;object-fit:cover;border-radius:10px">`}<div class="muted" style="margin-top:7px">${esc(x.data.authorName||"Unknown")}</div></div>`).join("")||'<div class="empty">No media</div>'}
async function loadAnalytics(){const {data}=await db.from("app_documents").select("data").eq("collection_name","posts");const a=data||[];$("aViews").textContent=a.reduce((s,x)=>s+Number(x.data?.views||0),0).toLocaleString();$("aLikes").textContent=a.reduce((s,x)=>s+(Array.isArray(x.data?.likes)?x.data.likes.length:0),0).toLocaleString();$("aComments").textContent=a.reduce((s,x)=>s+(Array.isArray(x.data?.comments)?x.data.comments.length:0),0).toLocaleString();$("aAuthors").textContent=new Set(a.map(x=>x.data?.authorId||x.data?.authorName).filter(Boolean)).size}
async function loadSettings(){
  const {data,error}=await db.from("admin_settings").select("key,value").in("key",["announcement","feature_toggles","maintenance"]);
  if(error)throw error;
  const map=new Map((data||[]).map(x=>[x.key,x.value||{}]));
  $("announcement").value=map.get("announcement")?.text||"";
  const x=map.get("feature_toggles")||{};
  $("registrations").checked=x.registrations!==false;
  $("video").checked=x.videoUploads!==false;
  $("live").checked=x.liveStreaming!==false;
  $("maintenance").checked=(map.get("maintenance")||{}).active===true;
}
$("saveAnnouncement").onclick=async()=>{
  try{
    const text=$("announcement").value.trim();
    const r=await db.rpc("admin_save_setting",{p_key:"announcement",p_value:{text,active:!!text}});
    if(r.error)throw r.error;
    if(text) await db.rpc("admin_save_broadcast",{p_message:text,p_audience:{type:"all"}});
    toast("Announcement saved to Supabase.","success","Saved");
  }catch(e){notifyError(e)}
};
$("clearAnnouncement").onclick=async()=>{
  try{
    const r=await db.rpc("admin_save_setting",{p_key:"announcement",p_value:{text:"",active:false}});
    if(r.error)throw r.error;
    $("announcement").value="";
    toast("Announcement cleared.","success","Cleared");
  }catch(e){notifyError(e)}
};
$("saveFeatures").onclick=async()=>{
  try{
    let r=await db.rpc("admin_save_setting",{p_key:"feature_toggles",p_value:{registrations:$("registrations").checked,videoUploads:$("video").checked,liveStreaming:$("live").checked}});
    if(r.error)throw r.error;
    r=await db.rpc("admin_save_setting",{p_key:"maintenance",p_value:{active:$("maintenance").checked}});
    if(r.error)throw r.error;
    toast("Feature switches saved to Supabase.","success","Saved");
  }catch(e){notifyError(e)}
};

$("runReport").onclick=async()=>{try{const r=await db.rpc("admin_trace_reports",{p_limit:100});if(r.error)throw r.error;$("reportOut").textContent=JSON.stringify(r.data||{},null,2)}catch(e){notifyError(e)}}
async function loadLogs(){const r=await db.rpc("admin_trace_audit",{p_module:null,p_limit:100});if(r.error){$("logsOut").textContent=r.error.message;return}const data=r.data||[];$("logsOut").textContent=data.map(x=>`[${new Date(x.created_at).toISOString()}] ${x.module} · ${x.action} · ${x.target_label||x.target_id||"No target"}${x.reason?` · ${x.reason}`:""}`).join("\n")||"No admin activity yet."}
async function loadLive(){const {data,error}=await db.from("live_sessions").select("*").eq("status","active").order("started_at",{ascending:false});if(error){$("liveList").textContent=error.message;return}$("liveList").innerHTML=(data||[]).map(x=>`<div style="padding:10px 0;border-bottom:1px solid var(--line)">🔴 ${esc(x.title||"Untitled")} · ${x.viewer_count||0} viewers <button class="btn danger" style="float:right" onclick="endLive('${esc(x.id)}')">End</button></div>`).join("")||'<div class="empty">No active sessions</div>'}
async function endLive(id){
  if(!(await askConfirm("The live session will be ended for all viewers.","End live session?")))return;
  const r=await db.rpc("feed_live_end",{p_session_id:id});
  if(r.error)notifyError(r.error);else{toast("Live session ended.","success","Live ended");await loadLive();await loadDashboard()}
}
$("sendAlert").onclick=async()=>{const message=$("alert").value.trim();if(!message)return;const r=await db.rpc("admin_save_broadcast",{p_message:message,p_audience:{type:"live"}});if(r.error)notifyError(r.error);else{$("alert").value="";toast("Live alert sent successfully.","success","Broadcast sent")}}

async function loadAll(){
  const jobs=[
    ["Dashboard",loadDashboard],["Rooms",loadAdminRooms],["Posts",loadPosts],["Users",loadUsers],["Media",loadMedia],["Analytics",loadAnalytics],["Settings",loadSettings],["Logs",loadLogs],["Live",loadLive],["Control Center",loadTrace]
  ];
  let failed=0;
  for(const [name,fn] of jobs){try{await fn()}catch(e){failed++;toast(`${name}: ${e?.message||e}`,"error","Module failed")}}
  return failed===0;
}
$("refresh").onclick=async()=>{
  const b=$("refresh"),restore=loadingButton(b,"Refreshing…");
  const ok=await loadAll();restore();
  if(ok)toast("All developer data is up to date.","success","Refreshed");
};
(async()=>{const {data:{session}}=await db.auth.getSession();if(session){try{await authorize(session.user);user=session.user;$("login").style.display="none";$("app").style.display="block";$("identity").textContent=user.email+" · "+role;$("role").textContent=role;await loadAll()}catch(e){await db.auth.signOut()}}})();

async function loadTrace(){try{const o=await db.rpc("admin_trace_overview");if(o.error)throw o.error;const x=o.data||{};$("traceUsers").textContent=Number(x.users?.total||0).toLocaleString();$("traceRooms").textContent=Number(x.rooms?.active||0).toLocaleString();$("traceReports").textContent=Number(x.reports?.pending||0).toLocaleString();$("traceLast").textContent=x.audit?.last_action?.action||"None";const a=await db.rpc("admin_trace_audit",{p_module:($('traceModule')?.value||null)?.toLowerCase()||null,p_limit:100});if(a.error)throw a.error;$("traceList").innerHTML=(a.data||[]).map(r=>`<div class="card" style="margin-bottom:8px"><strong>${esc(r.action)}</strong> <span class="muted">· ${esc(r.module)}</span><div>${esc(r.target_label||r.target_id||'No target')}</div><div class="muted">${r.reason?esc(r.reason)+' · ':''}${new Date(r.created_at).toLocaleString()}</div></div>`).join('')||'<div class="empty">No audit actions yet.</div>'}catch(e){notifyError(e)}}
if($("traceRefresh")){ $("traceRefresh").onclick=loadTrace; $("traceModule").onchange=loadTrace; }

// Full Room Dashboard — mirrors the Room app's room/world data model while keeping privileged mutations server-side.
let adminRooms=[],adminCurrentRoom=null,adminSelectedMember=null,adminRoomCatalog={credits:[],energy:[]},adminRoomCache={members:[],messages:[],world:null,dash:null,memberStats:{},balances:[],purchases:{credits:[],energy:[]}};
async function loadAdminRooms(){
 const r=await db.from('rooms').select('id,name,description,avatar_url,is_public,is_active,participant_count,owner_id,created_at').order('created_at',{ascending:false});
 if(r.error)throw r.error; adminRooms=r.data||[]; const sel=$('adminRoomSelect'); sel.innerHTML=adminRooms.map(x=>`<option value="${esc(x.id)}">${esc(x.name)}${x.is_active?'':' · inactive'}</option>`).join('')||'<option value="">No rooms</option>'; if(adminCurrentRoom&&adminRooms.some(x=>x.id===adminCurrentRoom))sel.value=adminCurrentRoom; else adminCurrentRoom=adminRooms[0]?.id||null; if(adminCurrentRoom){sel.value=adminCurrentRoom;await loadAdminRoom()} else renderAdminRoomEmpty();}
function renderAdminRoomEmpty(){ $('adminRoomHero').innerHTML='<div class="empty">No Room selected.</div>'; ['adminRoomOverview','adminRoomWorld','adminRoomEconomy','adminRoomModeration'].forEach(id=>{if($(id))$(id).innerHTML=''}); if($('adminRoomChat'))$('adminRoomChat').innerHTML='<div class="empty">No messages</div>'; if($('adminRoomMembers'))$('adminRoomMembers').innerHTML='';}
async function loadAdminRoom(){
 const id=adminCurrentRoom;if(!id)return; const room=adminRooms.find(x=>x.id===id); if(!room)return;
 const [members,msgs,world,dash,topic,stats,balances,purchases]=await Promise.all([
  db.from('room_members').select('user_id,room_id,joined_at,role,profiles(display_name,username,avatar_url)').eq('room_id',id).order('joined_at',{ascending:false}),
  db.from('room_messages').select('id,user_id,body,created_at,profiles(display_name,username,avatar_url)').eq('room_id',id).order('created_at',{ascending:false}).limit(100),
  db.rpc('spike_room_world',{p_room_id:id}),db.rpc('spike_world_dashboard',{p_room_id:id}),
  db.from('room_topics').select('topic,is_active,created_at').eq('room_id',id).eq('is_active',true).order('created_at',{ascending:false}).limit(1).maybeSingle(),
  db.from('room_user_stats').select('user_id,level,sp,energy').in('user_id',(await db.from('room_members').select('user_id').eq('room_id',id)).data?.map(x=>x.user_id)||[]),
  db.rpc('admin_room_member_balances',{p_room_id:id}),db.rpc('admin_room_pending_purchases',{p_room_id:id})
 ]);
 adminRoomCache.members=members.data||[];adminRoomCache.messages=msgs.data||[];adminRoomCache.world=world.data||{};adminRoomCache.dash=dash.data||{};adminRoomCache.memberStats=Object.fromEntries((stats.data||[]).map(x=>[x.user_id,x]));adminRoomCache.balances=balances.data||[];adminRoomCache.purchases=purchases.data||{credits:[],energy:[]};
 $('adminRoomHero').innerHTML=`<div class="room-hero-top"><div><h2>⚡ ${esc(room.name)}</h2><div class="room-sub">${esc(room.description||'No description')} · ${room.is_public?'Public':'Private'} · ${room.is_active?'Active':'Inactive'}</div></div><span class="tag ${room.is_active?'dev':''}">${room.is_active?'LIVE':'INACTIVE'}</span></div><div class="room-metrics"><div class="room-metric"><b>${Number(room.participant_count||0)}</b><span>Participants</span></div><div class="room-metric"><b>${adminRoomCache.members.length}</b><span>Members loaded</span></div><div class="room-metric"><b>${adminRoomCache.messages.length}</b><span>Recent messages</span></div><div class="room-metric"><b>${Number(adminRoomCache.world?.profile?.energy||0)}</b><span>Room energy</span></div><div class="room-metric"><b>${Number(adminRoomCache.dash?.wallet?.coins||0).toLocaleString()}</b><span>Wallet view</span></div><div class="room-metric"><b>${Number((adminRoomCache.dash?.leaderboard||[]).length)}</b><span>Leaderboard</span></div></div>`;
 $('adminRoomOverview').innerHTML=`<div class="room-list"><div class="room-row"><span>Owner</span><strong>${esc(room.owner_id||'—')}</strong></div><div class="room-row"><span>Created</span><strong>${room.created_at?new Date(room.created_at).toLocaleString():'—'}</strong></div><div class="room-row"><span>Live events</span><strong>${(adminRoomCache.world?.events||[]).length}</strong></div><div class="room-row"><span>Active quests</span><strong>${(adminRoomCache.world?.quests||[]).filter(x=>x.status==='active').length}</strong></div></div>`;
 $('adminRoomTopic').textContent=topic.data?.topic||adminRoomCache.world?.topics?.[0]?.topic||'No current topic';
 renderAdminRoomChat();renderAdminRoomMembers();renderAdminRoomWorld();renderAdminRoomEconomy();renderAdminRoomModeration();renderAdminRoomPurchases();
}
function renderAdminRoomChat(){const q=($('adminRoomChatSearch').value||'').toLowerCase();const a=adminRoomCache.messages.filter(x=>String(x.body||'').toLowerCase().includes(q));$('adminRoomChat').innerHTML=a.map(x=>`<div class="room-msg"><b>${esc(x.profiles?.display_name||x.profiles?.username||x.user_id||'Spiker')}</b><small class="muted"> · ${new Date(x.created_at).toLocaleString()}</small><p>${esc(x.body||'')}</p></div>`).join('')||'<div class="empty">No messages found.</div>'}
function renderAdminRoomMembers(){const q=($('adminRoomMemberSearch').value||'').toLowerCase();const a=adminRoomCache.balances.filter(x=>JSON.stringify(x).toLowerCase().includes(q));$('adminRoomMembers').innerHTML=a.map(x=>{const selected=adminSelectedMember===x.user_id;return `<tr class="${selected?'room-reward-selected':''}"><td><strong>${esc(x.display_name||x.username||x.user_id)}</strong><small class="muted">@${esc(x.username||'spiker')} · ${esc(x.role||'member')}</small></td><td>${Number(x.coins||0).toLocaleString()}</td><td>${Number(x.energy||0)}/100</td><td>${Number(x.energy_credits||0).toLocaleString()}</td><td>${Number(x.sp||0).toLocaleString()}</td><td><button class="btn" onclick="selectAdminRoomMember('${esc(x.user_id)}')">${selected?'Selected':'Reward'}</button></td></tr>`}).join('')||'<tr><td colspan="6" class="empty">No members found.</td></tr>';renderAdminRewardTarget();}
function renderAdminRewardTarget(){const m=adminRoomCache.balances.find(x=>x.user_id===adminSelectedMember);$('adminRewardTarget').innerHTML=m?`<span>Target</span><strong>${esc(m.display_name||m.username||m.user_id)} · 🪙 ${Number(m.coins||0).toLocaleString()} · ⚡ ${Number(m.energy||0)}/100</strong>`:'<span>Target</span><strong>No member selected</strong>';}
window.selectAdminRoomMember=function(uid){adminSelectedMember=uid;renderAdminRoomMembers();$('adminRewardStatus').textContent='';};
async function loadAdminRoomStore(){const r=await db.rpc('admin_room_store_catalog');if(r.error)throw r.error;adminRoomCatalog=r.data||{credits:[],energy:[]};$('adminCreditPackage').innerHTML='<option value="">Choose Credit package…</option>'+adminRoomCatalog.credits.map(x=>`<option value="${esc(x.id)}">${esc(x.name)} — ${Number(x.credits).toLocaleString()} Credits · ₦${Number(x.price_ngn).toLocaleString()}</option>`).join('');$('adminEnergyPackage').innerHTML='<option value="">Choose Energy package…</option>'+adminRoomCatalog.energy.map(x=>`<option value="${esc(x.id)}">${esc(x.name)} — ${Number(x.energy_amount).toLocaleString()} Charge Reserve · ₦${Number(x.price_ngn).toLocaleString()}</option>`).join('');}
function renderAdminRoomPurchases(){const p=adminRoomCache.purchases||{};const credits=p.credits||[],energy=p.energy||[];const c=credits.map(x=>`<div class="card room-purchase-card"><div><strong>🪙 ${esc(x.display_name||x.username||x.user_id)}</strong><div class="room-purchase-meta">${esc(x.package_name)} · ${Number(x.credits).toLocaleString()} Credits · ₦${Number(x.price_ngn).toLocaleString()} · ${new Date(x.created_at).toLocaleString()}</div></div><button class="btn primary" onclick="approveAdminRoomPurchase('credit','${esc(x.id)}')">Approve & Send</button></div>`).join('');const e=energy.map(x=>`<div class="card room-purchase-card"><div><strong>⚡ ${esc(x.display_name||x.username||x.user_id)}</strong><div class="room-purchase-meta">${esc(x.package_name)} · ${Number(x.energy_amount).toLocaleString()} Energy · ₦${Number(x.price_ngn).toLocaleString()} · ${new Date(x.created_at).toLocaleString()}</div></div><button class="btn primary" onclick="approveAdminRoomPurchase('energy','${esc(x.id)}')">Approve & Send</button></div>`).join('');$('adminRoomPurchases').innerHTML=c+e||'<div class="empty">No pending purchases for this Room.</div>';}
window.approveAdminRoomPurchase=async function(type,id){if(!adminCurrentRoom)return;try{if(!(await askConfirm('This will approve the pending purchase and credit the Room member.','Approve purchase?')))return;const fn=type==='credit'?'admin_room_approve_credit_purchase':'admin_room_approve_energy_purchase';const r=await db.rpc(fn,{p_room_id:adminCurrentRoom,p_purchase_id:id});if(r.error)throw r.error;toast('Purchase approved and reward sent.','success','Purchase fulfilled');await loadAdminRoom();}catch(e){notifyError(e)}};
async function sendAdminRoomPackage(type){if(!adminCurrentRoom||!adminSelectedMember){toast('Select a Room member first.','error');return}const pkg=type==='credit'?$('adminCreditPackage').value:$('adminEnergyPackage').value;if(!pkg){toast('Choose a Store package first.','error');return}const m=adminRoomCache.balances.find(x=>x.user_id===adminSelectedMember);if(!m)return;try{if(!(await askConfirm(`Send the selected ${type==='credit'?'Credit':'Energy'} Store package to ${m.display_name||m.username}?`,'Confirm reward')))return;const fn=type==='credit'?'admin_room_grant_credit_package':'admin_room_grant_energy_package';const r=await db.rpc(fn,{p_room_id:adminCurrentRoom,p_user_id:adminSelectedMember,p_package_id:pkg,p_reason:'Room Admin Dashboard reward'});if(r.error)throw r.error;toast(`${type==='credit'?'Credits':'Energy'} package sent successfully.`,'success','Reward sent');await loadAdminRoom();}catch(e){notifyError(e)}}

function renderAdminRoomWorld(){const w=adminRoomCache.world||{},d=adminRoomCache.dash||{};$('adminRoomWorld').innerHTML=`<div class="card"><h3>🌎 World Profile</h3><div class="room-list"><div class="room-row"><span>Mood</span><strong>${esc(w.profile?.mood||'Chill')}</strong></div><div class="room-row"><span>Energy</span><strong>${Number(w.profile?.energy||0)}%</strong></div><div class="room-row"><span>Presence</span><strong>${(w.presence||[]).length}</strong></div><div class="room-row"><span>Season</span><strong>${esc(d.season?.name||'None')}</strong></div></div></div><div class="card"><h3>🏆 Progress</h3><div class="room-list"><div class="room-row"><span>Leaderboard</span><strong>${(d.leaderboard||[]).length}</strong></div><div class="room-row"><span>Quests</span><strong>${(w.quests||[]).length}</strong></div><div class="room-row"><span>Championships</span><strong>${(d.championships||[]).length}</strong></div><div class="room-row"><span>Collectibles</span><strong>${(d.collectibles||[]).length}</strong></div></div></div>`}
function renderAdminRoomEconomy(){const d=adminRoomCache.dash||{};$('adminRoomEconomy').innerHTML=`<div class="room-list"><div class="room-row"><span>Coins</span><strong>${Number(d.wallet?.coins||0).toLocaleString()}</strong></div><div class="room-row"><span>Top SP</span><strong>${Number(d.leaderboard?.[0]?.sp||0).toLocaleString()}</strong></div><div class="room-row"><span>Economy records</span><strong>${Number((d.economy||[]).length)}</strong></div></div>`}
function renderAdminRoomModeration(){const w=adminRoomCache.world||{};$('adminRoomModeration').innerHTML=`<div class="room-row"><span>Messages available for review</span><strong>${adminRoomCache.messages.length}</strong></div><div class="room-row"><span>Active members</span><strong>${(w.presence||[]).length}</strong></div><div class="room-row"><span>Events</span><strong>${(w.events||[]).length}</strong></div>`}
async function adminRoomPrompt(title,placeholder){return await askText(placeholder,title,placeholder)}
$('adminRoomSelect').onchange=async e=>{adminCurrentRoom=e.target.value;await loadAdminRoom()};$('adminRoomRefresh').onclick=loadAdminRooms;$('adminRoomChatRefresh').onclick=loadAdminRoom;$('adminRoomMemberRefresh').onclick=loadAdminRoom;$('adminRoomChatSearch').oninput=renderAdminRoomChat;$('adminRoomMemberSearch').oninput=renderAdminRoomMembers;
document.querySelectorAll('[data-room-tab]').forEach(b=>b.onclick=()=>{document.querySelectorAll('.room-tab').forEach(x=>x.classList.remove('active'));document.querySelectorAll('.room-pane').forEach(x=>x.classList.remove('active'));b.classList.add('active');$('roomPane'+b.dataset.roomTab.charAt(0).toUpperCase()+b.dataset.roomTab.slice(1)).classList.add('active')});
$('adminRoomTopicBtn').onclick=async()=>{if(!adminCurrentRoom)return;const t=await adminRoomPrompt('Set Room topic','Topic');if(!t)return;const r=await db.from('room_topics').insert({room_id:adminCurrentRoom,topic:t,is_active:true});if(r.error)toast(r.error.message,'error');else{toast('Room topic updated','success');await loadAdminRoom()}};
$('adminCreateQuest').onclick=async()=>{if(!adminCurrentRoom)return;const title=await adminRoomPrompt('Create Quest','Quest title');if(!title)return;const r=await db.rpc('admin_world_create_quest',{p_room_id:adminCurrentRoom,p_title:title,p_description:null,p_target:10,p_reward_sp:100});if(r.error)toast(r.error.message,'error');else{toast('Quest created','success');await loadAdminRoom()}};
$('adminCreateChamp').onclick=async()=>{if(!adminCurrentRoom)return;const title=await adminRoomPrompt('Create Championship','Championship title');if(!title)return;const r=await db.rpc('admin_world_create_championship',{p_room_id:adminCurrentRoom,p_title:title,p_target:100,p_reward_sp:500});if(r.error)toast(r.error.message,'error');else{toast('Championship created','success');await loadAdminRoom()}};
$('adminTriggerEvent').onclick=async()=>{if(!adminCurrentRoom)return;const title=await adminRoomPrompt('Trigger Room Event','Event title');if(!title)return;const r=await db.rpc('admin_world_trigger_event',{p_room_id:adminCurrentRoom,p_event_type:'mystery',p_title:title,p_description:null,p_duration_minutes:30});if(r.error)toast(r.error.message,'error');else{toast('Event triggered','success');await loadAdminRoom()}};
$('adminSpAdjust').onclick=async()=>{const uid=await adminRoomPrompt('SP adjustment','Target user UUID');if(!uid)return;const amount=await adminRoomPrompt('SP amount','Positive or negative amount');if(!amount)return;const r=await db.rpc('admin_sp_adjust',{p_user_id:uid,p_amount:Number(amount),p_reason:'Room Admin Dashboard adjustment'});if(r.error)toast(r.error.message,'error');else toast('SP adjusted','success')};
$('adminCreditAdjust').onclick=async()=>{const uid=await adminRoomPrompt('Credit grant','Target user UUID');if(!uid)return;const amount=await adminRoomPrompt('Credit amount','Positive amount');if(!amount)return;const r=await db.rpc('admin_grant_credits',{p_user_id:uid,p_amount:Number(amount),p_reason:'Room Admin Dashboard grant'});if(r.error)toast(r.error.message,'error');else toast('Credits granted','success')};
$('adminRoomRefreshModeration').onclick=loadAdminRoom;$('adminPurchaseRefresh').onclick=loadAdminRoom;$('adminSendCreditPackage').onclick=()=>sendAdminRoomPackage('credit');$('adminSendEnergyPackage').onclick=()=>sendAdminRoomPackage('energy');loadAdminRoomStore().catch(notifyError);loadGrantPackages().catch(notifyError);
</script>
</body>
</html>