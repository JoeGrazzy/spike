<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover" />
  <title>SPIKE Room – Full</title>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <style>
    /* ... (styles remain unchanged) ... */
    * { margin:0; padding:0; box-sizing:border-box; min-width:0; }
    html,body{width:100%;max-width:100%;min-height:100%;overflow:hidden!important;}
    img,svg,video,canvas{max-width:100%;}
    button,input,textarea,select{max-width:100%;}
    .brand,.room-header,.energy-section,.panel,.feed-item,.inbox-item,.sp-summary,.sp-card,.sp-package,.spark-topic,.message,.msg-bubble{min-width:0;max-width:100%;}
    .brand h1,.spark-topic span,.room-btn,.room-card-name,.room-card-desc,.sp-title,.sp-muted,.sp-card h4,.sp-card p,.sp-package-name,.sp-price,.profile-field .value{overflow-wrap:anywhere;word-break:break-word;}
    :root {
      --bg-primary: #0B0C10; --bg-secondary: #14161D; --bg-card: #1A1D27;
      --border-glow: #2C2F3A; --violet: #8A2BE2; --lime: #39FF14;
      --cyan: #00F0FF; --text-primary: #EDEDED; --text-muted: #8A8F9E;
      --shadow-neon: 0 0 15px rgba(138,43,226,0.3);
      --radius: 16px; --transition: all 0.25s ease;
    }
    body { font-family: 'Space Grotesk', sans-serif; background: var(--bg-primary); color: var(--text-primary); height: 100vh; display: flex; justify-content: center; align-items: center; margin: 0; overflow: hidden; }
    #app { width: 100%; max-width: 420px; height: 100vh; max-height: 820px; background: var(--bg-secondary); border-radius: 32px; border: 1px solid var(--border-glow); box-shadow: var(--shadow-neon), 0 20px 60px rgba(0,0,0,0.8); display: flex; flex-direction: column; overflow: hidden; position: relative; }
    ::-webkit-scrollbar { width: 3px; }
    ::-webkit-scrollbar-thumb { background: var(--violet); border-radius: 10px; }

    header { padding: 16px 20px 10px; background: var(--bg-secondary); border-bottom: 1px solid var(--border-glow); display: flex; justify-content: space-between; align-items: center; flex-shrink: 0; }
    .brand { display: flex; align-items: center; gap: 10px; }
    .brand h1 { font-size: 20px; font-weight: 800; background: linear-gradient(135deg, var(--violet), var(--cyan)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .brand .live-badge { font-size: 9px; font-weight: 700; background: var(--lime); color: #000; padding: 2px 8px; border-radius: 20px; text-transform: uppercase; animation: pulse-dot 1.5s infinite; -webkit-text-fill-color: #000; }
    @keyframes pulse-dot { 0% { opacity:1; } 50% { opacity:0.5; } 100% { opacity:1; } }
    .user-mini { display: flex; align-items: center; gap: 8px; background: var(--bg-card); padding: 4px 12px 4px 4px; border-radius: 40px; border: 1px solid var(--border-glow); cursor: pointer; }
    .avatar-morph { width: 32px; height: 32px; border-radius: 50%; background: linear-gradient(135deg, var(--violet), var(--cyan)); display: flex; align-items: center; justify-content: center; font-size: 18px; font-weight: 700; color: #fff; box-shadow: 0 0 12px rgba(138,43,226,0.5); transition: var(--transition); }
    .message-avatar{width:28px;height:28px;border-radius:50%;overflow:hidden;display:inline-flex;align-items:center;justify-content:center;flex:0 0 28px;background:linear-gradient(135deg,var(--violet),var(--cyan));vertical-align:middle;margin-right:6px;}
    .message-avatar img{width:100%;height:100%;object-fit:cover;display:block;}
    .message-avatar-fallback{width:100%;height:100%;align-items:center;justify-content:center;color:#fff;font-size:12px;font-weight:800;}

    .level-badge { width: 42px; height: 42px; object-fit: contain; display: block; filter: drop-shadow(0 0 10px rgba(138,43,226,0.45)); }
    .user-mini .level-text { font-size: 10px; font-weight: 800; color: var(--lime); background: rgba(57,255,20,0.15); padding: 3px 7px; border-radius: 10px; border: 1px solid rgba(57,255,20,0.3); }

    .room-header { padding: 12px 20px; background: var(--bg-card); border-bottom: 1px solid var(--border-glow); flex-shrink: 0; }
    .room-selector { display:flex; gap:8px; margin-bottom:8px; flex-wrap:wrap; width:100%; }
    .room-btn { background: transparent; border: 1px solid var(--border-glow); color: var(--text-muted); padding: 4px 14px; border-radius: 30px; font-size: 11px; font-weight: 600; cursor: pointer; transition: var(--transition); font-family: inherit; }
    .room-btn.active { background: var(--violet); color: #fff; border-color: var(--violet); box-shadow: 0 0 20px rgba(138,43,226,0.4); }
    .room-tools { display:flex; gap:8px; margin-bottom:8px; width:100%; flex-wrap:wrap; }
    .room-tool-btn { flex:1 1 120px; min-width:0; background:var(--bg-secondary); border:1px solid var(--border-glow); color:var(--text-primary); padding:8px 10px; border-radius:10px; font:600 11px inherit; cursor:pointer; }
    .room-tool-btn.primary { background:var(--violet); border-color:var(--violet); color:#fff; }
    .room-browser { display:none; position:absolute; inset:0; z-index:80; background:var(--bg-primary); flex-direction:column; }
    .room-browser.open { display:flex; }
    .browser-head { padding:16px 18px; display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid var(--border-glow); background:var(--bg-secondary); }
    .browser-head h2 { font-size:18px; }
    .browser-close { background:transparent; border:1px solid var(--border-glow); color:#fff; width:36px; height:36px; border-radius:50%; cursor:pointer; }
    .browser-body { padding:14px 16px; overflow:auto; flex:1; }
    .room-search { width:100%; background:var(--bg-card); border:1px solid var(--border-glow); color:#fff; padding:11px 14px; border-radius:12px; outline:none; margin-bottom:12px; }
    .room-card { background:var(--bg-card); border:1px solid var(--border-glow); border-radius:14px; padding:13px; margin-bottom:10px; }
    .room-card-top { display:flex; gap:10px; align-items:center; }
    .room-avatar { width:42px; height:42px; border-radius:12px; display:flex; align-items:center; justify-content:center; background:linear-gradient(135deg,var(--violet),var(--cyan)); font-weight:800; }
    .room-card-info { flex:1; min-width:0; }
    .room-card-name { font-weight:800; font-size:14px; }
    .room-card-meta { font-size:10px; color:var(--text-muted); margin-top:3px; }
    .room-card-desc { font-size:11px; color:var(--text-muted); margin:9px 0; line-height:1.4; }
    .room-card-actions { display:flex; gap:7px; }
    .room-card-actions button { flex:1; border:1px solid var(--border-glow); background:var(--bg-secondary); color:#fff; padding:8px; border-radius:9px; cursor:pointer; font:600 10px inherit; }
    .room-card-actions .join { background:var(--violet); border-color:var(--violet); }
    .create-form { background:var(--bg-card); border:1px solid var(--border-glow); border-radius:14px; padding:14px; margin-bottom:14px; }
    .create-form input,.create-form textarea { width:100%; background:var(--bg-secondary); border:1px solid var(--border-glow); color:#fff; border-radius:10px; padding:10px; margin-bottom:8px; font:inherit; outline:none; }
    .create-form textarea { min-height:70px; resize:none; }
    .create-form button { width:100%; padding:10px; border:0; border-radius:10px; background:var(--violet); color:#fff; font-weight:700; cursor:pointer; }
    .room-empty { text-align:center; color:var(--text-muted); padding:35px 15px; font-size:12px; }
    .message-menu { margin-left:auto; background:transparent; border:0; color:var(--text-muted); cursor:pointer; }

    .spark-topic { display:flex; min-width:0; align-items: center; gap: 10px; background: rgba(0,240,255,0.05); padding: 6px 12px; border-radius: 40px; border-left: 3px solid var(--cyan); }
    .spark-topic i { color: var(--cyan); font-size: 14px; }
    .spark-topic span { font-size: 13px; min-width:0; flex:1; font-weight: 400; color: var(--text-primary); }
    .spark-topic .ai-tag { font-size: 8px; font-weight: 700; color: var(--cyan); background: rgba(0,240,255,0.1); padding: 2px 6px; border-radius: 4px; margin-left: 8px; }

    .energy-section { padding:8px 16px; min-width:0; background: var(--bg-secondary); flex-shrink: 0; display: flex; align-items: center; gap: 12px; }
    .energy-label { font-size: 11px; font-weight: 700; color: var(--text-muted); display: flex; align-items: center; gap: 4px; }
    .energy-track { flex: 1; height: 6px; background: var(--bg-card); border-radius: 10px; overflow: hidden; }
    .energy-fill { height: 100%; width: 100%; background: linear-gradient(90deg, var(--lime), var(--cyan)); border-radius: 10px; transition: width 0.5s ease; }
    .energy-fill.danger { background: linear-gradient(90deg, #FF4D4D, #FF9D4D); }
    .coins-display { font-size: 13px; font-weight: 700; color: #FFD700; display: flex; align-items: center; gap: 4px; background: rgba(255,215,0,0.1); padding: 2px 10px; border-radius: 30px; border: 1px solid rgba(255,215,0,0.2); }

    .panel { display: none; flex: 1; overflow-y: auto; padding: 16px 20px; background: var(--bg-primary); flex-direction: column; gap: 12px; }
    .panel.active { display: flex; }
    #chat-panel { padding: 0; background: transparent; }
    #chat-container { flex: 1; overflow-y: auto; padding: 16px 20px; display: flex; flex-direction: column; gap: 12px; }

    .feed-item, .inbox-item { background: var(--bg-card); border: 1px solid var(--border-glow); border-radius: 12px; padding: 12px 16px; }
    .feed-item .msg-text { font-size: 14px; margin-bottom: 4px; }
    .feed-item .meta { font-size: 11px; color: var(--text-muted); display: flex; gap: 12px; }
    .inbox-item .inbox-text { font-size: 14px; }
    .inbox-item .inbox-meta { font-size: 11px; color: var(--text-muted); }

    .profile-avatar { font-size: 64px; text-align: center; margin-bottom: 12px; }
    .profile-field { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--border-glow); }
    .profile-field .label { color: var(--text-muted); }
    .profile-field .value { font-weight: 600; }
    .profile-avatar-wrap{display:flex;flex-direction:column;align-items:center;gap:10px;margin-bottom:14px;padding:14px;border:1px solid var(--border-glow);border-radius:16px;background:rgba(255,255,255,.025)}
    .profile-avatar-img{width:96px;height:96px;border-radius:50%;object-fit:cover;border:2px solid var(--violet);box-shadow:0 0 22px rgba(138,43,226,.35);background:var(--bg-card)}
    .avatar-upload-btn{background:var(--violet);border:0;color:#fff;padding:9px 13px;border-radius:10px;font:700 11px inherit;cursor:pointer}
    .avatar-upload-btn:disabled{opacity:.55;cursor:wait}

    .edit-btn { background: var(--violet); border: none; color: #fff; padding: 8px 20px; border-radius: 40px; cursor: pointer; font-weight: 600; margin-top: 12px; }

    .message { display:flex; flex-direction:column; width:auto; max-width:85%; min-width:0; animation: slide-up 0.2s ease-out; }
    @keyframes slide-up { from { opacity:0; transform:translateY(12px); } to { opacity:1; transform:translateY(0); } }
    .message.self { align-self: flex-end; align-items: flex-end; }
    .message.other { align-self: flex-start; align-items: flex-start; }
    .msg-bubble { max-width:100%; overflow-wrap:anywhere; word-break:break-word; background: var(--bg-card); padding: 10px 14px; border-radius: 14px; border-bottom-left-radius: 4px; border: 1px solid var(--border-glow); }
    .message.self .msg-bubble { max-width:100%; overflow-wrap:anywhere; word-break:break-word; background: var(--violet); border-color: var(--violet); border-bottom-right-radius: 4px; border-bottom-left-radius: 14px; }
    .msg-user { font-size: 10px; font-weight: 700; color: var(--cyan); margin-bottom: 2px; display: flex; align-items: center; gap: 6px; }
    .message.self .msg-user { color: #fff; }
    .msg-text { font-size: 14px; line-height: 1.4; word-break: break-word; }
    .msg-actions { display: flex; align-items: center; gap: 12px; margin-top: 4px; }
    .pulse-btn { background: transparent; border: none; color: var(--text-muted); font-size: 12px; cursor: pointer; display: flex; align-items: center; gap: 4px; transition: var(--transition); font-family: inherit; padding: 2px 6px; border-radius: 20px; }
    .pulse-btn:hover { color: var(--lime); }
    .pulse-btn.pulsed { color: var(--lime); }
    .msg-time { font-size: 9px; color: var(--text-muted); margin-top: 2px; }

    .input-area { padding: 12px 16px; background: var(--bg-secondary); border-top: 1px solid var(--border-glow); display: flex; gap: 10px; align-items: center; flex-shrink: 0; }
    .input-area input { flex:1 1 auto; min-width:0; width:0; background: var(--bg-card); border: 1px solid var(--border-glow); padding: 10px 16px; border-radius: 40px; color: #fff; font-family: inherit; font-size: 14px; outline: none; }
    .input-area input:focus { border-color: var(--violet); box-shadow: 0 0 15px rgba(138,43,226,0.2); }
    .input-area input::placeholder { color: var(--text-muted); }
    .input-area button { background: var(--violet); border: none; color: #fff; width: 44px; height: 44px; border-radius: 50%; font-size: 18px; cursor: pointer; transition: var(--transition); display: flex; align-items: center; justify-content: center; box-shadow: 0 0 20px rgba(138,43,226,0.3); }
    .input-area button:hover { transform: scale(1.05); background: #7A1BD6; }

    .bottom-nav { display:flex; width:100%; min-width:0; justify-content: space-around; padding: 8px 0 12px; background: var(--bg-secondary); border-top: 1px solid var(--border-glow); flex-shrink: 0; }
    .nav-item { flex:1 1 0; min-width:0; background: transparent; border: none; color: var(--text-muted); font-size: 20px; cursor: pointer; transition: var(--transition); display: flex; flex-direction: column; align-items: center; gap: 2px; padding: 4px 16px; font-family: inherit; }
    .nav-item span { font-size: 8px; font-weight: 600; letter-spacing: 0.5px; }
    .nav-item.active { color: var(--violet); }


    .sp-summary{background:linear-gradient(135deg,rgba(138,43,226,.18),rgba(0,240,255,.08));border:1px solid var(--border-glow);border-radius:16px;padding:14px}.sp-badge{width:58px;height:58px;object-fit:contain;flex:0 0 58px}.sp-head{display:flex;gap:12px;align-items:center}.sp-title{font-size:16px;font-weight:800}.sp-muted{font-size:10px;color:var(--text-muted);margin-top:3px}.sp-progress{height:8px;background:#0b0c10;border-radius:99px;overflow:hidden;margin-top:10px}.sp-progress>div{height:100%;background:linear-gradient(90deg,var(--violet),var(--cyan));border-radius:99px}.sp-card{background:var(--bg-card);border:1px solid var(--border-glow);border-radius:14px;padding:12px}.sp-card.done{opacity:.62}.sp-card h4{font-size:13px;margin-bottom:4px}.sp-card p{font-size:11px;color:var(--text-muted);line-height:1.4}.sp-card-row{display:flex;align-items:center;gap:10px}.sp-card button,.sp-store button{border:0;background:var(--violet);color:#fff;padding:8px 11px;border-radius:10px;font:700 10px inherit;cursor:pointer}.sp-card button:disabled{opacity:.45}.sp-reward{margin-left:auto;color:var(--lime);font-weight:800;font-size:11px}.sp-store{display:grid;gap:8px}.sp-package{background:var(--bg-card);border:1px solid var(--border-glow);border-radius:14px;padding:12px}.sp-package-top{display:flex;justify-content:space-between;gap:8px;align-items:center}.sp-package-name{font-weight:800}.sp-price{font-size:12px;color:var(--cyan);font-weight:800}.sp-buy{width:100%;margin-top:9px}.sp-contact{font-size:11px;line-height:1.45;color:var(--text-muted);background:rgba(0,240,255,.05);border:1px solid rgba(0,240,255,.15);padding:10px;border-radius:12px}.sp-empty{color:var(--text-muted);font-size:12px;padding:12px 0}

    .room-dialog-backdrop{position:fixed;inset:0;z-index:10000;display:flex;align-items:center;justify-content:center;padding:20px;background:rgba(3,5,10,.76);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);animation:dialog-fade .18s ease-out}
    .room-dialog{width:min(420px,calc(100vw - 28px));max-width:100%;background:linear-gradient(145deg,rgba(28,31,43,.98),rgba(12,14,21,.98));border:1px solid rgba(138,43,226,.42);border-radius:24px;box-shadow:0 24px 80px rgba(0,0,0,.62),0 0 36px rgba(138,43,226,.16);overflow:hidden}
    .room-dialog-head{display:flex;align-items:center;gap:12px;padding:18px 18px 12px}
    .room-dialog-icon{width:42px;height:42px;flex:0 0 42px;border-radius:14px;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,rgba(138,43,226,.28),rgba(0,240,255,.14));border:1px solid rgba(0,240,255,.22);color:var(--cyan);font-size:18px}
    .room-dialog-title{font-size:16px;font-weight:800;min-width:0;overflow-wrap:anywhere}
    .room-dialog-body{padding:0 18px 16px;color:var(--text-muted);font-size:12px;line-height:1.55;overflow-wrap:anywhere}
    .room-dialog-input{width:100%;min-height:44px;margin-top:12px;padding:11px 13px;border-radius:13px;border:1px solid var(--border-glow);background:#0d0f15;color:#fff;outline:none;font:inherit;resize:vertical;max-width:100%}
    .room-dialog-input:focus{border-color:var(--violet);box-shadow:0 0 0 3px rgba(138,43,226,.12)}
    .room-dialog-actions{display:flex;gap:9px;padding:0 18px 18px}
    .room-dialog-actions button{flex:1;min-width:0;min-height:44px;border-radius:13px;border:1px solid var(--border-glow);background:#171a23;color:#fff;font:700 12px inherit;cursor:pointer}
    .room-dialog-actions .primary{background:linear-gradient(135deg,var(--violet),#6d21b5);border-color:rgba(138,43,226,.7)}
    .room-dialog-actions .danger{background:linear-gradient(135deg,#9f1239,#7f1d1d);border-color:rgba(255,77,77,.45)}
    @keyframes dialog-fade{from{opacity:0}to{opacity:1}}
    @media(max-width:440px){.room-dialog-backdrop{padding:14px}.room-dialog{width:100%;border-radius:20px}.room-dialog-actions button{min-height:46px}}

    .toast { position:absolute; bottom:92px; left:50%; transform:translateX(-50%); width:min(390px,calc(100% - 28px)); max-width:calc(100% - 28px); background:linear-gradient(145deg,rgba(30,34,46,.97),rgba(13,15,22,.97)); border:1px solid rgba(57,255,20,.38); padding:12px 16px; border-radius:16px; color:#fff; font-weight:700; font-size:12px; line-height:1.35; text-align:center; box-shadow:0 14px 45px rgba(0,0,0,.45),0 0 28px rgba(57,255,20,.12); backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px); animation:toast-in .25s ease-out; z-index:9999; white-space:normal; overflow-wrap:anywhere; }
    @keyframes toast-in { from { opacity:0; transform:translateX(-50%) translateY(30px); } to { opacity:1; transform:translateX(-50%) translateY(0); } }

    @media (max-width:440px) { #app { max-height:100vh; border-radius:0; border:none; } }
  
.spike-world{margin:10px 0;padding:12px;border:1px solid var(--border-glow);border-radius:14px;background:linear-gradient(135deg,rgba(0,255,170,.06),rgba(0,180,255,.04));}
.spike-world-head{display:flex;justify-content:space-between;gap:8px;align-items:center}.spike-world-title{font-weight:900;font-size:15px}.spike-world-sub{font-size:10px;color:var(--text-muted)}
.world-energy{height:8px;background:var(--bg-secondary);border-radius:99px;overflow:hidden;margin:8px 0}.world-energy>div{height:100%;background:linear-gradient(90deg,#00ff9d,#00c8ff);transition:width .3s}
.world-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:7px;margin-top:8px}.world-card{padding:9px;border:1px solid var(--border-glow);border-radius:10px;background:rgba(0,0,0,.12)}.world-card strong{display:block;font-size:11px}.world-card span{display:block;font-size:9px;color:var(--text-muted);margin-top:3px}.world-actions{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}.world-actions button{border:1px solid var(--border-glow);background:var(--bg-card);color:#fff;border-radius:9px;padding:7px 9px;font-size:9px;font-weight:800;cursor:pointer}.world-list{margin-top:8px;display:flex;flex-direction:column;gap:5px}.world-list-item{font-size:9px;padding:7px;border-radius:8px;background:rgba(255,255,255,.03)}


.world-feature-nav{display:flex;gap:7px;padding:8px 10px;overflow-x:auto;border-bottom:1px solid var(--border-glow);background:var(--bg-secondary);scrollbar-width:none;flex-shrink:0}.world-feature-nav::-webkit-scrollbar{display:none}.world-feature-tab{flex:0 0 auto;border:1px solid var(--border-glow);background:var(--bg-card);color:var(--text-muted);border-radius:11px;padding:8px 10px;font:700 10px inherit;cursor:pointer;white-space:nowrap}.world-feature-tab.active{color:#fff;border-color:var(--violet);box-shadow:var(--shadow-neon);background:rgba(138,43,226,.16)}.world-feature-panel{display:none;flex:1;min-height:0;overflow:auto;padding:12px}.world-feature-panel.active{display:block}.feature-card{background:var(--bg-card);border:1px solid var(--border-glow);border-radius:14px;padding:12px;margin-bottom:10px}.feature-card h3{font-size:15px;margin-bottom:5px}.feature-muted{font-size:11px;color:var(--text-muted);line-height:1.45}.feature-row{display:flex;justify-content:space-between;gap:10px;align-items:center;padding:10px 0;border-bottom:1px solid rgba(255,255,255,.06);font-size:11px}.feature-row:last-child{border-bottom:0}.feature-btn{border:0;border-radius:10px;padding:8px 10px;background:linear-gradient(135deg,var(--violet),#6f18b8);color:#fff;font:700 10px inherit;cursor:pointer}.feature-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.feature-stat{background:rgba(255,255,255,.035);border:1px solid rgba(255,255,255,.06);border-radius:12px;padding:10px}.feature-stat b{display:block;font-size:17px}.feature-stat span{font-size:9px;color:var(--text-muted)}.world-feature-shell{flex-direction:column;gap:0;padding:0;min-height:0;overflow:hidden}.world-feature-shell.active{display:flex}.world-feature-empty{padding:30px 12px;text-align:center;color:var(--text-muted);font-size:11px}

.live-member-row{align-items:center;gap:10px}.live-member-main{display:flex;align-items:center;gap:10px;min-width:0}.live-member-main>span:last-child{display:flex;flex-direction:column;min-width:0}.live-member-main small{opacity:.58;font-size:10px;overflow:hidden;text-overflow:ellipsis}.member-avatar{display:inline-flex;flex:0 0 auto;width:38px;height:38px;border-radius:50%;object-fit:cover;align-items:center;justify-content:center;background:var(--bg-secondary,#151922);border:1px solid var(--border-glow,#2a3140);font-weight:800;overflow:hidden}.member-avatar img{width:100%;height:100%;object-fit:cover}.member-avatar-fallback{font-size:14px}.live-member-status{display:flex;align-items:center;gap:5px;font-size:11px;opacity:.85;text-transform:capitalize}.live-dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:#667085}.live-dot.online{background:#39d98a;box-shadow:0 0 8px rgba(57,217,138,.55)}.live-member-chip{display:flex;align-items:center;gap:5px;position:relative;font-size:10px;white-space:nowrap}.live-member-chip .member-avatar{width:34px;height:34px}.live-member-chip>span{max-width:76px;overflow:hidden;text-overflow:ellipsis}.live-member-chip .live-dot{position:absolute;right:-1px;bottom:0;border:2px solid var(--bg-primary,#090b10);width:9px;height:9px}
.uid-color{font-weight:900;letter-spacing:.4px;animation:uidHue 4s linear infinite;}@keyframes uidHue{0%{color:#ff4fa3}33%{color:#55e87a}66%{color:#ff9b35}100%{color:#ff4fa3}}.coin-store-nav{font-weight:800}.store-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px}.store-package{padding:16px;text-align:center}.store-price{font-weight:800;margin:8px 0 14px}
.cashout-requirements-toggle{width:100%;display:flex;justify-content:space-between;align-items:center;margin:10px 0 6px;padding:10px 12px;border:1px solid rgba(255,255,255,.12);border-radius:10px;background:rgba(255,255,255,.04);color:inherit;font:inherit;font-weight:700;cursor:pointer}.cashout-requirements-toggle span{transition:transform .2s ease}.cashout-requirements-toggle[aria-expanded="true"] span{transform:rotate(180deg)}
</style>
<meta name="theme-color" content="#0B0C10"><meta name="mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">

<style id="final-room-android-fit">
html,body{width:100%;max-width:100%;min-width:0;overflow:hidden!important;}
body{min-height:100dvh;height:100dvh;padding:env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);}
#app{width:100%;max-width:420px;height:100dvh;max-height:none;border-radius:0;overflow:hidden;}
@media(min-width:700px){#app{height:min(100dvh,900px);border-radius:28px;}}
@media(max-width:699px){
  #app{width:100vw;height:100dvh;max-width:none;max-height:none;border-radius:0;border-left:0;border-right:0;}
  .room-header,.energy-section,.input-area{padding-left:max(12px,env(safe-area-inset-left));padding-right:max(12px,env(safe-area-inset-right));}
  .panel{padding-left:14px;padding-right:14px;}
  #chat-container{padding-left:12px;padding-right:12px;}
  .room-dialog{width:min(420px,calc(100vw - 24px));max-height:calc(100dvh - 24px);}
  .room-dialog-body{max-height:55dvh;overflow:auto;}
}
/* Never let generated content widen the Room. */
#app *{min-width:0;}
.room-btn,.room-card,.room-card-name,.room-card-desc,.spark-topic,.message,.msg-bubble,.profile-field,.sp-card,.sp-package{max-width:100%;overflow-wrap:anywhere;word-break:break-word;}
.sp-card-row,.sp-package-top{min-width:0;flex-wrap:wrap;}
.sp-reward{margin-left:auto;}
.sp-package{cursor:pointer;transition:transform .16s ease,border-color .16s ease,box-shadow .16s ease;}
.sp-package:active{transform:scale(.99);}
.energy-store-overlay{position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;padding:16px;background:rgba(2,4,9,.78);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);}
.energy-store-card{width:min(520px,100%);max-height:min(88dvh,760px);display:flex;flex-direction:column;overflow:hidden;background:linear-gradient(145deg,rgba(25,29,42,.98),rgba(9,12,18,.99));border:1px solid rgba(0,240,255,.22);border-radius:24px;box-shadow:0 30px 100px rgba(0,0,0,.65),0 0 45px rgba(0,240,255,.08);}
.energy-store-head{display:flex;align-items:center;gap:10px;padding:16px 18px;border-bottom:1px solid rgba(255,255,255,.08);}
.energy-store-head h3{margin:0;flex:1;font-size:17px;}
.energy-store-close{width:38px;height:38px;border:1px solid rgba(255,255,255,.1);border-radius:12px;background:rgba(255,255,255,.04);color:#fff;font-size:22px;line-height:1;}
.energy-store-body{overflow:auto;padding:14px 16px 18px;}
@media(max-width:699px){.energy-store-overlay{align-items:flex-end;padding:10px;}.energy-store-card{width:100%;max-height:calc(100dvh - 20px);border-radius:22px;}.energy-store-body{padding-bottom:max(16px,env(safe-area-inset-bottom));}}
</style>

<style id="cashout-lock-css">
.cashout-lock-badge{float:right;font-size:10px;font-weight:900;padding:5px 8px;border-radius:999px;background:rgba(255,77,77,.12);border:1px solid rgba(255,77,77,.28);color:#ff8f8f}
.cashout-box.cashout-unlocked .cashout-lock-badge{background:rgba(80,220,120,.12);border-color:rgba(80,220,120,.28);color:#74ee9a}
.cashout-lock-notice{margin-top:8px;padding:10px;border-radius:10px;background:rgba(255,180,60,.07);border:1px solid rgba(255,180,60,.16);color:var(--text-muted);font-size:10px;line-height:1.45}
.cashout-requirements{display:grid;gap:6px;margin-top:10px}
.cashout-req{display:flex;align-items:center;gap:7px;padding:8px 9px;border-radius:9px;background:rgba(255,255,255,.025);font-size:10px;color:var(--text-muted)}
.cashout-req.ok{color:#7cf09c;background:rgba(80,220,120,.06)}
.cashout-req .req-state{margin-left:auto;font-weight:900;white-space:nowrap}
.cashout-gated-form input:disabled,.cashout-gated-form button:disabled{opacity:.48;cursor:not-allowed}
.cashout-box.cashout-unlocked .cashout-lock-notice{background:rgba(80,220,120,.06);border-color:rgba(80,220,120,.16)}
</style>

<style id="spike-streak-center-css">
/* Premium Daily Streak Center */
.streak-center{display:flex;flex-direction:column;gap:12px;min-width:0;max-width:100%}
.streak-hero{background:linear-gradient(145deg,rgba(138,43,226,.22),rgba(0,240,255,.08) 58%,rgba(57,255,20,.04));border:1px solid rgba(138,43,226,.35);border-radius:18px;padding:15px;box-shadow:0 12px 30px rgba(0,0,0,.22)}
.streak-hero-top{display:flex;align-items:center;gap:12px;min-width:0}
.streak-hero-badge{width:58px;height:58px;object-fit:contain;flex:0 0 58px;filter:drop-shadow(0 0 12px rgba(138,43,226,.45))}
.streak-hero-title{font-size:18px;font-weight:800;overflow-wrap:anywhere}
.streak-hero-sub{font-size:10px;color:var(--text-muted);margin-top:3px;overflow-wrap:anywhere}
.streak-metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px;margin-top:12px}
.streak-metric{background:rgba(11,12,16,.52);border:1px solid var(--border-glow);border-radius:12px;padding:9px;min-width:0}
.streak-metric strong{display:block;font-size:16px;line-height:1.1;overflow-wrap:anywhere}
.streak-metric span{display:block;color:var(--text-muted);font-size:9px;margin-top:4px}
.streak-progress-wrap{margin-top:12px}
.streak-progress-head{display:flex;justify-content:space-between;gap:8px;font-size:10px;color:var(--text-muted)}
.streak-progress{height:9px;background:#090a0e;border-radius:99px;overflow:hidden;border:1px solid rgba(255,255,255,.04);margin-top:6px}
.streak-progress>div{height:100%;background:linear-gradient(90deg,var(--violet),var(--cyan),var(--lime));border-radius:99px;transition:width .35s ease}
.streak-clock{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-top:10px;font-size:10px;color:var(--text-muted)}
.streak-clock strong{color:var(--cyan)}
.streak-section-title{font-size:14px;font-weight:800;margin-top:2px}
.streak-section-sub{font-size:10px;color:var(--text-muted);line-height:1.4}
.streak-list{display:flex;flex-direction:column;gap:9px}
.streak-card{background:var(--bg-card);border:1px solid var(--border-glow);border-radius:15px;padding:12px;min-width:0}
.streak-card.complete{border-color:rgba(57,255,20,.25);background:linear-gradient(145deg,rgba(57,255,20,.06),var(--bg-card))}
.streak-card-top{display:flex;align-items:flex-start;gap:10px;min-width:0}
.streak-slot{width:32px;height:32px;border-radius:10px;display:flex;align-items:center;justify-content:center;background:rgba(138,43,226,.14);border:1px solid rgba(138,43,226,.28);font-weight:800;font-size:11px;flex:0 0 32px}
.streak-card.complete .streak-slot{background:rgba(57,255,20,.12);border-color:rgba(57,255,20,.3);color:var(--lime)}
.streak-info{flex:1;min-width:0}
.streak-info h4{font-size:13px;font-weight:800;overflow-wrap:anywhere}
.streak-info p{font-size:10px;line-height:1.45;color:var(--text-muted);margin-top:3px;overflow-wrap:anywhere}
.streak-reward{color:var(--lime);font-size:10px;font-weight:800;white-space:nowrap}
.streak-status{display:flex;justify-content:space-between;gap:8px;align-items:center;flex-wrap:wrap;margin-top:9px;padding-top:8px;border-top:1px solid rgba(255,255,255,.06)}
.streak-status-time{font-size:9px;color:var(--text-muted)}
.streak-action{border:0;background:linear-gradient(135deg,var(--violet),#6f18b8);color:#fff;padding:8px 12px;border-radius:10px;font:700 10px inherit;cursor:pointer;min-height:36px}
.streak-action:disabled{opacity:.5;cursor:default}
.streak-footer{background:rgba(0,240,255,.045);border:1px solid rgba(0,240,255,.12);border-radius:13px;padding:10px;font-size:10px;line-height:1.45;color:var(--text-muted)}
@media(max-width:380px){.streak-metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.streak-hero{padding:12px}.streak-hero-badge{width:50px;height:50px;flex-basis:50px}}
</style>


<style id="special-streak-ui-css">
.special-event-box{margin-top:8px;padding:9px;border:1px solid rgba(0,240,255,.16);border-radius:10px;background:rgba(0,240,255,.035)}
.special-event-box button{border:0;border-radius:9px;padding:7px 10px;background:linear-gradient(135deg,var(--violet),#6f18b8);color:#fff;font:700 10px inherit;cursor:pointer;margin-top:6px}
.special-event-box button:disabled{opacity:.55;cursor:default}
.special-event-meta{font-size:9px;color:var(--text-muted);line-height:1.35}
</style>

<style>
.spike-world-extra{margin-top:10px;display:grid;gap:8px}.world-toolbar{display:flex;gap:6px;flex-wrap:wrap}.world-toolbar button{border:1px solid var(--border-glow);background:rgba(255,255,255,.04);color:var(--text-primary);border-radius:9px;padding:7px 9px;font-size:10px;cursor:pointer}.world-section{border-top:1px solid var(--border-glow);padding-top:9px}.world-section h4{margin:0 0 7px;font-size:11px}.world-row{display:flex;justify-content:space-between;gap:8px;padding:6px 0;font-size:10px}.world-pill{display:inline-flex;padding:3px 6px;border-radius:999px;background:rgba(0,255,170,.08);font-size:9px}.world-map-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px}.world-map-card{padding:8px;border:1px solid var(--border-glow);border-radius:9px;background:rgba(0,0,0,.12)}
</style>

<style id="preview-panel-close-css">
.preview-panel-head{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 0 6px;flex:0 0 auto}
.preview-panel-head .preview-panel-title{font-size:14px;font-weight:800;color:var(--text-primary,#fff)}
.preview-panel-close{width:34px;height:34px;flex:0 0 34px;border:1px solid var(--border-glow,#2c2f3a);border-radius:10px;background:var(--bg-card,#1a1d27);color:#fff;font-size:19px;line-height:1;cursor:pointer;display:inline-flex;align-items:center;justify-content:center}
.preview-panel-close:active{transform:scale(.96)}
.world-feature-panel .preview-panel-head{padding:0 0 9px}
.world-feature-panel .preview-panel-close{margin-left:auto}
</style>


<style id="room-gifts-css">
.gift-message-btn{border:0;background:transparent;color:inherit;cursor:pointer;padding:4px 6px;border-radius:8px}
.gift-message-btn:hover{background:rgba(255,255,255,.08)}
.gift-panel{display:none;position:fixed;inset:0;z-index:9999}
.gift-panel.open{display:block}
.gift-panel-backdrop{position:absolute;inset:0;background:rgba(0,0,0,.7)}
.gift-panel-card{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:min(720px,94vw);max-height:86vh;overflow:auto;border:1px solid rgba(255,255,255,.14);border-radius:18px;background:var(--bg-card,#171a22);padding:16px;box-shadow:0 20px 70px rgba(0,0,0,.45)}
.gift-panel-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px}
.gift-panel-head h3{margin:0}.gift-recipient{font-size:12px;color:var(--text-muted,#9aa0ad);margin-top:3px}
.gift-close{width:36px;height:36px;border:1px solid rgba(255,255,255,.15);border-radius:10px;background:rgba(255,255,255,.06);color:#fff;font-size:22px;cursor:pointer}
.gift-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.gift-card{border:1px solid rgba(255,255,255,.1);border-radius:14px;padding:12px;background:rgba(255,255,255,.035);cursor:pointer;text-align:left;color:inherit}
.gift-card:hover{background:rgba(255,255,255,.07);transform:translateY(-1px)}
.gift-card img{width:64px;height:64px;object-fit:contain;display:block;margin:auto auto 8px}
.gift-card-name{font-weight:800;text-align:center}.gift-card-price{font-size:12px;color:#f6c84c;text-align:center;margin-top:4px}
.gift-balance{text-align:right;font-size:12px;color:var(--text-muted,#9aa0ad);margin-bottom:10px}
.gift-empty{text-align:center;padding:24px;color:var(--text-muted,#9aa0ad)}
@media(max-width:520px){.gift-grid{grid-template-columns:1fr 1fr}.gift-panel-card{padding:12px}}
<style id="cashout-room-css">
.cashout-box{margin-top:14px;padding:14px;border:1px solid var(--border-glow);border-radius:15px;background:rgba(255,255,255,.025)}
.cashout-box h4{margin:0 0 8px;font-size:13px}.cashout-form{display:grid;gap:8px}.cashout-form input{width:100%;box-sizing:border-box;padding:10px;border:1px solid var(--border-glow);border-radius:10px;background:var(--bg-secondary);color:var(--text-primary)}.cashout-form button{border:0;border-radius:10px;padding:10px;background:linear-gradient(135deg,var(--violet),#6f18b8);color:#fff;font-weight:800;cursor:pointer}.cashout-note{font-size:9px;color:var(--text-muted);line-height:1.4}.cashout-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}@media(max-width:430px){.cashout-grid{grid-template-columns:1fr}}
.streak-expiry{font-size:11px;color:var(--cyan);font-weight:800}.streak-challenge{margin-top:12px;padding:13px;border:1px solid rgba(138,43,226,.35);border-radius:14px;background:rgba(138,43,226,.08)}
</style>
</style>
</head>
<body>

<div id="app">
  <!-- HEADER -->
  <header>
    <div class="brand"><h1>⚡ SPIKE Room</h1><span class="live-badge">● Live</span></div>
    <div class="user-mini" id="headerProfileBtn" title="Your SPIKE level">
      <img class="level-badge" id="levelBadge" src="assets/levels/01-freshman.png" alt="Level 1 badge">
      <span class="level-text" id="levelText">Lv.1</span>
    </div>
  </header>

  <!-- ROOM SELECTOR + SPARK -->
  <div class="room-header" id="roomHeader">
    <div class="room-tools">
      <button class="room-tool-btn primary" id="browseRoomsBtn"><i class="fas fa-compass"></i> Browse rooms</button>
      <button class="room-tool-btn" id="createRoomBtn"><i class="fas fa-plus"></i> Create room</button>
    </div>
    <div class="room-selector" id="roomSelector"></div>
    <div class="spark-topic">
      <i class="fas fa-bolt"></i>
      <span id="sparkTopic">"Is cereal a soup?"</span>
      <span class="ai-tag">AI SPARK</span>
    </div>
  </div>


  <div class="room-browser" id="roomBrowser">
    <div class="browser-head"><h2>⚡ Public Rooms</h2><button class="browser-close" id="closeBrowser"><i class="fas fa-times"></i></button></div>
    <div class="browser-body">
      <div id="createRoomForm" class="create-form" style="display:none">
        <input id="newRoomName" maxlength="80" placeholder="Room name" />
        <textarea id="newRoomDescription" maxlength="300" placeholder="What is this room about?"></textarea>
        <input id="newRoomTopic" maxlength="160" placeholder="Opening topic (optional)" />
        <button id="submitCreateRoom">Create public room</button>
      </div>
      <input id="roomSearch" class="room-search" placeholder="Search public rooms..." />
      <div id="roomDirectory"></div>
    </div>
  </div>

  <!-- ENERGY + COINS -->
  <div class="energy-section" id="energySection">
    <div class="energy-label"><i class="fas fa-bolt" style="color:var(--lime);"></i> <span id="energyText">100</span></div>
    <div class="energy-track"><div class="energy-fill" id="energyFill" style="width:100%;"></div></div>
    <button id="buyEnergyBtn" style="border:1px solid var(--border-glow);background:var(--bg-card);color:#fff;border-radius:9px;padding:5px 8px;font-size:10px;font-weight:700;cursor:pointer;">⚡ Charge</button>
    <div class="coins-display"><i class="fas fa-coins"></i> <span id="coinText">0</span></div><div class="coins-display" title="XP"><b style="color:var(--cyan)">XP</b> <span id="spText">0</span></div>
  </div>

  <!-- CONTENT PANELS -->
  <div class="panel active" id="chat-panel">
    <div id="chat-container"></div>
  </div>

  <div class="panel" id="feed-panel">
    <div id="feed-preview-spacer"></div><h3 style="margin-bottom:8px;">🔥 Top Pulsed Messages</h3>
    <div id="feed-container"></div>
  </div>

  <div class="panel" id="inbox-panel">
    <h3 style="margin-bottom:8px;">📬 Notifications</h3>
    <div id="inbox-container"></div>
  </div>

  <div class="panel" id="profile-panel">
    <input type="file" id="avatarFile" accept="image/jpeg,image/png,image/webp,image/gif" hidden>
    <div id="profile-container"></div>
  </div>

  <div class="panel" id="sp-panel" aria-label="Daily Streak Center">
    <div id="sp-container"></div>
  </div>


  <div id="spike-world" aria-hidden="true" style="display:none"></div>

  <div class="panel world-feature-shell" id="worldFeatureShell" aria-label="SPIKE World" aria-hidden="true">
    <div class="world-feature-nav" id="worldFeatureNav">
      <button class="world-feature-tab active" data-feature="world">🌎 World</button>
      <button class="world-feature-tab" data-feature="energy">⚡ Energy</button>
      <button class="world-feature-tab" data-feature="leaderboard">🏆 Leaderboard</button>
      <button class="world-feature-tab" data-feature="roles">👑 Roles</button>
      <button class="world-feature-tab" data-feature="map">🗺️ Map</button>
      <button class="world-feature-tab" data-feature="evolution">🧬 Evolution</button>
      <button class="world-feature-tab" data-feature="championships">🏆 Championships</button>
      <button class="world-feature-tab" data-feature="events">🎲 Events</button>
      <button class="world-feature-tab" data-feature="economy">🪙 Economy</button>
      <button class="world-feature-tab" data-feature="collection">🎒 Collection</button>
      <button class="world-feature-tab" data-feature="moments">✨ Moments</button>
      <button class="world-feature-tab" data-feature="quests">🤝 Quests</button>
      <button class="world-feature-tab" data-feature="members">👥 Members</button>
    </div>
    <div id="feature-world" class="world-feature-panel active"></div>
    <div id="feature-energy" class="world-feature-panel"></div>
    <div id="feature-leaderboard" class="world-feature-panel"></div>
    <div id="feature-roles" class="world-feature-panel"></div>
    <div id="feature-map" class="world-feature-panel"></div>
    <div id="feature-evolution" class="world-feature-panel"></div>
    <div id="feature-championships" class="world-feature-panel"></div>
    <div id="feature-events" class="world-feature-panel"></div>
    <div id="feature-economy" class="world-feature-panel"></div>
    <div id="feature-collection" class="world-feature-panel"></div>
    <div id="feature-moments" class="world-feature-panel"></div>
    <div id="feature-quests" class="world-feature-panel"></div>
    <div id="feature-members" class="world-feature-panel"></div>
  </div>

  <div class="panel" id="store-panel" aria-label="Credit Store">
    <div id="credit-store-panel" style="height:100%;overflow:auto;padding:12px"></div>
  </div>

  <!-- INPUT -->
  <div class="input-area" id="inputArea">
    <input type="text" id="msgInput" placeholder="Type your vibe..." maxlength="140" />
