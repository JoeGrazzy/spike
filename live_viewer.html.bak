<!doctype html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>SPIKE Live Viewer</title>
<style>
:root{--bg:#070b14;--card:#111827;--text:#f8fafc;--muted:#94a3b8;--line:#243044;--pink:#ec4899}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:system-ui,-apple-system,Segoe UI,sans-serif}
.wrap{width:min(980px,100%);margin:auto;padding:12px}.video{position:relative;background:#000;border-radius:16px;overflow:hidden;aspect-ratio:16/9;display:grid;place-items:center}
video{width:100%;height:100%;object-fit:contain}.overlay{position:absolute;left:10px;top:10px;background:#0009;padding:6px 9px;border-radius:9px;font-size:12px}
.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:12px;margin-top:10px}
.row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.btn{border:1px solid var(--line);background:#182235;color:var(--text);border-radius:10px;padding:9px 12px;font-weight:700}.btn.primary{background:linear-gradient(135deg,#ec4899,#f97316);border:0}.status{color:var(--muted);font-size:13px}
</style></head><body><main class="wrap">
<div class="video"><video id="remote" autoplay playsinline controls></video><div class="overlay" id="status">Connecting…</div></div>
<div class="card"><div class="row"><button class="btn primary" id="connect">▶ Connect</button><button class="btn" id="reconnect">🔄 Reconnect</button><span class="status" id="info"></span></div></div>
</main>
<script type="module">
import {createClient} from "https://esm.sh/@supabase/supabase-js@2.57.0";
const SUPABASE_URL="https://bkrrewagsbjqgmxaaqyt.supabase.co";
const SUPABASE_KEY="sb_publishable_24Z2PQpdG13cf6_9w8C7nA_zXEzr60O";
const supabase=createClient(SUPABASE_URL,SUPABASE_KEY,{auth:{persistSession:true,autoRefreshToken:true,detectSessionInUrl:true}});
const $=id=>document.getElementById(id);
const sessionId=new URLSearchParams(location.search).get("session");
const rtcConfig={iceServers:[{urls:"stun:stun.l.google.com:19302"},{urls:"stun:stun.cloudflare.com:3478"}]};
let user=null,channel=null,pc=null;
function status(s){$("status").textContent=s;$("info").textContent=s}
async function connect(){
  if(!sessionId){status("Missing live session link");return}
  const {data:{session}}=await supabase.auth.getSession();
  if(!session?.user){status("Sign in to watch this live");return}
  user=session.user;
  const {data:live,error}=await supabase.from("feed_live_sessions").select("id,status,title").eq("id",sessionId).maybeSingle();
  if(error||!live){status("Live session not found");return}
  if(live.status!=="live"){status("This live has ended");return}
  if(channel)await supabase.removeChannel(channel);
  channel=supabase.channel(`live-video:${sessionId}`,{config:{broadcast:{ack:true}}});
  channel.on("broadcast",{event:"signal"},async({payload})=>{
    if(!payload||payload.to!==user.id||payload.from===user.id)return;
    if(payload.type==="offer"){
      if(pc)pc.close();
      pc=new RTCPeerConnection(rtcConfig);
      pc.ontrack=e=>{$("remote").srcObject=e.streams[0];status("🔴 Live now")};
      pc.onicecandidate=e=>{if(e.candidate)send({type:"ice",from:user.id,to:payload.from,data:e.candidate,session_id:sessionId})};
      pc.onconnectionstatechange=()=>{if(["failed","disconnected"].includes(pc.connectionState))status("Connection interrupted — reconnecting…")};
      await pc.setRemoteDescription(payload.data);
      const answer=await pc.createAnswer();await pc.setLocalDescription(answer);
      await send({type:"answer",from:user.id,to:payload.from,data:pc.localDescription,session_id:sessionId});
    }else if(payload.type==="ice"&&pc&&payload.data){await pc.addIceCandidate(payload.data).catch(()=>{})}
  });
  await channel.subscribe();
  await send({type:"viewer-join",from:user.id,to:null,data:null,session_id:sessionId});
  status("Waiting for video…");
}
async function send(payload){if(channel)await channel.send({type:"broadcast",event:"signal",payload})}
async function disconnect(){
  if(channel){try{await channel.send({type:"broadcast",event:"signal",payload:{type:"viewer-leave",from:user?.id,to:null,session_id:sessionId}})}catch{};await supabase.removeChannel(channel)}
  channel=null;if(pc){pc.close();pc=null} $("remote").srcObject=null;
}
$("connect").onclick=connect;$("reconnect").onclick=async()=>{await disconnect();await connect()};
window.addEventListener("beforeunload",()=>{try{pc?.close()}catch{}});
connect();
</script></body></html>