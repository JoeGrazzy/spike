$("cancelLink").onclick=()=>$("linkOverlay").classList.remove("open");
$("cancelStory").onclick=()=>$("storyOverlay").classList.remove("open");$("publishStory").onclick=()=>publishStory().catch(e=>toast(e.message||"Could not publish story"));$("storyInput").onchange=e=>storyFile=e.target.files?.[0]||null;$("storyAudioBtn").onclick=()=>$("storyAudioInput").click();$("storyAudioInput").onchange=e=>{storyAudioFile=e.target.files?.[0]||null;if(storyAudioFile)toast(`MP3 selected: ${storyAudioFile.name}`)};
