// ─── Feed v2 integration ─────────────────────────────────────────────
const FEED_V2_FN = `${SUPABASE_URL}/functions/v1/feed-v2-engine`;
async function feedV2Call(action, body={}){
 const {data:{session}}=await supabase.auth.getSession();
 const res=await fetch(FEED_V2_FN,{method:'POST',headers:{Authorization:`Bearer ${session?.access_token||''}`,apikey:SUPABASE_KEY,'Content-Type':'application/json'},body:JSON.stringify({action,...body})});
 const out=await res.json().catch(()=>({})); if(!res.ok) throw new Error(out.error||'Feed service error'); return out;
}
async function feedV2Event(postId,eventType,extra={}){
 if(!postId||!uid())return;
 try{await supabase.from('feed_engagement_events').insert({post_id:postId,actor_id:uid(),event_type:eventType,metadata:extra,session_id:window.__feedSessionId||crypto.randomUUID(),created_at:now()});}catch(e){console.warn('feed event',e.message)}
}
async function loadFeedV2Trending(){
 const {data,error}=await supabase.from('feed_trending_items').select('*').eq('window_minutes',60).order('rank',{ascending:true}).limit(20); if(error)throw error;
 $('v2TrendingList').innerHTML=(data||[]).map(x=>`<div class="feed-v2-item"><b>🔥 ${esc(x.item_key)}</b><p>${esc(x.item_type)} · score ${Number(x.score||0).toFixed(2)} · velocity ${Number(x.velocity||0).toFixed(2)}</p></div>`).join('')||'<div class="empty">No trending items yet.</div>';
}
async function loadFeedV2Reels(){
 const {data,error}=await supabase.from('feed_reels').select('*').eq('status','published').order('created_at',{ascending:false}).limit(20); if(error)throw error;
 $('v2ReelsList').innerHTML=(data||[]).map(x=>`<div class="feed-v2-item"><b>🎬 ${esc(x.audio_title||'Short video')}</b><p>${esc(x.caption||'')}</p><div class="feed-v2-actions"><button data-open-reel="${esc(x.id)}">Watch Reel</button></div></div>`).join('')||'<div class="empty">No reels yet.</div>';
 document.querySelectorAll('[data-open-reel]').forEach(b=>b.onclick=()=>openReel(b.dataset.openReel,data||[]));
}
function openReel(id,list){
 const ordered=[...list]; const idx=ordered.findIndex(x=>x.id===id); if(idx>0){const head=ordered.splice(idx);ordered.unshift(...head)}
 $('v2ReelsFullList').innerHTML=ordered.map(x=>`<article class="reel-item"><video src="${esc(x.video_url)}" controls autoplay playsinline loop></video><div class="reel-caption"><b>🎬 ${esc(x.audio_title||'SPIKE Reel')}</b><br>${esc(x.caption||'')}</div><div class="reel-actions"><button data-reel-like="${esc(x.post_id)}">❤️</button><button data-reel-share="${esc(x.post_id)}">🔗</button><button data-reel-remix="${esc(x.id)}">♻️</button></div></article>`).join('');
 $('v2ReelsShell').classList.add('open');
 document.querySelectorAll('#v2ReelsFullList video').forEach(v=>v.addEventListener('play',()=>feedV2Event(v.closest('.reel-item')?.querySelector('[data-reel-like]')?.dataset.reelLike,'view')));
}
async function loadFeedV2Nearby(){
 const {data,error}=await supabase.from('feed_nearby_posts').select('*').eq('discoverable',true).or(`expires_at.is.null,expires_at.gt.${now()}`).order('created_at',{ascending:false}).limit(20); if(error)throw error;
 $('v2NearbyList').innerHTML=(data||[]).map(x=>`<div class="feed-v2-item"><b>📍 ${esc(x.location_label||x.area_code)}</b><p>Post ${esc(x.post_id)} · ${ago(x.created_at)}</p><div class="feed-v2-actions"><button data-near-post="${esc(x.post_id)}">Open in Feed</button></div></div>`).join('')||'<div class="empty">No nearby posts available.</div>';
 document.querySelectorAll('[data-near-post]').forEach(b=>b.onclick=()=>{filter='latest';document.querySelector('[data-filter="latest"]')?.click();document.querySelector(`[data-post="${CSS.escape(b.dataset.nearPost)}"]`)?.scrollIntoView({behavior:'smooth'});});
}

async function loadFeedV2Analytics(){
 const out=await feedV2Call('creator_stats',{limit:100}); const rows=out.data||[];
 const totals=rows.reduce((a,r)=>{for(const k of ['impressions','views','likes','comments','shares','saves','reposts','followers_gained','watch_seconds','completed_views'])a[k]+=Number(r[k]||0);return a},{impressions:0,views:0,likes:0,comments:0,shares:0,saves:0,reposts:0,followers_gained:0,watch_seconds:0,completed_views:0});
 $('v2StatsGrid').innerHTML=Object.entries({Views:totals.views,Impressions:totals.impressions,Likes:totals.likes,Comments:totals.comments,Shares:totals.shares,Saves:totals.saves,'Watch seconds':Math.round(totals.watch_seconds),'Completed':totals.completed_views}).map(([k,v])=>`<div class="feed-v2-stat"><b>${Number(v).toLocaleString()}</b><span>${k}</span></div>`).join('');
}
async function loadFeedV2Gamify(){
 const {data:g}=await supabase.from('feed_gamification_profiles').select('*').eq('user_id',uid()).maybeSingle(); const {data:b}=await supabase.from('feed_user_badges').select('*,feed_badges(name,description,icon)').eq('user_id',uid());
 $('v2GamifyGrid').innerHTML=`<div class="feed-v2-stat"><b>${Number(g?.xp||0).toLocaleString()}</b><span>XP</span></div><div class="feed-v2-stat"><b>${g?.level||1}</b><span>Level</span></div><div class="feed-v2-stat"><b>${g?.current_streak||0}</b><span>Current streak</span></div><div class="feed-v2-stat"><b>${g?.longest_streak||0}</b><span>Longest streak</span></div>`;
 $('v2BadgeList').innerHTML=(b||[]).map(x=>`<div class="feed-v2-item"><b>${esc(x.feed_badges?.icon||'🏅')} ${esc(x.feed_badges?.name||x.badge_key)}</b><p>${esc(x.feed_badges?.description||'')}</p></div>`).join('')||'<div class="empty">Earn your first badge.</div>';
}
async function loadFeedV2Safety(){
 const {data}=await supabase.from('feed_user_controls').select('*').eq('user_id',uid()).maybeSingle(); if(!data)return;
 $('v2Sensitive').checked=data.show_sensitive;$('v2Spoilers').checked=data.show_spoilers;$('v2Political').checked=data.show_political;$('v2FollowingOnly').checked=data.following_only;$('v2MutedKeywords').value=(data.muted_keywords||[]).join(', ');
}
async function saveFeedV2Safety(){
 const row={user_id:uid(),show_sensitive:$('v2Sensitive').checked,show_spoilers:$('v2Spoilers').checked,show_political:$('v2Political').checked,following_only:$('v2FollowingOnly').checked,muted_keywords:$('v2MutedKeywords').value.split(',').map(x=>x.trim()).filter(Boolean),updated_at:now()}; const {error}=await supabase.from('feed_user_controls').upsert(row,{onConflict:'user_id'});if(error)throw error;toast('Feed controls saved');
}
async function runFeedV2AI(operation){
 const text=$('v2AiInput').value.trim();
 if(!text){toast('Write something first');return}
 const words=text.split(/\\s+/).filter(Boolean);
 let result=text.trim();
 if(operation==='rewrite'){
   result=text.trim().replace(/\\s+/g,' ');
   result=result.charAt(0).toUpperCase()+result.slice(1);
   if(!/[.!?]$/.test(result)) result+='.';
 }else if(operation==='caption'){
   result=text.trim().replace(/\\s+/g,' ');
   if(!/[.!?]$/.test(result)) result+='.';
 }else if(operation==='hashtags'){
   const tags=[...new Set(words.map(w=>w.replace(/[^A-Za-z0-9_]/g,'')).filter(w=>w.length>=4).slice(0,8))];
   result=tags.length?tags.map(w=>'#'+w.toLowerCase()).join(' '):'#SPIKE';
 }else if(operation==='summarize'){
   result=words.slice(0,30).join(' ');
   if(words.length>30) result+='…';
 }else{
   result=text.trim();
 }
 const {data,error}=await supabase.from('feed_ai_post_drafts').insert({
   user_id:uid(),source_text:text,operation,status:'completed',
   result_text:result,provider:'local',model:'deterministic-fallback',completed_at:now()
 }).select().single();
 if(error)throw error;
 $('v2AiResult').innerHTML=`<div class="ai-result"><b>${esc(operation)}</b><br>${esc(result)}<small style="display:block;margin-top:8px;opacity:.7">Draft ${esc(data.id)} saved.</small></div>`;
 toast('Draft generated');
}
async function loadFeedV2Personalized(){
 try{const out=await feedV2Call('personalize',{limit:50}); const ids=(out.data||[]).map(x=>x.post_id); if(ids.length){const rank=new Map((out.data||[]).map(x=>[x.post_id,x.final_score]));posts.sort((a,b)=>(rank.get(b.id)||-999)-(rank.get(a.id)||-999));render();$('v2PersonalStatus').textContent=`Personalized feed · ${ids.length} ranked posts`;}}
 catch(e){console.warn('personalized feed',e.message)}
}
async function initFeedV2(){
 window.__feedSessionId=crypto.randomUUID();
 document.querySelectorAll('[data-v2]').forEach(btn=>btn.onclick=async()=>{document.querySelectorAll('[data-v2]').forEach(x=>x.classList.toggle('active',x===btn));document.querySelectorAll('[data-v2-panel]').forEach(x=>x.classList.toggle('open',x.dataset.v2Panel===btn.dataset.v2));const key=btn.dataset.v2;try{if(key==='trending')await loadFeedV2Trending();if(key==='reels')await loadFeedV2Reels();if(key==='nearby')await loadFeedV2Nearby();if(key==='analytics')await loadFeedV2Analytics();if(key==='gamify')await loadFeedV2Gamify();if(key==='safety')await loadFeedV2Safety();}catch(e){toast(e.message||'Could not load feature')}});
 $('v2ReelsClose').onclick=()=>$('v2ReelsShell').classList.remove('open');
 $('v2NearbyEnable').onclick=async()=>{try{if(!navigator.geolocation)throw new Error('Location is not supported');navigator.geolocation.getCurrentPosition(async pos=>{const lat=Math.round(pos.coords.latitude*100)/100,lon=Math.round(pos.coords.longitude*100)/100;const area=`${lat.toFixed(2)},${lon.toFixed(2)}`;const {data,error}=await supabase.from('feed_nearby_posts').select('*').eq('area_code',area).eq('discoverable',true).limit(50);if(error)throw error;$('v2NearbyList').innerHTML=(data||[]).map(x=>`<div class=\"feed-v2-item\"><b>📍 ${esc(x.location_label||x.area_code)}</b><p>${esc(x.post_id)}</p></div>`).join('')||'<div class=\"empty\">No nearby posts yet.</div>';},err=>toast(err.message||'Location permission denied'),{enableHighAccuracy:false,maximumAge:300000,timeout:8000});}catch(e){toast(e.message)}};
 $('v2SaveSafety').onclick=()=>saveFeedV2Safety().catch(e=>toast(e.message));
 document.querySelectorAll('[data-ai-op]').forEach(b=>b.onclick=()=>runFeedV2AI(b.dataset.aiOp).catch(e=>toast(e.message)));
 await loadFeedV2Safety(); await loadFeedV2Personalized();
}


// ─── Feed v2 interaction completion ────────────────────────────────
async function feedV2ReelAction(action, reel){
  if(!reel) return;
  if(action==='like'){
    await feedV2Event(reel.post_id,'like',{source:'reel'});
    toast('Reel liked');
  } else if(action==='share'){
    const url=location.origin+location.pathname+'?reel='+encodeURIComponent(reel.id);
    try{if(navigator.share) await navigator.share({title:reel.caption||'SPIKE Reel',url}); else await navigator.clipboard.writeText(url); toast(navigator.share?'':'Reel link copied');}
    catch(e){if(e.name!=='AbortError')toast('Could not share reel')}
    await feedV2Event(reel.post_id,'share',{source:'reel'});
  } else if(action==='remix'){
    if(!reel.allow_remix){toast('Remix is disabled for this Reel');return;}
    $('v2AiInput').value=`Remix this Reel: ${reel.caption||''}`;
    document.querySelector('[data-v2="ai"]')?.click();
    toast('Remix draft opened');
    await feedV2Event(reel.post_id,'open',{source:'remix'});
  }
}

function bindFeedV2ReelInteractions(list){
  document.querySelectorAll('[data-reel-like],[data-reel-share],[data-reel-remix]').forEach(btn=>{
    btn.onclick=()=>{
      const id=btn.dataset.reelLike||btn.dataset.reelShare||btn.dataset.reelRemix;
      const reel=list.find(x=>(x.post_id===id||x.id===id));
      return feedV2ReelAction(btn.dataset.reelLike?'like':btn.dataset.reelShare?'share':'remix',reel).catch(e=>toast(e.message||'Action failed'));
    };
  });
}








async function publishFeedV2AIResult(operation){
  await runFeedV2AI(operation);
}
// Replace the lightweight Reel loader with interaction-aware binding.
const _loadFeedV2Reels=loadFeedV2Reels;
loadFeedV2Reels=async function(){
  const {data,error}=await supabase.from('feed_reels').select('*').eq('status','published').order('created_at',{ascending:false}).limit(50);
  if(error)throw error;
  $('v2ReelsList').innerHTML=(data||[]).map(x=>`<div class="feed-v2-item"><b>🎬 ${esc(x.audio_title||'Short video')}</b><p>${esc(x.caption||'')}</p><div class="feed-v2-actions"><button data-open-reel="${esc(x.id)}">Watch Reel</button></div></div>`).join('')||'<div class="empty">No reels yet.</div>';
  document.querySelectorAll('[data-open-reel]').forEach(b=>b.onclick=()=>openReel(b.dataset.openReel,data||[]));
  return data||[];
};

const _openReel=openReel;
openReel=function(id,list){
  _openReel(id,list);
  bindFeedV2ReelInteractions(list);
  const videos=[...document.querySelectorAll('#v2ReelsFullList video')];
  const io=new IntersectionObserver(entries=>entries.forEach(e=>{
    if(e.isIntersecting)e.target.play().catch(()=>{}); else e.target.pause();
  }),{root:$('v2ReelsFullList'),threshold:.65});
  videos.forEach(v=>io.observe(v));
  document.querySelectorAll('#v2ReelsFullList .reel-item').forEach(item=>{
    const vid=item.querySelector('video');
    vid?.addEventListener('ended',()=>feedV2Event(item.querySelector('[data-reel-like]')?.dataset.reelLike,'complete',{source:'reel'}));
    let started=false;
    vid?.addEventListener('timeupdate',()=>{
      if(!vid.duration)return;
      const ratio=vid.currentTime/vid.duration;
      if(!started&&ratio>=.05){started=true;feedV2Event(item.querySelector('[data-reel-like]')?.dataset.reelLike,'watch_25',{watch_seconds:vid.currentTime,source:'reel'});}
      if(ratio>=.5&&!item.dataset.half){item.dataset.half='1';feedV2Event(item.querySelector('[data-reel-like]')?.dataset.reelLike,'watch_50',{watch_seconds:vid.currentTime,source:'reel'});}
      if(ratio>=.75&&!item.dataset.three){item.dataset.three='1';feedV2Event(item.querySelector('[data-reel-like]')?.dataset.reelLike,'watch_75',{watch_seconds:vid.currentTime,source:'reel'});}
    });
  });
};

try{
  supabase.channel('feed-v2-trending-realtime').on('postgres_changes',{event:'*',schema:'public',table:'feed_trending_items'},()=>loadFeedV2Trending().catch(()=>{})).subscribe();
}catch(e){console.warn('feed realtime',e.message)}
</script>




</form>
</div>







<script id="spike-player-runtime">
(function(){
  const qs=(root,sel)=>root.querySelector(sel);
  const fmt=t=>{t=Number.isFinite(t)?Math.max(0,t):0;const m=Math.floor(t/60),sec=Math.floor(t%60);return `${m}:${String(sec).padStart(2,'0')}`};
  function initPlayer(root){
    if(root.dataset.spikeReady)return;
    const v=qs(root,'[data-spike-video]'); if(!v)return;
    root.dataset.spikeReady='1';
    const playBtns=root.querySelectorAll('[data-spike-action="play"]');
    const play=async()=>{
      if(v.paused){try{await v.play()}catch(e){root.querySelector('[data-spike-hint]').textContent='Tap play to start'}}else v.pause();
    };
    playBtns.forEach(b=>b.addEventListener('click',e=>{e.stopPropagation();play()}));
    v.addEventListener('play',()=>{root.classList.remove('paused');root.classList.add('playing');playBtns.forEach(b=>b.textContent='❚❚');root.querySelector('[data-spike-hint]').style.display='none';root.classList.remove('show-center')});
    v.addEventListener('pause',()=>{root.classList.add('paused');root.classList.remove('playing');playBtns.forEach(b=>b.textContent='▶');root.querySelector('[data-spike-hint]').style.display=''});
    v.addEventListener('loadedmetadata',()=>{
      const w=v.videoWidth||0,h=v.videoHeight||0;
      root.classList.remove('spike-portrait','spike-square','spike-landscape');
      if(w&&h){
        const ratio=w/h;
        root.style.setProperty('--spike-natural-width', Math.min(w, 1000) + 'px');
        root.dataset.videoRatio=ratio.toFixed(4);
        if(ratio<.85) root.classList.add('spike-portrait');
        else if(ratio<=1.15) root.classList.add('spike-square');
        else root.classList.add('spike-landscape');
        if(root.classList.contains('spike-compact')){
          root.style.width='fit-content';
          root.style.maxWidth='100%';
        }
      }
      update();
    });
    v.addEventListener('timeupdate',update);
    v.addEventListener('progress',update);
    v.addEventListener('click',play);
    const vol=root.querySelector('[data-spike-volume]');
    const mute=root.querySelector('[data-spike-action="mute"]');
    vol.addEventListener('input',()=>{v.volume=Number(vol.value);v.muted=v.volume===0;mute.textContent=v.muted?'🔇':'🔊'});
    mute.addEventListener('click',()=>{v.muted=!v.muted;mute.textContent=v.muted?'🔇':'🔊';if(!v.muted&&v.volume===0){v.volume=.8;vol.value=.8}});
    root.querySelector('[data-spike-progress]').addEventListener('input',e=>{if(v.duration)v.currentTime=(Number(e.target.value)/1000)*v.duration});
    root.querySelector('[data-spike-speed]').addEventListener('change',e=>v.playbackRate=Number(e.target.value));
    const size=root.querySelector('[data-spike-size]');
    size.addEventListener('change',e=>{
      const mode=e.target.value;
      root.classList.remove('spike-compact','spike-standard','spike-wide','spike-cinema');
      root.classList.add('spike-'+mode);
      root.style.width = mode==='compact' ? 'fit-content' : '';
      root.style.maxWidth = '100%';
    });
    root.querySelector('[data-spike-action="fullscreen"]').addEventListener('click',async()=>{
      try{if(document.fullscreenElement)await document.exitFullscreen();else await root.requestFullscreen()}catch(e){}
    });
    root.querySelector('[data-spike-action="theater"]').addEventListener('click',()=>root.classList.toggle('spike-theater'));
    function update(){
      const p=root.querySelector('[data-spike-progress]');p.value=v.duration?Math.round((v.currentTime/v.duration)*1000):0;
      root.querySelector('[data-spike-time]').textContent=`${fmt(v.currentTime)} / ${fmt(v.duration)}`;
    }
    // Double click the video for fullscreen; single click remains play/pause.
    let last=0;v.addEventListener('click',e=>{const now=Date.now();if(now-last<280){e.preventDefault();root.querySelector('[data-spike-action="fullscreen"]').click()}else if(!v.paused){root.classList.remove('show-center')}last=now});
  }
  function initAll(){document.querySelectorAll('[data-spike-player]').forEach(initPlayer)}
  document.addEventListener('DOMContentLoaded',initAll);
  const observer=new MutationObserver(initAll);observer.observe(document.documentElement,{childList:true,subtree:true});
  window.initSpikePlayers=initAll;
})();
</script>

<script id="spike-live-dropdown-js">
(function(){
  const toggle=document.getElementById("spikeLiveToggle");
  const panel=document.getElementById("spikeLivePanel");
  if(!toggle||!panel)return;
  toggle.addEventListener("click",function(e){
    e.stopPropagation();
    const open=panel.classList.toggle("open");
    toggle.setAttribute("aria-expanded",String(open));
  });
  document.addEventListener("click",function(e){
    if(!e.target.closest("#spikeLiveMenu")){
      panel.classList.remove("open");
      toggle.setAttribute("aria-expanded","false");
    }
  });
  panel.addEventListener("click",function(e){
    const item=e.target.closest("[data-action]");
    if(!item)return;
    const action=item.dataset.action;
    if(action==="studio"){
      location.href=new URL("live_studio.html",location.href).href;
    }else if(action==="viewer"){
      // If the Feed has a live session in its page state, use it. Otherwise open the
      // viewer page and let it report that a session is required.
      const id=document.querySelector("[data-live-session-id]")?.getAttribute("data-live-session-id")
        || document.querySelector("[data-session-id]")?.getAttribute("data-session-id")
        || window.currentLiveSessionId || "";
      const u=new URL("live_viewer.html",location.href);
      if(id)u.searchParams.set("session",id);
      location.href=u.href;
    }
  });
})();
</script>

</body>
</html>