<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Feed — SPIKE</title>
<meta name="theme-color" content="#00a884">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⚡</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
/* Header brand matches the SPIKE index.html identity */
.brand .brand-title{
  font-weight:950;
  text-transform:uppercase;
  letter-spacing:.08em;
  background:linear-gradient(90deg,#7aff4f,#3fffd8,#7aa7ff,#d86cff,#ff5fb7,#7aff4f);
  background-size:300% 100%;
  -webkit-background-clip:text;
  background-clip:text;
  -webkit-text-fill-color:transparent;
  color:transparent;
  animation:brandSparkle 3s linear infinite;
  filter:drop-shadow(0 0 10px rgba(100,235,100,.25));
}
@keyframes brandSparkle{to{background-position:300% center}}
:root{
 --bg:#070b10;--surface:#0d1520;--card:#142030;--glass:rgba(13,21,32,.88);
 --line:rgba(255,255,255,.08);--text:#f1f5f9;--muted:#94a3b8;
 --primary:#00a884;--primary2:#00c29a;--danger:#f43f5e;--warning:#f59e0b;
 --blue:#0ea5e9;--gold:#ffd700;--shadow:0 18px 60px rgba(0,0,0,.42)
}
body.light{--bg:#f0f4fa;--surface:#e8edf4;--card:#fff;--glass:rgba(255,255,255,.94);--line:rgba(0,0,0,.08);--text:#0f1824;--muted:#5a6e8a}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{min-height:100%;background:var(--bg);color:var(--text);font-family:'Plus Jakarta Sans',sans-serif}
body{display:flex;flex-direction:column;overflow-x:hidden}
button,input,textarea,select{font:inherit}button{cursor:pointer}
.header{position:sticky;top:0;z-index:100;height:70px;width:100%;padding:8px max(12px,calc((100vw - 620px)/2)) 8px;display:flex;align-items:center;justify-content:space-between;background:var(--glass);border-bottom:1px solid var(--line);backdrop-filter:blur(18px)}
.brand{display:flex;align-items:center;text-decoration:none;font-size:1.45rem}.bolt{width:34px;height:34px;border-radius:10px;display:grid;place-items:center;background:linear-gradient(135deg,var(--primary),var(--primary2));box-shadow:0 0 20px rgba(0,168,132,.3)}
.header-actions{display:flex;gap:6px;align-items:center}.icon{width:40px;height:40px;border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.035);color:var(--text);display:grid;place-items:center;position:relative}.badge{position:absolute;top:-4px;right:-4px;min-width:18px;height:18px;padding:0 4px;border-radius:99px;background:var(--danger);font-size:.55rem;font-weight:800;display:none;place-items:center;color:#fff;border:2px solid var(--bg)}.badge.show{display:grid}
.avatar{width:34px;height:34px;border-radius:50%;overflow:hidden;display:grid;place-items:center;background:linear-gradient(135deg,var(--primary),#005c4b);font-weight:800;color:#fff}.avatar img{width:100%;height:100%;object-fit:cover}
.main{width:min(620px,100%);margin:auto;padding:14px 12px 35px;display:flex;flex-direction:column;gap:14px}
.card{background:rgba(20,32,48,.72);border:1px solid var(--line);border-radius:20px;box-shadow:var(--shadow);backdrop-filter:blur(14px)}body.light .card{background:rgba(255,255,255,.9)}
.announcement{display:none;align-items:center;gap:10px;padding:9px 12px;border-radius:13px;background:rgba(0,168,132,.07);border:1px solid rgba(0,168,132,.15);font-size:.72rem}.announcement.show{display:flex}.announcement span{flex:1}
.composer{padding:15px;display:flex;flex-direction:column;gap:11px}.composer textarea{width:100%;min-height:76px;max-height:220px;resize:none;border:1px solid var(--line);background:rgba(7,11,16,.5);color:var(--text);border-radius:14px;padding:13px;outline:none;line-height:1.45}.composer textarea:focus{border-color:var(--primary);box-shadow:0 0 0 3px rgba(0,168,132,.12)}
.compose-row{display:flex;gap:7px;align-items:center;justify-content:space-between;flex-wrap:wrap}.tools{display:flex;gap:6px;flex-wrap:wrap}.tool{min-height:40px;padding:7px 11px;border:1px solid var(--line);border-radius:11px;background:rgba(255,255,255,.035);color:var(--muted);font-size:.72rem;font-weight:700}.tool:hover{color:var(--text)}.post-btn{min-height:40px;padding:8px 18px;border:0;border-radius:11px;background:var(--primary);color:#fff;font-weight:800}.post-btn:disabled{opacity:.55}
.preview{display:none;position:relative;border:1px solid var(--line);border-radius:14px;overflow:hidden}.preview.show{display:block}.preview img,.preview video{width:100%;max-height:260px;object-fit:cover;display:block}.remove{position:absolute;right:8px;top:8px;border:0;border-radius:50%;width:30px;height:30px;background:rgba(0,0,0,.75);color:#fff}
.schedule{display:none;gap:7px;align-items:center;font-size:.7rem;color:var(--muted)}.schedule.show{display:flex}.schedule input{background:var(--surface);color:var(--text);border:1px solid var(--line);border-radius:9px;padding:7px}
.filters{display:flex;gap:7px;overflow:auto;scrollbar-width:none}.filter{white-space:nowrap;padding:8px 12px;border:1px solid var(--line);border-radius:99px;background:rgba(255,255,255,.03);color:var(--muted);font-size:.68rem;font-weight:700}.filter.active{background:rgba(0,168,132,.12);border-color:rgba(0,168,132,.4);color:var(--primary)}
.posts{display:flex;flex-direction:column;gap:14px}.empty{text-align:center;color:var(--muted);padding:35px 15px;font-size:.8rem}
.post{padding:14px}.post.pinned{border-color:var(--primary);box-shadow:0 0 24px rgba(0,168,132,.12)}.post-head{display:flex;gap:10px;align-items:center}.author{display:flex;gap:9px;align-items:center;min-width:0;flex:1}.author .avatar{width:42px;height:42px}.author-info{min-width:0}.author-name{font-size:.8rem;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.meta{font-size:.62rem;color:var(--muted)}.post-menu{border:0;background:transparent;color:var(--muted);font-size:1.2rem;padding:8px}.post-content{padding:12px 2px;font-size:.86rem;line-height:1.55;white-space:pre-wrap;overflow-wrap:anywhere}.hashtag{color:var(--primary)}.mention{color:var(--blue)}.post-media{border-radius:15px;overflow:hidden;border:1px solid var(--line);background:#000}.post-media img,.post-media video{width:100%;max-height:430px;display:block;object-fit:cover}.location{font-size:.65rem;color:var(--muted);padding:4px 0 8px}.repost{border:1px solid var(--line);border-radius:13px;padding:10px;margin:4px 0 8px;background:rgba(255,255,255,.025)}.repost small{color:var(--muted)}
.actions{display:flex;gap:6px;margin-top:10px}.action{flex:1;min-height:39px;border:1px solid var(--line);border-radius:11px;background:rgba(255,255,255,.025);color:var(--muted);font-size:.7rem;font-weight:700}.action.active{color:#ff5c78;border-color:rgba(244,63,94,.25);background:rgba(244,63,94,.07)}.action.save.active{color:var(--gold)}.panel{display:none;padding-top:9px}.panel.show{display:block}.reaction-row{display:flex;gap:5px;flex-wrap:wrap;padding:5px 0 10px}.reaction{border:1px solid var(--line);background:rgba(255,255,255,.03);border-radius:10px;padding:7px 10px}.comments{border-top:1px solid var(--line);margin-top:9px;padding-top:10px}.comment{padding:9px;border-radius:11px;background:rgba(255,255,255,.025);margin-bottom:7px}.comment-head{display:flex;justify-content:space-between;font-size:.65rem}.comment-text{font-size:.72rem;line-height:1.45}.reply{margin:7px 0 0 18px;border-left:2px solid var(--line);padding-left:8px}.comment-input{display:flex;gap:6px}.comment-input textarea{flex:1;min-height:42px;max-height:120px;resize:none;background:var(--surface);color:var(--text);border:1px solid var(--line);border-radius:11px;padding:9px;font-size:.75rem}.comment-input button{width:65px;border:0;border-radius:11px;background:var(--primary);color:#fff;font-weight:800;font-size:.7rem}
.story-row{display:none;gap:9px;overflow:auto;padding:11px 12px}.story-row.show{display:flex}.story{flex:0 0 66px;text-align:center;font-size:.6rem;color:var(--muted)}.story-avatar{width:58px;height:58px;border-radius:50%;overflow:hidden;background:transparent;border:0;box-shadow:none;padding:0}.story-avatar>div{width:100%;height:100%;border-radius:50%;background:var(--surface);overflow:hidden;display:grid;place-items:center}.story-avatar img{display:block;width:100%;height:100%;object-fit:cover;border:0;outline:0;box-shadow:none;background:transparent}
.story-media{margin:8px -2px 0;border-radius:12px;overflow:hidden;background:#000}
.story-media img,.story-media video{display:block;width:100%;height:auto;max-height:360px;object-fit:contain;background:#000}
.story-audio{display:flex;align-items:center;gap:8px;margin:8px -2px 0;padding:8px;border-radius:12px;background:#000}
.story-audio audio{width:100%;height:34px}
.story-text{margin-top:8px;padding:8px;border-radius:10px;background:rgba(255,255,255,.05);line-height:1.45}
.overlay{position:fixed;inset:0;background:rgba(0,0,0,.7);backdrop-filter:blur(15px);z-index:300;display:none;align-items:center;justify-content:center;padding:15px}.overlay.open{display:flex}.modal{width:min(520px,100%);max-height:88vh;overflow:auto;background:var(--surface);border:1px solid var(--line);border-radius:20px;padding:17px;box-shadow:var(--shadow)}.modal h2{font-size:1rem;margin-bottom:12px}.modal p{font-size:.73rem;color:var(--muted);line-height:1.5}.modal-row{display:flex;gap:8px;margin-top:13px}.modal-row button{flex:1}.modal input,.modal textarea,.modal select{width:100%;margin-top:6px;background:var(--bg);color:var(--text);border:1px solid var(--line);border-radius:10px;padding:10px;outline:none}.modal textarea{min-height:100px;resize:vertical}.primary{background:var(--primary)!important;color:#fff!important;border-color:var(--primary)!important}.danger{color:#fb7185!important}.menu-list{display:grid;gap:6px}.menu-list button{padding:12px;border:1px solid var(--line);border-radius:11px;background:rgba(255,255,255,.03);color:var(--text);text-align:left}.call-ui{position:fixed;inset:0;background:#02060a;z-index:500;display:none;flex-direction:column}.call-ui.open{display:flex}.call-videos{flex:1;position:relative;background:#05090e}.remote-video{width:100%;height:100%;object-fit:cover}.local-video{position:absolute;right:12px;top:12px;width:120px;height:170px;border-radius:14px;object-fit:cover;background:#111;border:1px solid var(--line)}.call-bottom{padding:16px;display:flex;justify-content:center;gap:12px}.call-bottom button{width:50px;height:50px;border:0;border-radius:50%;background:#1b2734;color:#fff}.call-bottom .end{background:var(--danger)}
.loader{position:fixed;inset:0;z-index:900;background:var(--bg);display:grid;place-items:center}.loader.hide{display:none}.loader-inner{text-align:center;color:var(--muted);font-size:.75rem}.spinner{width:38px;height:38px;border:3px solid rgba(255,255,255,.08);border-top-color:var(--primary);border-radius:50%;animation:spin .8s linear infinite;margin:0 auto 12px}@keyframes spin{to{transform:rotate(360deg)}}
.toast{position:fixed;z-index:1000;top:80px;left:50%;transform:translate(-50%,-15px);opacity:0;pointer-events:none;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:10px 14px;font-size:.72rem;transition:.2s;box-shadow:var(--shadow)}.toast.show{opacity:1;transform:translate(-50%,0)}
footer{padding:18px;text-align:center;color:var(--muted);font-size:.65rem;border-top:1px solid var(--line);margin-top:auto}
.hidden{display:none!important}
@media(max-width:480px){.header{height:64px}.brand{font-size:1.2rem}.bolt{width:30px;height:30px}.icon{width:37px;height:37px}.main{padding:10px 8px 25px}.actions .action{font-size:.63rem}}

/* ⭐ social features */
.feed-status{display:flex;align-items:center;gap:8px;padding:8px 12px;font-size:.72rem;color:var(--muted)}
.presence-dot{width:8px;height:8px;border-radius:50%;background:#22c55e;box-shadow:0 0 0 3px rgba(34,197,94,.12)}
.smart-label{margin-left:auto}
.blocked-note{opacity:.7;font-size:.8rem}

/* Android/iOS fullscreen safe-area support */
html,body{margin:0;padding:0;min-height:100%;overscroll-behavior-x:none}
body{padding-top:env(safe-area-inset-top,0px);padding-left:env(safe-area-inset-left,0px);padding-right:env(safe-area-inset-right,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
header,.topbar,.app-header,.site-header{padding-top:max(10px,env(safe-area-inset-top,0px));}
@supports (padding-top: constant(safe-area-inset-top)){
 body{padding-top:constant(safe-area-inset-top)}
 header,.topbar,.app-header,.site-header{padding-top:max(10px,constant(safe-area-inset-top))}
}

/* FINAL STORY RING REMOVAL */
.story-avatar,
.story-avatar::before,
.story-avatar::after,
.story-avatar img{
  border:0 !important;
  outline:0 !important;
  box-shadow:none !important;
}
.story-avatar{
  background:transparent !important;
  padding:0 !important;
  margin:0 !important;
  border-radius:50% !important;
  overflow:hidden !important;
}
.story-avatar img{
  display:block !important;
  width:100% !important;
  height:100% !important;
  object-fit:cover !important;
  background:transparent !important;
}
.story-ring,
.story-border,
.story-circle,
.story-avatar-wrap{
  border:0 !important;
  outline:0 !important;
  box-shadow:none !important;
  background:transparent !important;
  padding:0 !important;
}

/* Remove the actual story-post ring/halo, including button/focus/pseudo states. */
.story,
.story:hover,
.story:focus,
.story:focus-visible,
.story:active,
.story::before,
.story::after,
.story-avatar,
.story-avatar::before,
.story-avatar::after,
.story-avatar > div,
.story-avatar > div::before,
.story-avatar > div::after,
.story-avatar img{
  -webkit-appearance:none !important;
  appearance:none !important;
  border:0 !important;
  outline:0 !important;
  box-shadow:none !important;
  background-image:none !important;
}
.story{
  background:transparent !important;
  padding:0 !important;
}
.story-avatar{
  width:58px !important;
  height:58px !important;
  min-width:58px !important;
  min-height:58px !important;
  padding:0 !important;
  margin:0 auto !important;
  background:transparent !important;
  border-radius:50% !important;
  overflow:hidden !important;
}
.story-avatar > div{
  width:100% !important;
  height:100% !important;
  padding:0 !important;
  margin:0 !important;
  background:transparent !important;
  border-radius:50% !important;
  overflow:hidden !important;
  display:block !important;
}
.story-avatar img{
  width:100% !important;
  height:100% !important;
  display:block !important;
  margin:0 !important;
  padding:0 !important;
  border-radius:50% !important;
  object-fit:cover !important;
}


.spike-player.spike-portrait{width:min(100%,560px)}.spike-player.spike-square{width:min(100%,760px)}.spike-player.spike-landscape{width:100%}.spike-player.spike-portrait video,.spike-player.spike-square video,.spike-player.spike-landscape video{height:auto;max-height:78vh;object-fit:contain}</style>

<!-- SPIKE AUTH GUARD: protected page -->
<script>
(function () {
  // Redirect immediately if there is no locally stored Supabase session.
  // The async getUser() check below remains authoritative.
  try {
    const raw = localStorage.getItem('sb-' + location.hostname + '-auth-token');
    if (!raw) {
      const hasSupabaseToken = Object.keys(localStorage).some(function (key) {
        return key.startsWith('sb-') && key.endsWith('-auth-token');
      });
      if (!hasSupabaseToken) location.replace('index.html');
    }
  } catch (_) {}
})();
</script>

<style>

/* =========================================================
   SPIKE Messages visual system applied to Feed
   Feed functionality/layout selectors remain untouched.
   ========================================================= */
:root{
  --bg1:#fdf2f8;--bg2:#fef3c7;--bg3:#ecfdf5;
  --card:rgba(255,255,255,.82);--text:#1f2937;--muted:#6b7280;
  --border:#e5e7eb;--primary:#f472b6;--primary2:#fb923c;
  --bubble:#fff;--mine:linear-gradient(135deg,#f472b6,#fb923c);
  --shadow:0 20px 60px rgba(31,41,55,.12);
}
body.dark{
  --bg1:#111827;--bg2:#172033;--bg3:#0f2b2b;
  --card:rgba(17,24,39,.9);--text:#f3f4f6;--muted:#9ca3af;
  --border:#374151;--bubble:#1f2937;--primary:#f472b6;--primary2:#fb923c;
  --mine:linear-gradient(135deg,#8b5cf6,#ec4899);
  --shadow:0 20px 60px rgba(0,0,0,.35);
}
html,body{
  min-height:100%;
  font-family:Inter,sans-serif;
  color:var(--text);
  background:linear-gradient(135deg,var(--bg1),var(--bg2),var(--bg3));
}
body{padding:0!important}
.header{
  background:var(--card)!important;
  border:1px solid var(--border)!important;
  border-radius:22px!important;
  box-shadow:var(--shadow)!important;
  backdrop-filter:blur(14px)!important;
  -webkit-backdrop-filter:blur(14px)!important;
}
.icon{
  border:1px solid var(--border)!important;
  background:var(--card)!important;
  color:var(--text)!important;
  border-radius:12px!important;
}
.card{
  background:var(--card)!important;
  border:1px solid var(--border)!important;
  border-radius:20px!important;
  box-shadow:var(--shadow)!important;
  backdrop-filter:blur(14px)!important;
  -webkit-backdrop-filter:blur(14px)!important;
}
.tool,.filter,.action{
  border:1px solid var(--border)!important;
  background:var(--card)!important;
  color:var(--muted)!important;
  border-radius:12px!important;
}
.tool:hover,.filter:hover,.action:hover{
  background:rgba(244,114,182,.08)!important;
  color:var(--text)!important;
}
.primary,.post-btn{
  background:var(--primary)!important;
  color:#fff!important;
  border:0!important;
}
.modal,.overlay .modal{
  background:var(--card)!important;
  border:1px solid var(--border)!important;
  box-shadow:var(--shadow)!important;
  border-radius:24px!important;
}
.modal input,.modal textarea,.modal select{
  background:var(--bubble)!important;
  color:var(--text)!important;
  border-color:var(--border)!important;
}
.post,.composer,.story-row,.announcement{
  background:var(--card)!important;
  border-color:var(--border)!important;
}
.avatar,.follow-avatar{
  background:var(--primary)!important;
}

.brand .brand-title{
  font-weight:800!important;
  letter-spacing:.4px!important;
  background:linear-gradient(90deg,#f472b6,#fb923c,#22c55e,#f472b6);
  background-size:300% 100%;
  -webkit-background-clip:text;background-clip:text;
  -webkit-text-fill-color:transparent;color:transparent;
  animation:spikeMessagesBrand 3s linear infinite;
  filter:drop-shadow(0 0 8px rgba(244,114,182,.28));
}
@keyframes spikeMessagesBrand{to{background-position:300% center}}
@media(max-width:760px){
  .header{border-radius:18px!important}
}

html{padding-top:env(safe-area-inset-top,0px);padding-left:env(safe-area-inset-left,0px);padding-right:env(safe-area-inset-right,0px)}
.header{padding-top:max(12px,env(safe-area-inset-top,0px))!important}

</style>
<style>
/* ---------- Final SPIKE theme polish: light + dark ---------- */
:root{
  color-scheme:light;
  --bg:#f7f8fc;
  --bg-soft:#ffffff;
  --surface:rgba(255,255,255,.88);
  --surface-strong:#ffffff;
  --surface-hover:rgba(248,250,252,.96);
  --text:#172033;
  --text-soft:#475569;
  --muted:#64748b;
  --border:rgba(148,163,184,.24);
  --border-strong:rgba(148,163,184,.38);
  --primary:#ec4899;
  --primary-2:#f97316;
  --success:#16a34a;
  --danger:#dc2626;
  --shadow:0 14px 45px rgba(15,23,42,.10);
  --shadow-soft:0 6px 24px rgba(15,23,42,.07);
  --ring:rgba(236,72,153,.28);
}
body.dark{
  color-scheme:dark;
  --bg:#090d16;
  --bg-soft:#111827;
  --surface:rgba(17,24,39,.88);
  --surface-strong:#151d2d;
  --surface-hover:rgba(30,41,59,.94);
  --text:#f8fafc;
  --text-soft:#cbd5e1;
  --muted:#94a3b8;
  --border:rgba(148,163,184,.18);
  --border-strong:rgba(148,163,184,.30);
  --primary:#f472b6;
  --primary-2:#fb923c;
  --success:#4ade80;
  --danger:#fb7185;
  --shadow:0 18px 55px rgba(0,0,0,.34);
  --shadow-soft:0 8px 28px rgba(0,0,0,.22);
  --ring:rgba(244,114,182,.30);
}
html,body{background:var(--bg);color:var(--text)}
body{
  background:
    radial-gradient(circle at 10% -5%,rgba(236,72,153,.09),transparent 28rem),
    radial-gradient(circle at 95% 8%,rgba(34,197,94,.07),transparent 24rem),
    var(--bg);
}
body.dark{
  background:
    radial-gradient(circle at 10% -5%,rgba(236,72,153,.10),transparent 28rem),
    radial-gradient(circle at 95% 8%,rgba(34,197,94,.06),transparent 24rem),
    var(--bg);
}
.header,.card,.post,.composer,.story-row,.announcement,.modal{
  background:var(--surface)!important;
  color:var(--text)!important;
  border-color:var(--border)!important;
  box-shadow:var(--shadow-soft)!important;
  backdrop-filter:blur(18px);
  -webkit-backdrop-filter:blur(18px);
}
.header{box-shadow:var(--shadow)!important}
h1,h2,h3,h4,h5,h6,p,label,.name,.username,.title,.brand-title{color:var(--text)}
.muted,.sub,.meta,.timestamp,.description,.hint{color:var(--muted)!important}
input,textarea,select{
  background:var(--surface-strong)!important;
  color:var(--text)!important;
  border-color:var(--border)!important;
}
input::placeholder,textarea::placeholder{color:var(--muted)!important}
input:focus,textarea:focus,select:focus{
  border-color:var(--primary)!important;
  box-shadow:0 0 0 4px var(--ring)!important;
  outline:none!important;
}
button,.icon,.tool,.filter,.action{
  color:var(--text);
  border-color:var(--border)!important;
}
.icon,.tool,.filter,.action{
  background:var(--surface)!important;
}
.icon:hover,.tool:hover,.filter:hover,.action:hover{
  background:var(--surface-hover)!important;
  border-color:var(--border-strong)!important;
}
.primary,.post-btn{
  background:linear-gradient(135deg,var(--primary),var(--primary-2))!important;
  color:#fff!important;
  box-shadow:0 8px 22px rgba(236,72,153,.18);
}
.danger{color:var(--danger)!important}
.divider,.separator{background:var(--border)!important}
a{color:var(--primary)}
.brand .brand-title{
  background:linear-gradient(90deg,#f472b6,#fb923c,#22c55e,#f472b6);
  background-size:300% 100%;
  -webkit-background-clip:text;background-clip:text;
  -webkit-text-fill-color:transparent;
  animation:spikeCleanBrand 4s linear infinite;
}
@keyframes spikeCleanBrand{to{background-position:300% center}}
.avatar{box-shadow:0 0 0 2px var(--surface),0 0 0 3px var(--border)}
.modal-backdrop,.overlay{background:rgba(2,6,23,.55)!important}
body:not(.dark) .modal-backdrop,body:not(.dark) .overlay{background:rgba(15,23,42,.28)!important}
@media(max-width:700px){
  .header{border-radius:16px!important}
  .card,.post,.composer{border-radius:17px!important}
}
@media(prefers-reduced-motion:reduce){
  .brand .brand-title{animation:none}
}
</style>



<style id="feed-v2-ui">
.feed-v2-nav{display:flex;gap:7px;overflow:auto;padding:2px 0 3px;scrollbar-width:none}.feed-v2-nav button{white-space:nowrap;border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:999px;padding:9px 12px;font-size:.68rem;font-weight:800}.feed-v2-nav button.active{background:linear-gradient(135deg,var(--primary),var(--primary-2));color:#fff;border-color:transparent}.feed-v2-panel{display:none}.feed-v2-panel.open{display:block}.feed-v2-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.feed-v2-stat{padding:13px;border:1px solid var(--border);border-radius:14px;background:var(--surface)}.feed-v2-stat b{display:block;font-size:1.15rem}.feed-v2-stat span{font-size:.63rem;color:var(--muted)}.reels-shell{position:fixed;inset:0;z-index:700;background:#000;display:none}.reels-shell.open{display:block}.reels-close{position:absolute;z-index:3;right:14px;top:14px;width:42px;height:42px;border:0;border-radius:50%;background:rgba(0,0,0,.55);color:#fff}.reels-list{height:100%;overflow-y:auto;scroll-snap-type:y mandatory}.reel-item{height:100%;position:relative;scroll-snap-align:start;background:#000}.reel-item video{width:100%;height:100%;object-fit:cover}.reel-caption{position:absolute;left:14px;right:80px;bottom:30px;color:#fff;text-shadow:0 2px 8px #000;font-size:.8rem}.reel-actions{position:absolute;right:12px;bottom:30px;display:grid;gap:9px}.reel-actions button{width:48px;height:48px;border:0;border-radius:50%;background:rgba(0,0,0,.55);color:#fff}.feed-v2-list{display:grid;gap:8px}.feed-v2-item{padding:11px;border:1px solid var(--border);border-radius:13px;background:var(--surface)}.feed-v2-item b{font-size:.76rem}.feed-v2-item p{font-size:.68rem;color:var(--muted);margin-top:4px}.feed-v2-actions{display:flex;gap:7px;margin-top:10px;flex-wrap:wrap}.feed-v2-actions button{border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:10px;padding:8px 10px;font-size:.65rem;font-weight:800}.live-dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:#ef4444;margin-right:5px}.v2-toggle{display:flex;justify-content:space-between;align-items:center;padding:11px;border:1px solid var(--border);border-radius:12px;margin-bottom:7px;font-size:.7rem}.v2-toggle input{width:auto}.ai-result{white-space:pre-wrap;padding:11px;border-radius:12px;background:var(--surface-strong);font-size:.72rem;line-height:1.5;margin-top:9px}
@media(max-width:520px){.feed-v2-grid{grid-template-columns:1fr 1fr}.reel-caption{bottom:20px}}
</style>


<style id="spike-premium-player">
.post-media.spike-player{position:relative;background:#050505;border-radius:18px;overflow:hidden;aspect-ratio:auto;box-shadow:0 12px 34px rgba(0,0,0,.20);width:100%;max-width:560px;margin-inline:auto}
.spike-player video{width:100%;height:auto;display:block;object-fit:contain;background:#050505;max-width:100%;max-height:60vh;margin:0 auto}
.spike-player.spike-portrait{width:min(100%,420px);max-height:60vh}
.spike-player.spike-portrait video{width:auto;max-width:100%;max-height:60vh;margin-inline:auto}
.spike-player.spike-square{width:min(100%,520px);max-height:60vh}
.spike-player.spike-square video{max-height:60vh}
.spike-player.spike-landscape{width:min(100%,560px);max-height:60vh}
.spike-player.spike-landscape video{max-height:60vh}
.spike-player .spike-brand{position:absolute;top:12px;left:12px;padding:5px 10px;border-radius:999px;background:rgba(0,0,0,.48);backdrop-filter:blur(10px);font-size:11px;font-weight:950;letter-spacing:.12em;z-index:3;background-image:linear-gradient(90deg,#ff3b9d 0%,#7dff5a 50%,#ff9d2e 100%);color:transparent;background-clip:text;-webkit-background-clip:text;-webkit-text-fill-color:transparent;text-shadow:0 0 14px rgba(255,255,255,.08)}
.spike-player .spike-center{position:absolute;inset:0;display:grid;place-items:center;pointer-events:none;opacity:0!important;visibility:hidden;transition:none}
.spike-player .spike-play{pointer-events:auto;width:58px;height:58px;border:0;border-radius:50%;background:rgba(255,255,255,.94);font-size:22px;box-shadow:0 8px 28px rgba(0,0,0,.28);cursor:pointer;opacity:0;transform:scale(.92);transition:opacity .22s,transform .22s}
.spike-player.paused .spike-play{opacity:1;transform:scale(1)}
.spike-player .spike-gradient{position:absolute;left:0;right:0;bottom:0;height:100px;background:linear-gradient(transparent,rgba(0,0,0,.78));pointer-events:none}
.spike-player .spike-controls{position:absolute;left:10px;right:10px;bottom:10px;display:flex;align-items:center;gap:7px;z-index:4}
.spike-player .spike-controls button{border:0;background:rgba(18,18,18,.72);backdrop-filter:blur(12px);color:#fff;width:34px;height:34px;border-radius:10px;cursor:pointer;font-size:15px}
.spike-player .spike-controls button:hover{background:rgba(255,255,255,.20)}
.spike-player .spike-time{color:#fff;font-size:11px;font-variant-numeric:tabular-nums;min-width:72px;text-align:center}
.spike-player .spike-progress{appearance:none;height:4px;flex:1;min-width:50px;border-radius:9px;cursor:pointer}
.spike-player .spike-volume{width:72px;accent-color:#fff}
.spike-player .spike-speed{color:#fff;background:rgba(18,18,18,.72);border:0;border-radius:9px;padding:8px;font-size:11px}
.spike-player .spike-quality{color:#fff;font-size:10px;padding:5px 7px;border-radius:8px;background:rgba(18,18,18,.72)}.spike-player .spike-size{color:#fff;background:rgba(18,18,18,.72);border:0;border-radius:9px;padding:8px;font-size:10px}.spike-player.spike-compact{width:fit-content;max-width:100%;margin-inline:auto}
.spike-player.spike-standard{width:min(100%,560px);max-width:560px}
.spike-player.spike-wide{width:min(100%,560px);max-width:560px}
.spike-player.spike-cinema{width:min(100%,560px);max-width:560px}
.spike-player.spike-theater{position:relative;width:100%;max-height:80vh}
.spike-player.spike-fullscreen{border-radius:0;width:100%;height:100%;max-width:none}.spike-player.spike-fullscreen video{width:100%;height:100%;object-fit:contain}
.spike-player .spike-soundhint{position:absolute;right:12px;top:12px;color:#fff;background:rgba(0,0,0,.58);padding:6px 9px;border-radius:999px;font-size:10px;z-index:3;opacity:.9}
@media(max-width:600px){
  .spike-player{border-radius:14px;width:min(100%,520px);max-height:58vh}
  .spike-player video{max-height:58vh}
  .spike-player.spike-portrait{width:min(100%,360px);max-height:58vh}
  .spike-player.spike-portrait video{max-height:58vh}
  .spike-player .spike-volume,.spike-player .spike-speed{display:none}
  .spike-player .spike-time{min-width:62px}
  .spike-player .spike-controls{gap:5px}
}

<style id="spike-live-menu">
.menu-list #menuLiveStudio{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  font-weight:850;
  border-color:rgba(236,72,153,.28)!important;
  background:linear-gradient(135deg,rgba(236,72,153,.10),rgba(249,115,22,.08))!important;
  color:var(--text)!important;
}
.menu-list #menuLiveStudio span{
  font-size:1rem;
  color:var(--primary);
  opacity:.9;
}
.menu-list #menuLiveStudio:hover{
  border-color:rgba(236,72,153,.48)!important;
  background:linear-gradient(135deg,rgba(236,72,153,.16),rgba(249,115,22,.12))!important;
}
@media(max-width:520px){
  .menu-list #menuLiveStudio{min-height:48px}
}
</style>
</style>

<style id="spike-live-dropdown-css">
.spike-live-menu{position:relative;display:inline-block;z-index:5000}
.spike-live-toggle{width:42px;height:42px;border:0;border-radius:12px;background:transparent;color:inherit;display:grid;place-items:center;font-size:21px;cursor:pointer}
.spike-live-toggle:hover,.spike-live-toggle:focus-visible{background:rgba(127,127,127,.14);outline:none}
.spike-live-panel{position:absolute;top:48px;right:0;width:220px;padding:8px;border:1px solid rgba(127,127,127,.2);border-radius:14px;background:rgba(20,24,32,.98);box-shadow:0 14px 40px rgba(0,0,0,.3);display:none}
.spike-live-panel.open{display:grid;gap:5px}
.spike-live-item{display:flex;align-items:center;gap:10px;width:100%;padding:11px 12px;border:0;border-radius:10px;background:transparent;color:#fff;text-align:left;font:inherit;cursor:pointer}
.spike-live-item:hover{background:rgba(127,127,127,.14)}
.spike-live-dot{width:8px;height:8px;border-radius:50%;background:#ef4444;box-shadow:0 0 0 4px rgba(239,68,68,.14)}
@media(max-width:600px){.spike-live-panel{position:fixed;top:58px;right:10px;width:min(230px,calc(100vw - 20px))}}
</style>

</head>
<body>
<header class="header">
<div class="spike-live-menu" id="spikeLiveMenu" aria-label="Live menu">
  <button class="spike-live-toggle" id="spikeLiveToggle" aria-label="Open Live menu" aria-expanded="false">🔴</button>
  <div class="spike-live-panel" id="spikeLivePanel" role="menu">
    <button class="spike-live-item" data-action="studio" role="menuitem"><span>🎥</span><span>Live Studio</span></button>
    <button class="spike-live-item" data-action="viewer" role="menuitem"><span class="spike-live-dot"></span><span>Watch Live</span></button>
  </div>
</div>

  <a class="brand" href="feed.html"><span class="brand-title">⚡ SPIKE</span></a>
  <div class="header-actions">
    
    <button class="icon" id="chatBtn" title="Messages">💬<span class="badge" id="chatBadge"></span></button>
    <button class="icon" id="notificationBtn" title="Notifications">🔔<span class="badge" id="notificationBadge"></span></button>
    <button class="icon" id="menuBtn" title="Menu">☰</button>
        <button class="icon" id="profileBtn" title="Profile"><span class="avatar" id="headerAvatar">U</span></button>
  </div>
</header>

<main class="main">
  <div class="announcement" id="announcement"><b>📢</b><span id="announcementText"></span><button id="closeAnnouncement">×</button></div>

  <section class="card story-row" id="storiesRow"></section>
  
<section class="card" id="feedV2Hub" style="padding:12px">
 <div class="feed-v2-nav" id="feedV2Nav">
  <button class="active" data-v2="forYou">✨ For You</button><button data-v2="trending">🔥 Trending</button><button data-v2="reels">🎬 Reels</button><button data-v2="nearby">📍 Nearby</button><button data-v2="analytics">📊 Analytics</button><button data-v2="gamify">🏆 XP</button><button data-v2="ai">✨ AI</button><button data-v2="safety">🛡️ Safety</button>
 </div>
 <div class="feed-v2-panel open" data-v2-panel="forYou"><p class="meta" id="v2PersonalStatus">Personalized ranking is ready.</p></div>
 <div class="feed-v2-panel" data-v2-panel="trending"><div class="feed-v2-actions"><button data-trend-window="15">15m</button><button data-trend-window="60">1h</button><button data-trend-window="1440">24h</button></div><div class="feed-v2-list" id="v2TrendingList"><div class="empty">Loading trends…</div></div></div>
 <div class="feed-v2-panel" data-v2-panel="reels"><div class="feed-v2-list" id="v2ReelsList"><div class="empty">Loading reels…</div></div></div>
 <div class="feed-v2-panel" data-v2-panel="nearby"><div class="feed-v2-actions"><button id="v2NearbyEnable">📍 Enable Nearby</button></div><div class="feed-v2-list" id="v2NearbyList"><div class="empty">Nearby discovery is opt-in.</div></div></div>

 <div class="feed-v2-panel" data-v2-panel="analytics"><div class="feed-v2-grid" id="v2StatsGrid"><div class="empty">Loading analytics…</div></div></div>
 <div class="feed-v2-panel" data-v2-panel="gamify"><div class="feed-v2-grid" id="v2GamifyGrid"><div class="empty">Loading XP…</div></div><div class="feed-v2-list" id="v2BadgeList" style="margin-top:9px"></div></div>
 <div class="feed-v2-panel" data-v2-panel="ai"><textarea id="v2AiInput" placeholder="Write a rough post and let SPIKE improve it…"></textarea><div class="feed-v2-actions"><button data-ai-op="rewrite">✨ Rewrite</button><button data-ai-op="caption">📝 Caption</button><button data-ai-op="hashtags"># Hashtags</button><button data-ai-op="summarize">▤ Summarize</button></div><div id="v2AiResult"></div></div>
 <div class="feed-v2-panel" data-v2-panel="safety"><label class="v2-toggle">Show sensitive content <input type="checkbox" id="v2Sensitive" checked></label><label class="v2-toggle">Show spoilers <input type="checkbox" id="v2Spoilers" checked></label><label class="v2-toggle">Show political content <input type="checkbox" id="v2Political" checked></label><label class="v2-toggle">Following only <input type="checkbox" id="v2FollowingOnly"></label><input id="v2MutedKeywords" placeholder="Muted keywords, comma separated"><button class="post-btn" id="v2SaveSafety" style="margin-top:8px;width:100%">Save Feed Controls</button></div>
</section>
<div class="reels-shell" id="v2ReelsShell"><button class="reels-close" id="v2ReelsClose">×</button><div class="reels-list" id="v2ReelsFullList"></div></div>

  <div class="feed-status"><span class="presence-dot"></span><span id="onlineStatus">Live</span><span class="smart-label" id="smartFeedLabel">Smart feed</span></div>

  <section class="card composer" id="composer">
    <textarea id="postText" placeholder="What's happening on SPIKE?"></textarea>
    <div class="preview" id="mediaPreview"><img id="imagePreview" class="hidden"><video id="videoPreview" controls class="hidden"></video><button class="remove" id="removeMedia">×</button></div>
    <div class="schedule" id="scheduleRow">Schedule <input type="datetime-local" id="scheduleTime"></div>
    <div class="compose-row">
      <div class="tools">
        <button class="tool" id="imageBtn">📷 Photo</button>
        <button class="tool" id="videoBtn">🎬 Video</button>
        <button class="tool" id="scheduleBtn">🕒 Schedule</button>
        <button class="tool" id="storyBtn">⭕ Story</button>
        <button class="tool" id="linkBtn">🔗 Link</button>
      </div>
      <button class="post-btn" id="publishBtn">Post</button>
    </div>
    <input type="file" id="imageInput" accept="image/*" class="hidden">
    <input type="file" id="videoInput" accept="video/*" class="hidden">
  </section>

  <div class="filters" id="filters">
    <button class="filter active" data-filter="latest">Latest</button>
    <button class="filter" data-filter="following">Following</button>
    <button class="filter" data-filter="popular">Popular</button>
    <button class="filter" data-filter="saved">Saved</button>
  </div>

  <section class="posts" id="posts"><div class="card empty">Loading your feed…</div></section>
</main>



<footer>© 2026 SPIKE. All rights reserved.</footer>

<div class="overlay" id="menuOverlay"><div class="modal"><h2>SPIKE</h2><div class="menu-list">
<button id="menuProfile">👤 Profile</button><button id="menuFriends">👥 Friends</button><button id="menuMessages">💬 Messages</button><button id="menuNotifications">🔔 Notifications</button><button id="menuLiveStudio" class="live-menu-item">🔴 Live Studio <span>›</span></button><button id="menuSettings">⚙️ Settings</button><button onclick="location.href='rooms.html'">🚪 Room</button><button id="menuGuide">📖 Guide</button><button id="menuSignOut" class="danger">↪ Sign out</button>
</div></div></div>

<div class="overlay" id="shareOverlay"><div class="modal"><h2>Share post</h2><p id="shareText"></p><div class="modal-row"><button class="tool" id="copyShare">Copy link</button><button class="tool primary" id="nativeShare">Share</button></div></div></div>

<div class="overlay" id="repostOverlay"><div class="modal"><h2>Repost</h2><textarea id="repostText" placeholder="Add a thought…"></textarea><div class="modal-row"><button class="tool" id="cancelRepost">Cancel</button><button class="tool primary" id="confirmRepost">Repost</button></div></div></div>

<div class="overlay" id="reportOverlay"><div class="modal"><h2>Report post</h2><select id="reportReason"><option>Spam</option><option>Harassment</option><option>Hate or abuse</option><option>Sexual content</option><option>Violence</option><option>Other</option></select><div class="modal-row"><button class="tool" id="cancelReport">Cancel</button><button class="tool primary" id="confirmReport">Report</button></div></div></div>

<div class="overlay" id="storyOverlay"><div class="modal"><h2>Create story</h2><p>Stories expire after 24 hours. Add text, an image/video, or an MP3 audio file.</p><textarea id="storyText" placeholder="Story text…"></textarea><input type="file" id="storyInput" accept="image/*,video/*"><input type="file" id="storyAudioInput" accept=".mp3,audio/mpeg,audio/mp3" class="hidden"><div class="modal-row"><button class="tool" id="storyAudioBtn">🎵 MP3</button><button class="tool" id="cancelStory">Cancel</button><button class="tool primary" id="publishStory">Publish</button></div></div></div>

<div class="overlay" id="linkOverlay"><div class="modal"><h2>Add link</h2><input id="linkInput" type="url" placeholder="https://example.com"><div class="modal-row"><button class="tool" id="cancelLink">Cancel</button><button class="tool primary" id="addLink">Add link</button></div></div></div>

<div class="overlay" id="editPostOverlay"><div class="modal"><h2>Edit post</h2><textarea id="editPostText"></textarea><div class="modal-row"><button class="tool" id="cancelEditPost">Cancel</button><button class="tool primary" id="saveEditPost">Save</button></div></div></div>

<div class="call-ui" id="callUI">
 <div class="call-videos"><video id="remoteVideo" class="remote-video" autoplay playsinline></video><video id="localVideo" class="local-video" autoplay muted playsinline></video></div>
 <div class="call-bottom"><button id="muteCall">🎙️</button><button id="cameraCall">📷</button><button id="speakerCall">🔊</button><button class="end" id="endCall">☎</button></div>
</div>

<div class="loader" id="loader"><div class="loader-inner"><div class="spinner"></div>Loading SPIKE…</div></div>
<div class="toast" id="toast"></div>

<script type="module">
import {createClient} from "https://esm.sh/@supabase/supabase-js@2.57.0";

const SUPABASE_URL="https://bkrrewagsbjqgmxaaqyt.supabase.co";
const SUPABASE_KEY="sb_publishable_24Z2PQpdG13cf6_9w8C7nA_zXEzr60O";
const supabase=createClient(SUPABASE_URL,SUPABASE_KEY,{auth:{persistSession:true,autoRefreshToken:true,detectSessionInUrl:true}});
window.__SPIKE_SUPABASE__=supabase;
window.addEventListener("error",e=>{
  if(e?.error) console.error("SPIKE runtime error",e.error);
  else console.error("SPIKE runtime error",e.message);
});
window.addEventListener("unhandledrejection",e=>{
  console.error("SPIKE unhandled rejection",e.reason);
});

/* Authoritative Supabase auth guard.
   Protected pages must have a valid authenticated Supabase user. */
(function () {
  async function protectPage() {
    try {
      if (typeof supabase === 'undefined') {
        location.replace('index.html');
        return;
      }

      const result = await supabase.auth.getUser();
      if (!result || !result.data || !result.data.user) {
        location.replace('index.html');
        return;
      }

      window.SPIKE_AUTH_USER = result.data.user;

      supabase.auth.onAuthStateChange(function (event, session) {
        if (event === 'SIGNED_OUT' || !session) {
          location.replace('index.html');
        }
      });
    } catch (error) {
      console.warn('SPIKE auth guard:', error);
      location.replace('index.html');
    }
  }

  // Run after the Supabase client script has been created.
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', protectPage, { once: true });
  } else {
    protectPage();
  }
})();


// ─── SPIKE shared user settings ─────────────────────────────────────
window.SPIKE_SETTINGS = window.SPIKE_SETTINGS || { theme:"dark" };
window.SPIKE_PRIVACY = window.SPIKE_PRIVACY || {};

window.spikeApplyTheme = function(theme){
  const t = theme === "light" ? "light" :
            theme === "system" ? (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark") :
            "dark";
  document.documentElement.dataset.theme = t;
  document.body.classList.toggle("light", t === "light");
  document.documentElement.style.colorScheme = t;
  localStorage.setItem("spike-theme", t);
};

window.spikeLoadSettings = async function(){
  try{
    const {data:{user}} = await supabase.auth.getUser();
    if(!user) return null;
    const [{data:settings},{data:privacy}] = await Promise.all([
      supabase.from("user_settings").select("*").eq("user_id",user.id).maybeSingle(),
      supabase.from("user_privacy_settings").select("*").eq("user_id",user.id).maybeSingle()
    ]);
    window.SPIKE_SETTINGS = {...(settings||{}), theme:settings?.theme||"dark"};
    window.SPIKE_PRIVACY = privacy||{};
    window.spikeApplyTheme(window.SPIKE_SETTINGS.theme);
    window.dispatchEvent(new CustomEvent("spike-settings-changed",{detail:{settings:window.SPIKE_SETTINGS,privacy:window.SPIKE_PRIVACY}}));
    return {user,settings:window.SPIKE_SETTINGS,privacy:window.SPIKE_PRIVACY};
  }catch(e){
    console.warn("SPIKE settings load:",e);
    window.spikeApplyTheme(localStorage.getItem("spike-theme")==="light" ? "light" : "dark");
    return null;
  }
};

window.spikeSetTheme = async function(theme){
  window.SPIKE_SETTINGS = {...window.SPIKE_SETTINGS,theme};
  window.spikeApplyTheme(theme);
  try{
    const {data:{user}} = await supabase.auth.getUser();
    if(user){
      const {error}=await supabase.from("user_settings").upsert(
        {user_id:user.id,theme,updated_at:new Date().toISOString()},
        {onConflict:"user_id"}
      );
      if(error) throw error;
    }
  }catch(e){ console.warn("Could not save theme:",e); }
};

window.spikeListenSettings = async function(){
  try{
    const {data:{user}} = await supabase.auth.getUser();
    if(!user) return;
    const channel=supabase.channel("spike-settings-"+user.id)
      .on("postgres_changes",{event:"UPDATE",schema:"public",table:"user_settings",filter:"user_id=eq."+user.id},
        payload=>{
          window.SPIKE_SETTINGS={...window.SPIKE_SETTINGS,...(payload.new||{})};
          window.spikeApplyTheme(window.SPIKE_SETTINGS.theme||"dark");
          window.dispatchEvent(new CustomEvent("spike-settings-changed",{detail:{settings:window.SPIKE_SETTINGS,privacy:window.SPIKE_PRIVACY}}));
        })
      .on("postgres_changes",{event:"UPDATE",schema:"public",table:"user_privacy_settings",filter:"user_id=eq."+user.id},
        payload=>{
          window.SPIKE_PRIVACY={...window.SPIKE_PRIVACY,...(payload.new||{})};
          window.dispatchEvent(new CustomEvent("spike-settings-changed",{detail:{settings:window.SPIKE_SETTINGS,privacy:window.SPIKE_PRIVACY}}));
        })
      .subscribe();
    window.__spikeSettingsChannel=channel;
    addEventListener("visibilitychange",()=>{if(!document.hidden)window.spikeLoadSettings();});
    addEventListener("focus",()=>window.spikeLoadSettings());
  }catch(e){ console.warn("SPIKE settings realtime:",e); }
};


const CLOUDINARY={cloudName:"dxld01rcp",uploadPreset:"Storage_preset"};
const $=id=>document.getElementById(id);
let user=null, profile={}, users=new Map(), posts=[], saved=new Set(), following=new Set(), muted=new Set(), filter="latest";
let media=null, mediaKind=null, activePostId=null, activeReportPost=null, editPostId=null;
let storyFile=null, storyAudioFile=null, storyItems=[], blocked=new Set(), presenceChannel=null, notificationChannel=null, call={id:null,pc:null,stream:null,remote:null,muted:false,camera:true};
let toastTimer=null, realtimeChannel=null;

const now=()=>new Date().toISOString();
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const uid=()=>user?.id;
function toast(msg){$("toast").textContent=msg;$("toast").classList.add("show");clearTimeout(toastTimer);toastTimer=setTimeout(()=>$("toast").classList.remove("show"),2400)}
function pathDoc(path){return supabase.from("app_documents").select("*").eq("path",path).maybeSingle()}
async function getDoc(path){const r=await pathDoc(path);if(r.error)throw r.error;return r.data?.data||null}
async function putDoc(path,data,parent=""){const old=await pathDoc(path);const row={path,parent_path:parent,collection_name:path.split("/").slice(0,-1).join("/")||path.split("/")[0],document_id:path.split("/").pop(),owner_id:uid()||null,data,updated_at:now(),created_at:old.data?.created_at||now()};const {error}=await supabase.from("app_documents").upsert(row,{onConflict:"path"});if(error)throw error;return data}
async function deleteDoc(path){const {error}=await supabase.from("app_documents").delete().eq("path",path);if(error)throw error}
async function listCollection(collection,parent=""){const {data,error}=await supabase.from("app_documents").select("*").eq("collection_name",collection).eq("parent_path",parent);if(error)throw error;return data||[]}

function profileName(u){return u?.display_name||u?.name||u?.email||"User"}
function profileAvatar(u){return u?.avatar_url||u?.avatar||""}
function normalizeUser(row){const d=row?.data||row||{};return {...d,id:row?.document_id||d.id,avatar:profileAvatar(d),name:profileName(d)}}

async function loadUser(){
  const {data:{session},error}=await supabase.auth.getSession();
  if(error){console.warn("Session check failed:",error);location.href="index.html";return false}
  if(!session?.user){location.href="index.html";return false}
  user=session.user;
  const {data:p,error:pe}=await supabase.from("profiles").select("*").eq("id",user.id).maybeSingle();
  if(pe)console.warn("Profile load failed:",pe);
  const ext=await getDoc(`users/${user.id}`).catch(()=>null);
  profile={...(p||{}),...(ext||{})};
  if(profile.avatar)profile.avatar_url=profile.avatar;
  $("headerAvatar").innerHTML=profileAvatar(profile)?`<img src="${esc(profileAvatar(profile))}">`:esc(profileName(profile).charAt(0).toUpperCase());
  return true;
}

async function loadAux(){
 const docs=await listCollection("users","").catch(()=>[]);
 docs.forEach(r=>users.set(r.document_id,normalizeUser(r)));
 users.set(uid(),normalizeUser({...profile,id:uid()}));
 const d=await getDoc(`users/${uid()}`).catch(()=>({}));
 saved=new Set(d?.savedPosts||d?.saved||[]);
 following=new Set(d?.following||[]);
 muted=new Set(d?.mutedAuthors||[]);
 const {data:blocks,error:blocksError}=await supabase.from("feed_blocks").select("blocked_id").eq("blocker_id",uid()); if(blocksError) console.warn(blocksError);
 blocked=new Set((blocks||[]).map(x=>x.blocked_id));
}

function readLocal(key,f){try{return JSON.parse(localStorage.getItem(key))??f}catch{return f}}
function writeLocal(key,v){try{localStorage.setItem(key,JSON.stringify(v))}catch{}}

async function loadPosts(){
 const rows=await listCollection("posts",""); 
 posts=rows.map(r=>({id:r.document_id,...(r.data||{}),_raw:r})).filter(p=>p&&p.id&&!p.deleted);
 posts.sort((a,b)=>new Date(b.createdAt||b.created_at||0)-new Date(a.createdAt||a.created_at||0));
 await hydrateAuthors(posts);
 render();
}
async function hydrateAuthors(arr){
 const ids=[...new Set(arr.map(p=>p.authorUid||p.author_id).filter(Boolean))].filter(id=>!users.has(id));
 if(!ids.length)return;
 const rows=await listCollection("users","");
 rows.forEach(r=>{if(ids.includes(r.document_id))users.set(r.document_id,normalizeUser(r))});
}

function applyFilter(list){
 let x=list.filter(p=>!muted.has(p.authorUid||p.author_id)&&!blocked.has(p.authorUid||p.author_id));
 if(filter==="following")x=x.filter(p=>following.has(p.authorUid||p.author_id)||p.authorUid===uid());
 if(filter==="saved")x=x.filter(p=>saved.has(p.id));
 if(filter==="popular")x=[...x].sort((a,b)=>score(b)-score(a));
 if(filter==="latest"||filter==="following"){x=[...x].sort((a,b)=>smartScore(b)-smartScore(a));}
 const pinned=x.filter(p=>p.pinned),rest=x.filter(p=>!p.pinned);
 return [...pinned,...rest];
}
function smartScore(p){
 const age=Math.max(0,(Date.now()-new Date(p.createdAt||p.created_at||Date.now()))/3600000);
 const author=p.authorUid||p.author_id;
 return (following.has(author)?18:0)+(author===uid()?8:0)+(score(p)*0.35)+Math.max(0,24-age)*1.4;
}
function score(p){return (Array.isArray(p.likes)?p.likes.length:0)*3+(Array.isArray(p.comments)?p.comments.length:0)*4+reactionCount(p)*2+Number(p.views||0)*.2}
function reactionCount(p){const r=p.reactions||{};return Object.entries(r).reduce((n,[k,v])=>k.endsWith("_users")?n:n+Number(v||0),0)}
function ago(v){const d=new Date(v);if(!v||isNaN(d))return"Just now";let s=(Date.now()-d)/1000;if(s<60)return`${Math.floor(s)}s`;if(s<3600)return`${Math.floor(s/60)}m`;if(s<86400)return`${Math.floor(s/3600)}h`;if(s<604800)return`${Math.floor(s/86400)}d`;return d.toLocaleDateString(undefined,{month:"short",day:"numeric"})}

function parseContent(text){
 let x=esc(text);x=x.replace(/(^|\s)(#[a-z0-9_]+)/gi,'$1<span class="hashtag">$2</span>');x=x.replace(/(^|\s)(@[a-z0-9_]+)/gi,'$1<span class="mention">$2</span>');return x;
}
function postHTML(p){
 const author=users.get(p.authorUid)||{name:p.authorName||"User",avatar:p.authorAvatar||""};
 const likes=Array.isArray(p.likes)?p.likes:[], comments=Array.isArray(p.comments)?p.comments:[], reactions=p.reactions||{};
 const liked=likes.includes(uid()), isOwner=p.authorUid===uid(), isSaved=saved.has(p.id);
 const mediaHTML=p.mediaUrl?(p.mediaType==="video"?`
<div class="post-media spike-player paused" data-spike-player>
  <video src="${esc(p.mediaUrl)}" playsinline preload="metadata" data-spike-video></video>
  <span class="spike-brand" aria-label="SPIKE">SPIKE</span>
  <span class="spike-soundhint" data-spike-hint>Tap to play</span>
  <div class="spike-center"><button class="spike-play" type="button" data-spike-action="play">▶</button></div>
  <div class="spike-gradient"></div>
  <div class="spike-controls">
    <button type="button" title="Play/Pause" data-spike-action="play">▶</button>
    <button type="button" title="Mute" data-spike-action="mute">🔊</button>
    <input class="spike-volume" type="range" min="0" max="1" step=".05" value="1" aria-label="Volume" data-spike-volume>
    <span class="spike-time" data-spike-time>0:00 / 0:00</span>
    <input class="spike-progress" type="range" min="0" max="1000" value="0" aria-label="Video progress" data-spike-progress>
    <select class="spike-speed" title="Playback speed" data-spike-speed>
      <option value="0.75">0.75×</option><option value="1" selected>1×</option><option value="1.25">1.25×</option><option value="1.5">1.5×</option><option value="2">2×</option>
    </select>
    <select class="spike-size" title="Preview size" data-spike-size>
      <option value="standard" selected>Standard</option><option value="compact">Compact</option><option value="wide">Wide</option><option value="cinema">Cinema</option>
    </select>
    <button type="button" title="Theater mode" data-spike-action="theater">▣</button>
    <button type="button" title="Fullscreen" data-spike-action="fullscreen">⛶</button>
  </div>
</div>`:`<div class="post-media"><img src="${esc(p.mediaUrl)}" loading="lazy"></div>`):"";
 const reactionBtns=["❤️","😂","😮","😢","😡"].map(e=>`<button class="reaction" data-reaction="${e}" data-post="${p.id}">${e} ${Number(reactions[e]||0)}</button>`).join("");
 const commentsHTML=comments.map((c,i)=>`<div class="comment"><div class="comment-head"><b>${esc(c.authorName||"User")}</b><span>${ago(c.createdAt)}</span></div><div class="comment-text">${esc(c.text)}</div>${(c.replies||[]).map(r=>`<div class="reply"><b>${esc(r.authorName||"User")}</b> ${esc(r.text)}</div>`).join("")}<button class="tool reply-btn" data-post="${p.id}" data-comment="${c.id||i}">Reply</button></div>`).join("");
 const repost=p.repostOf?`<div class="repost"><small>🔁 Reposted</small><div>${parseContent(p.repostText||"")}</div></div>`:"";
 return `<article class="card post ${p.pinned?"pinned":""}" data-post="${p.id}">
  <div class="post-head"><div class="author"><button class="avatar profile-link" data-uid="${esc(p.authorUid||"")}">${author.avatar?`<img src="${esc(author.avatar)}">`:esc((author.name||"U").charAt(0).toUpperCase())}</button><div class="author-info"><div class="author-name">${esc(author.name)}</div><div class="meta">${ago(p.createdAt||p.created_at)}${p.locationLabel?` · 📍 ${esc(p.locationLabel)}`:""}${p.pinned?" · 📌 Pinned":""}</div></div></div><button class="post-menu" data-menu="${p.id}">⋯</button></div>
  <div class="post-content">${parseContent(p.content||"")}</div>${repost}${mediaHTML}
  <div class="actions"><button class="action ${liked?"active":""}" data-like="${p.id}">❤️ <span>${likes.length}</span></button><button class="action" data-comments="${p.id}">💬 <span>${comments.length}</span></button><button class="action" data-reactions="${p.id}">✨ ${reactionCount(p)}</button><button class="action save ${isSaved?"active":""}" data-save="${p.id}">🔖</button><button class="action" data-share="${p.id}">🔗</button></div>
  <div class="panel" id="panel-${p.id}"><div class="reaction-row">${reactionBtns}</div><div class="actions"><button class="action" data-repost="${p.id}">🔁 Repost</button><button class="action" data-report="${p.id}">🚩 Report</button>${isOwner?`<button class="action" data-edit="${p.id}">✏️ Edit</button><button class="action danger" data-delete="${p.id}">🗑️ Delete</button>`:`<button class="action" data-mute="${esc(p.authorUid||"")}">🚫 Not interested</button>${p.authorUid?`<button class="action danger" data-block="${esc(p.authorUid)}">⛔ Block user</button>`:""}`}</div></div>
  <div class="comments ${comments.length?"":"hidden"}" id="comments-${p.id}">${commentsHTML||`<div class="empty">No comments yet.</div>`}<div class="comment-input"><textarea id="commentInput-${p.id}" placeholder="Write a comment…"></textarea><button data-comment-submit="${p.id}">Post</button></div></div>
 </article>`;
}

async function trackPostView(id){if(!id)return; try{await supabase.from("post_views").upsert({post_id:id,user_id:uid(),viewed_at:now()},{onConflict:"post_id,user_id"});}catch(e){console.warn(e)}}

function render(){
 const arr=applyFilter(posts);$("posts").innerHTML=arr.length?arr.map(postHTML).join(""):`<div class="card empty">No posts yet. Be the first to post!</div>`;
 attachPostEvents();
}
function attachPostEvents(){
 document.querySelectorAll("[data-like]").forEach(b=>b.onclick=()=>toggleLike(b.dataset.like));
 document.querySelectorAll("[data-comments]").forEach(b=>b.onclick=()=>{$(`comments-${b.dataset.comments}`).classList.toggle("hidden")});
 document.querySelectorAll("[data-reactions]").forEach(b=>b.onclick=()=>{$(`panel-${b.dataset.reactions}`).classList.toggle("show")});
 document.querySelectorAll("[data-save]").forEach(b=>b.onclick=()=>toggleSave(b.dataset.save));
 document.querySelectorAll("[data-share]").forEach(b=>b.onclick=()=>openShare(b.dataset.share));
 document.querySelectorAll("[data-repost]").forEach(b=>b.onclick=()=>openRepost(b.dataset.repost));
 document.querySelectorAll("[data-report]").forEach(b=>b.onclick=()=>openReport(b.dataset.report));
 document.querySelectorAll("[data-edit]").forEach(b=>b.onclick=()=>openEditPost(b.dataset.edit));
 document.querySelectorAll("[data-delete]").forEach(b=>b.onclick=()=>deletePost(b.dataset.delete));
 document.querySelectorAll("[data-mute]").forEach(b=>b.onclick=()=>muteAuthor(b.dataset.mute));
 document.querySelectorAll("[data-block]").forEach(b=>b.onclick=()=>blockUser(b.dataset.block));
 document.querySelectorAll("[data-comment-submit]").forEach(b=>b.onclick=()=>submitComment(b.dataset.commentSubmit));
 document.querySelectorAll("[data-reaction]").forEach(b=>b.onclick=()=>react(b.dataset.post,b.dataset.reaction));
 document.querySelectorAll("[data-menu]").forEach(b=>b.onclick=()=>{$(`panel-${b.dataset.menu}`).classList.toggle("show")});
 document.querySelectorAll(".post").forEach(a=>{if(a.dataset.post)trackPostView(a.dataset.post)});
 document.querySelectorAll(".profile-link").forEach(b=>b.onclick=()=>location.href=`profile.html?uid=${encodeURIComponent(b.dataset.uid)}`);
 document.querySelectorAll(".reply-btn").forEach(b=>b.onclick=()=>{$(`commentInput-${b.dataset.post}`).focus();$(`commentInput-${b.dataset.post}`).value=`@${b.parentElement.querySelector("b")?.textContent||""} `});
}

async function writePost(p){
 await putDoc(`posts/${p.id}`,p,"");
}
async function createPost(){
 const content=$("postText").value.trim();if(!content&&!media){toast("Write something or add media.");return}
 const scheduled=$("scheduleRow").classList.contains("show")&&$("scheduleTime").value;
 const p={content,authorUid:uid(),authorName:profileName(profile),authorAvatar:profileAvatar(profile),createdAt:now(),likes:[],comments:[],reactions:{},views:0,hidden:false,pinned:false,mediaUrl:media?.url||"",mediaType:media?.kind||"",locationLabel:"",scheduledAt:scheduled?new Date(scheduled).toISOString():null,linkUrl:window.__pendingLink||"",repostOf:null,repostText:""};
 const id=crypto.randomUUID();p.id=id;
 await writePost(p);
 $("postText").value="";clearMedia();$("scheduleRow").classList.remove("show");window.__pendingLink="";
 if(scheduled){toast("Post scheduled.");return}
 posts.unshift(p);render();toast("Posted!");
}
async function upload(file,kind){
 if(!file)return;toast("Uploading…");
 const form=new FormData();form.append("file",file);form.append("upload_preset",CLOUDINARY.uploadPreset);
 const res=await fetch(`https://api.cloudinary.com/v1_1/${CLOUDINARY.cloudName}/${kind==="video"?"video":"image"}/upload`,{method:"POST",body:form});
 if(!res.ok)throw new Error("Upload failed");const d=await res.json();media={url:d.secure_url,kind};mediaKind=kind;showMedia();toast("Media ready");
}
function showMedia(){$("mediaPreview").classList.add("show");$("imagePreview").classList.toggle("hidden",mediaKind==="video");$("videoPreview").classList.toggle("hidden",mediaKind!=="video");if(mediaKind==="video")$("videoPreview").src=media.url;else $("imagePreview").src=media.url}
function clearMedia(){media=null;mediaKind=null;$("mediaPreview").classList.remove("show");$("imagePreview").src="";$("videoPreview").src=""}

async function toggleLike(id){const p=posts.find(x=>x.id===id);if(!p)return;let likes=Array.isArray(p.likes)?[...p.likes]:[];const wasLiked=likes.includes(uid());likes=wasLiked?likes.filter(x=>x!==uid()):[...likes,uid()];p.likes=likes;await writePost(p);if(!wasLiked)await createNotification(p.authorUid,"like",{postId:id,message:`${profileName(profile)} liked your post`});render()}
async function react(id,e){const p=posts.find(x=>x.id===id);if(!p)return;p.reactions=p.reactions||{};p.reactions[e]=Number(p.reactions[e]||0)+1;await writePost(p);render()}
async function toggleSave(id){if(saved.has(id))saved.delete(id);else saved.add(id);const d=await getDoc(`users/${uid()}`)||{};d.savedPosts=[...saved];await putDoc(`users/${uid()}`,{...d,savedPosts:d.savedPosts},"");render()}
async function submitComment(id){const input=$(`commentInput-${id}`),text=input.value.trim();if(!text)return;const p=posts.find(x=>x.id===id);p.comments=[...(p.comments||[]),{id:crypto.randomUUID(),authorUid:uid(),authorName:profileName(profile),text,createdAt:now(),replies:[]}];await writePost(p);if(p.authorUid!==uid())await createNotification(p.authorUid,"comment",{postId:id,message:`${profileName(profile)} commented on your post`});input.value="";render()}
async function muteAuthor(id){if(!id)return;muted.add(id);const d=await getDoc(`users/${uid()}`)||{};d.mutedAuthors=[...muted];await putDoc(`users/${uid()}`,{...d,mutedAuthors:d.mutedAuthors},"");render();toast("Posts from this author hidden")}
async function blockUser(id){if(!id||id===uid())return;await supabase.from("feed_blocks").upsert({blocker_id:uid(),blocked_id:id},{onConflict:"blocker_id,blocked_id"});blocked.add(id);following.delete(id);muted.add(id);render();toast("User blocked")}
async function deletePost(id){const p=posts.find(x=>x.id===id);if(!p||p.authorUid!==uid())return;await putDoc(`posts/${id}`,{...p,deleted:true},"");posts=posts.filter(x=>x.id!==id);render();toast("Post deleted")}
async function openEditPost(id){const p=posts.find(x=>x.id===id);if(!p)return;editPostId=id;$("editPostText").value=p.content||"";$("editPostOverlay").classList.add("open")}
async function saveEditPost(){const p=posts.find(x=>x.id===editPostId);if(!p)return;p.content=$("editPostText").value.trim();p.updatedAt=now();await writePost(p);$("editPostOverlay").classList.remove("open");render();toast("Post updated")}
function openShare(id){activePostId=id;$("shareText").textContent=`${location.origin}/feed.html?post=${id}`;$("shareOverlay").classList.add("open")}
async function shareActive(){const url=`${location.origin}/feed.html?post=${activePostId}`;if(navigator.share)await navigator.share({title:"SPIKE post",url});else{await navigator.clipboard?.writeText(url);toast("Link copied")}}
function openRepost(id){activePostId=id;$("repostText").value="";$("repostOverlay").classList.add("open")}
async function confirmRepost(){const p=posts.find(x=>x.id===activePostId);if(!p)return;const r={id:crypto.randomUUID(),content:$("repostText").value.trim(),authorUid:uid(),authorName:profileName(profile),authorAvatar:profileAvatar(profile),createdAt:now(),likes:[],comments:[],reactions:{},views:0,repostOf:p.id,repostText:p.content};await writePost(r);posts.unshift(r);$("repostOverlay").classList.remove("open");render();toast("Reposted")}
function openReport(id){activeReportPost=id;$("reportOverlay").classList.add("open")}
async function confirmReport(){await putDoc(`reports/${crypto.randomUUID()}`,{postId:activeReportPost,reporterUid:uid(),reason:$("reportReason").value,createdAt:now()},"reports");$("reportOverlay").classList.remove("open");toast("Report submitted")}
async function publishStory(){const text=$("storyText").value.trim();let mediaUrl="",mediaType="",audioUrl="";if(storyFile){const d=await uploadReturn(storyFile,storyFile.type.startsWith("video")?"video":"image");mediaUrl=d.url;mediaType=d.kind}if(storyAudioFile){const d=await uploadReturn(storyAudioFile,"audio");audioUrl=d.url}if(!text&&!mediaUrl&&!audioUrl){toast("Add text, media, or an MP3.");return}await putDoc(`stories/${crypto.randomUUID()}`,{authorUid:uid(),authorName:profileName(profile),authorAvatar:profileAvatar(profile),text,mediaUrl,mediaType,audioUrl,createdAt:now(),expiresAt:new Date(Date.now()+86400000).toISOString(),views:[]}, "");$("storyOverlay").classList.remove("open");$("storyText").value="";storyFile=null;storyAudioFile=null;$("storyInput").value="";$("storyAudioInput").value="";await loadStories();toast("Story published")}
async function uploadReturn(file,kind){const form=new FormData();form.append("file",file);form.append("upload_preset",CLOUDINARY.uploadPreset);const resource=kind==="video"||kind==="audio"?"video":"image";const res=await fetch(`https://api.cloudinary.com/v1_1/${CLOUDINARY.cloudName}/${resource}/upload`,{method:"POST",body:form});if(!res.ok)throw new Error("Upload failed");const d=await res.json();return{url:d.secure_url,kind}}

async function loadStories(){
 const rows=await listCollection("stories","").catch(()=>[]);
 const active=rows.map(r=>({id:r.document_id,...r.data})).filter(s=>s.expiresAt&&new Date(s.expiresAt)>new Date());
 storyItems=active;$("storiesRow").classList.toggle("show",active.length>0);
 $("storiesRow").innerHTML=active.slice(0,20).map(s=>`<button class="story" data-story="${s.id}"><div class="story-avatar"><div>${s.authorAvatar?`<img src="${esc(s.authorAvatar)}">`:"⚡"}</div></div>${esc(s.authorName||"User")}</button>`).join("");
 document.querySelectorAll("[data-story]").forEach(b=>b.onclick=()=>viewStory(active.find(s=>s.id===b.dataset.story)));
}
async function viewStory(s){if(!s)return;try{await supabase.from("story_views").upsert({story_id:s.id,user_id:uid(),viewed_at:now()},{onConflict:"story_id,user_id"});}catch(e){console.warn(e)}const media=s.mediaUrl?(s.mediaType==="video"?`<div class="story-media"><video src="${esc(s.mediaUrl)}" controls autoplay playsinline></video></div>`:`<div class="story-media"><img src="${esc(s.mediaUrl)}" alt="Story"></div>`):"";const audio=s.audioUrl?`<div class="story-audio"><span>🎵</span><audio src="${esc(s.audioUrl)}" controls></audio></div>`:"";$("shareText").innerHTML=`${media}${audio}${s.text?`<div class="story-text">${parseContent(s.text)}</div>`:""}`;$("shareOverlay").classList.add("open")}

async function createNotification(to,type,data){if(!to||to===uid())return;const {error}=await supabase.from("notifications").insert({user_id:to,actor_id:uid(),type,data});if(error)console.warn("notification",error.message)}
async function loadBadges(){
 const {data:n,error:nError}=await supabase.from("notifications").select("id,read,created_at").eq("user_id",uid()).order("created_at",{ascending:false}).limit(100); if(nError) console.warn(nError);
 const unread=(n||[]).filter(x=>!x.read).length;$('notificationBadge').textContent=unread>99?"99+":unread;$('notificationBadge').classList.toggle("show",unread>0);
 const chats=await listCollection("chats","").catch(()=>[]);let count=0;chats.forEach(r=>{const u=r.data?.unreadCount||{};count+=Number(u[uid()]||0)});$('chatBadge').textContent=count>99?"99+":count;$('chatBadge').classList.toggle("show",count>0);
}

async function loadAnnouncement(){
 const d=await getDoc("settings/announcement").catch(()=>null);if(d?.active){$("announcementText").textContent=d.text||"";$("announcement").classList.add("show")}
 const m=await getDoc("settings/maintenance").catch(()=>null);if(m?.active){toast("Maintenance mode is active.")}
}

async function initRealtime(){
 if(realtimeChannel)await supabase.removeChannel(realtimeChannel).catch(()=>{});
 if(presenceChannel)await supabase.removeChannel(presenceChannel).catch(()=>{});
 if(notificationChannel)await supabase.removeChannel(notificationChannel).catch(()=>{});
 realtimeChannel=supabase.channel("feed:global",{config:{private:true}})
  .on("broadcast",{event:"INSERT"},payload=>{const row=payload.payload?.record||payload.payload?.new;if(row?.path?.startsWith("posts/"))loadPosts().catch(console.error);if(row?.path?.startsWith("stories/"))loadStories().catch(console.error)})
  .on("broadcast",{event:"UPDATE"},payload=>{const row=payload.payload?.record||payload.payload?.new;if(row?.path?.startsWith("posts/"))loadPosts().catch(console.error);if(row?.path?.startsWith("stories/"))loadStories().catch(console.error)})
  .on("broadcast",{event:"DELETE"},payload=>{const row=payload.payload?.record||payload.payload?.old;if(row?.path?.startsWith("posts/"))loadPosts().catch(console.error);if(row?.path?.startsWith("stories/"))loadStories().catch(console.error)})
  .subscribe(status=>{if(status==="SUBSCRIBED")$('onlineStatus').textContent="Live · real-time"});
 notificationChannel=supabase.channel(`user:${uid()}:notifications`,{config:{private:true}})
  .on("broadcast",{event:"notification"},()=>loadBadges().catch(console.error))
  .subscribe();
 presenceChannel=supabase.channel("feed:presence",{config:{private:true,presence:{key:uid()}}})
  .on("presence",{event:"sync"},()=>{const count=Object.keys(presenceChannel.presenceState()).length;$('onlineStatus').textContent=`${count} online · real-time`})
  .subscribe(async status=>{if(status==="SUBSCRIBED")await presenceChannel.track({userId:uid(),name:profileName(profile),online_at:now()})});
}

async function saveFollowing(){
 const d=await getDoc(`users/${uid()}`)||{};d.following=[...following];await putDoc(`users/${uid()}`,{...d,following:d.following},"");
}
async function follow(uid2){if(!uid2||uid2===uid())return;following.add(uid2);await saveFollowing();await createNotification(uid2,"follow",{message:`${profileName(profile)} followed you`});toast("Following")}
async function unfollow(uid2){following.delete(uid2);await saveFollowing();toast("Unfollowed")}

async function startCall(peerId,video=true){
 if(!peerId||peerId===uid()){toast("Invalid call recipient");return}
 const id=crypto.randomUUID();call.id=id;call.pc=new RTCPeerConnection({iceServers:[{urls:"stun:stun.l.google.com:19302"}]});
 call.stream=await navigator.mediaDevices.getUserMedia({audio:true,video});
 $("localVideo").srcObject=call.stream;$("callUI").classList.add("open");
 call.pc.ontrack=e=>$("remoteVideo").srcObject=e.streams[0];
 call.pc.onicecandidate=e=>{if(e.candidate)putDoc(`calls/${id}`,{...(window.__callData||{}),candidateOut:e.candidate.toJSON(),updatedAt:now()},"").catch(()=>{})};
 const offer=await call.pc.createOffer();await call.pc.setLocalDescription(offer);
 window.__callData={from:uid(),to:peerId,status:"ringing",type:video?"video":"audio",offer:offer.toJSON(),createdAt:now()};
 await putDoc(`calls/${id}`,window.__callData,"");
 toast("Calling…");
}
async function endCall(){if(call.stream)call.stream.getTracks().forEach(t=>t.stop());if(call.pc)call.pc.close();if(call.id){const d=await getDoc(`calls/${call.id}`).catch(()=>({}));await putDoc(`calls/${call.id}`,{...(d||{}),status:"ended",endedAt:now()},"").catch(()=>{})}call={id:null,pc:null,stream:null,remote:null,muted:false,camera:true};$("callUI").classList.remove("open")}


