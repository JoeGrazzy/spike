/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(self), microphone=(self), payment=(), usb=()
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://veagqanfilmbchlvlpcc.supabase.co wss://veagqanfilmbchlvlpcc.supabase.co https://api.cloudinary.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# HTML must never be cached aggressively — prevents stale offline / broken shells
/*.html
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Pragma: no-cache

/index.html
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Pragma: no-cache

/room.html
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache

# Long-lived immutable assets
/css/spike-menu-final-v10.css
  Cache-Control: public, max-age=31536000, immutable

/css/spike-room-page.css
  Cache-Control: public, max-age=31536000, immutable

/js/spike-room-page.js
  Cache-Control: public, max-age=31536000, immutable

/js/spike-room-chat-v2.js
  Cache-Control: public, max-age=31536000, immutable

/js/supabase.min.js
  Cache-Control: public, max-age=31536000, immutable
